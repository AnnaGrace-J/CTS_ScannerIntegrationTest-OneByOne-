@inject WorkspaceApiService Client

<PageHeader Section="@(Direction == "OUTWARD" ? "Outward Clearing" : "Inward Clearing")" Title="@(_data?.Title ?? $"{Direction} Clearing Workspace")" Subtitle="Monitor instruments across the complete clearing lifecycle." Badge="@(_data?.CutoffStatus ?? "Loading")">
    <button class="secondary-button" @onclick="LoadAsync">↻ Refresh</button>
</PageHeader>

@if (_data is null)
{
    <LoadingState Error="@_error" />
}
else
{
    <section class="metric-grid">
        @foreach (var metric in _data.Metrics)
        {
            <article class="metric-card @metric.Tone"><span>@metric.Label</span><strong>@metric.Value</strong><small>@metric.Hint</small></article>
        }
    </section>
    <section class="panel workflow-panel">
        <div class="panel-heading"><div><span class="eyebrow">LIVE WORKFLOW</span><h2>Clearing queues</h2><p>Active worksteps, service handoffs and exceptions.</p></div><StatusPill Status="@(_data.ExceptionCount > 0 ? "Attention" : "Online")" /></div>
        <div class="workflow-grid">
            @foreach (var step in _data.Steps)
            {
                <a class="workflow-card @(step.IsException && step.Count > 0 ? "exception" : null)" href="@step.Route"><span class="queue-number">@step.Count</span><strong>@step.Label</strong><small>@step.Status · Open workstep</small><i>→</i></a>
            }
        </div>
    </section>
    <div class="content-rail-grid">
        <section class="panel">
            <div class="panel-heading"><div><span class="eyebrow">RECENT ACTIVITY</span><h2>Latest workitems</h2></div><a class="text-link" href="/search">View all</a></div>
            <ChequeTable Items="@_data.RecentItems" OnSelect="OpenSearch" />
        </section>
        <aside class="panel side-panel">
            <div class="panel-heading"><div><span class="eyebrow">QUEUE HEALTH</span><h2>Operational summary</h2></div></div>
            <dl class="summary-list"><div><dt>Pending items</dt><dd>@_data.TotalPending</dd></div><div><dt>Total amount</dt><dd>MMK @_data.TotalAmount.ToString("N0")</dd></div><div><dt>Exceptions</dt><dd class="danger-text">@_data.ExceptionCount</dd></div><div><dt>Completed</dt><dd>@_data.CompletedCount</dd></div></dl>
            <div class="timeline">
                @foreach (var item in _data.RecentActivity)
                { <div><i></i><span><strong>@item.Action.Replace('_', ' ')</strong><small>@item.Note</small><time>@item.OccurredAtUtc.ToLocalTime().ToString("HH:mm") · @item.Actor</time></span></div> }
            </div>
        </aside>
    </div>
}

@code {
    [Parameter, EditorRequired] public string Direction { get; set; } = "OUTWARD";
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    private DashboardResponseModel? _data;
    private string? _error;
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        _error = null;
        var result = await Client.DashboardAsync(new(Direction));
        if (result.IsSuccess) _data = result.Data; else _error = result.Message;
    }
    private Task OpenSearch(string id) { Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(id)}"); return Task.CompletedTask; }
}
