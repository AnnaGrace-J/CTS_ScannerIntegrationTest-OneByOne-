@code {
    private bool _showInfo;
    private bool _showSummary;
    private bool _autoRun;
    private bool _runningTick;
    private bool _auditOpen = true;

    private string _lastRunTime = "Not run this session";
    private string _serviceResult = "0 cheque(s) ready for forward upload file generation.";

    private List<DemoChequeModel> _readyCheques = [];
    private List<DemoIclFileModel> _generatedFiles = [];

    protected override void OnInitialized()
    {
        _readyCheques = [];

        _generatedFiles =
        [
            new()
            {
                FileName = "MMDB_OUT_20260818_004.icl",
                ChequeCount = 4,
                TotalAmount = 6985000m,
                CreatedAtString = "8/18/2026, 2:09:53 PM",
