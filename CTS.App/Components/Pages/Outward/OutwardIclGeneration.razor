                Status = "Uploaded"
            },
            new()
            {
                FileName = "MMDB_OUT_20260601_001.icl",
                ChequeCount = 0,
                TotalAmount = 0m,
                CreatedAtString = "2026-06-01 12:10",
                LocalPath = @"C:\CTS\Outward\Upload\",
                Status = "Generated"
            }
        ];
    }

    private decimal ReadyTotalAmount => _readyCheques.Sum(c => c.Amount);
    private DemoIclFileModel? LatestGeneratedFile => _generatedFiles.FirstOrDefault();

    private async Task RunTick()
    {
        _runningTick = true;
        await Task.Delay(350);
        _lastRunTime = DateTime.Now.ToString("M/d/yyyy, h:mm:ss tt");
        _serviceResult = "0 cheque(s) ready for forward upload file generation.";
        _runningTick = false;
    }

    private sealed class DemoChequeModel
    {
        public string ChequeNo { get; set; } = string.Empty;
        public string BatchNo { get; set; } = string.Empty;
        public decimal Amount { get; set; }
    }

    private sealed class DemoIclFileModel
    {
        public string FileName { get; set; } = string.Empty;
        public int ChequeCount { get; set; }
        public decimal TotalAmount { get; set; }
        public string CreatedAtString { get; set; } = string.Empty;
        public string LocalPath { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
    }
}
