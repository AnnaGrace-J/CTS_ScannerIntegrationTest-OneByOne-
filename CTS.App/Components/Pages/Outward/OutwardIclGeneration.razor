@page "/outward/icl-generation"
@attribute [Authorize]
@inject WorkspaceApiService Client
@inject NavigationManager Navigation

@*
// Origin Code:
// @page "/outward/icl-generation"
// @attribute [Authorize]
// <WorkflowWorkspace Workstep="ICL_FILE_GENERATION" />
*@

@* // New Code by KK *@
<PageTitle>ICL File Generation · ACE CTS</PageTitle>

<div class="demo-ops-root">
    @* Top Workspace Header *@
    <div class="demo-top-bar">
        <div class="demo-breadcrumbs">
            <span class="demo-bc-bold">ACE CTS Workspace</span>
            <span class="demo-meta-text">
                <span class="demo-icon">📅</span> Business date 2026-06-23
                <span class="demo-icon ml-2">🏛</span> Head Office
                <span class="demo-icon ml-2">Role:</span> ADMIN
            </span>
        </div>
        <div class="demo-top-badges">
            <span class="demo-audit-badge">Audit events: <strong>58</strong></span>
            <span class="demo-user-badge">admin1</span>
        </div>
    </div>

    @* Title Bar *@
    <div class="demo-title-bar">
        <div class="demo-title-cluster">
            <h1 class="demo-main-title">ICL File Generation</h1>
            <span class="demo-chip chip-online">Online</span>
            <span class="demo-chip chip-cyan">BRANCH <strong>Head Office</strong></span>
            <span class="demo-chip chip-blue">ROLE <strong>ADMIN</strong></span>
            <span class="demo-chip chip-blue">DATE <strong>2026-09-09</strong></span>
        </div>
        <button class="demo-ghost-btn" @onclick="() => _showInfo = !_showInfo">
            <span class="demo-icon">⚙</span> @(_showInfo ? "Hide Info" : "Show Info")
        </button>
    </div>

    @* Expandable Info Drawer *@
    @if (_showInfo)
    {
        <div class="demo-info-drawer">
            <div class="demo-info-item"><span>Service Status:</span> <strong>Active &amp; Polling</strong></div>
            <div class="demo-info-item"><span>File Standard:</span> <strong>ANSI X9.37 / Image Cash Letter</strong></div>
            <div class="demo-info-item"><span>Poll Interval:</span> <strong>10 seconds</strong></div>
            <div class="demo-info-item"><span>Forward Workstep:</span> <strong>ICL_FILE_GENERATION</strong></div>
        </div>
    }

    @* Service Operations Control Strip *@
    <div class="demo-card demo-service-strip">
        <div class="demo-service-left">
            <div class="demo-clock-icon">🕒</div>
            <div>
                <strong class="demo-service-title">Service Operations Control</strong>
                <span class="demo-service-subtitle">Last run: @_lastRunTime</span>
            </div>
        </div>
        <div class="demo-service-right">
            <button class="demo-action-btn btn-navy" disabled="@_runningTick" @onclick="RunTick">
                <span>▶</span>
                <span>@(_runningTick ? "Running..." : "Run Service Tick")</span>
            </button>
            <label class="demo-service-toggle">
                <input type="checkbox" @bind="_autoRun" />
                <span>Auto-run @(_autoRun ? "On" : "Off")</span>
            </label>
            <span class="demo-pill pill-poll">Poll 10s</span>
            <span class="demo-pill pill-result">Last result: @_serviceResult</span>
            <span class="demo-pill pill-error">Last error: None</span>
        </div>
    </div>

    @* KPI Summary Strip *@
    <div class="demo-summary-row">
        <div class="demo-pills-wrap">
            <span class="demo-summary-pill pill-cyan">READY CHEQUES <strong>@_readyCheques.Count</strong></span>
            <span class="demo-summary-pill pill-blue">READY AMOUNT <strong>MMK @ReadyTotalAmount.ToString("N0")</strong></span>
            <span class="demo-summary-pill pill-green">GENERATED FILES <strong>@_generatedFiles.Count</strong></span>
            <span class="demo-summary-pill pill-purple">FILE PATH <strong>C:\CTS\Outward\Upload\</strong></span>
        </div>
        <button class="demo-ghost-btn" @onclick="() => _showSummary = !_showSummary">
            <span class="demo-icon">👁</span> @(_showSummary ? "Hide Summary" : "Show Summary")
        </button>
    </div>

    @* Expandable Summary Drawer *@
    @if (_showSummary)
    {
        <div class="demo-summary-drawer">
            <div class="demo-summary-metric">
                <span>Total Ready Cheques</span>
                <strong>@_readyCheques.Count cheques</strong>
            </div>
            <div class="demo-summary-metric">
                <span>Ready Amount</span>
                <strong class="text-emerald">MMK @ReadyTotalAmount.ToString("N0")</strong>
            </div>
            <div class="demo-summary-metric">
                <span>Generated Files in Cycle</span>
                <strong>@_generatedFiles.Count files</strong>
            </div>
            <div class="demo-summary-metric">
                <span>Clearing Target Path</span>
                <strong>C:\CTS\Outward\Upload\</strong>
            </div>
        </div>
    }

    @* Latest Generated File Box (MMDB_OUT_20260818_004.icl) *@
    @if (LatestGeneratedFile is not null)
    {
        <div class="demo-card demo-file-card">
            <div class="demo-file-header">
                <h3 class="demo-file-name">@LatestGeneratedFile.FileName</h3>
                <span class="demo-tag tag-uploaded">@LatestGeneratedFile.Status</span>
            </div>
            <div class="demo-file-grid">
                <div class="demo-file-stat-box">
                    <span class="demo-stat-label">CHEQUE COUNT</span>
                    <strong class="demo-stat-val">@LatestGeneratedFile.ChequeCount</strong>
                </div>
                <div class="demo-file-stat-box">
                    <span class="demo-stat-label">TOTAL AMOUNT</span>
                    <strong class="demo-stat-val">@LatestGeneratedFile.TotalAmount.ToString("N2")</strong>
                </div>
                <div class="demo-file-stat-box">
                    <span class="demo-stat-label">PATH</span>
                    <strong class="demo-stat-val demo-stat-path">@LatestGeneratedFile.LocalPath</strong>
                </div>
            </div>
        </div>
    }

    @* ICL Generation Queue Panel *@
    <div class="demo-card demo-table-panel">
        <div class="demo-panel-title">ICL Generation Queue</div>
        <div class="demo-table-wrapper">
            <table class="demo-data-table">
                <thead>
                    <tr>
                        <th style="width: 25%;">CHEQUE NO</th>
                        <th style="width: 25%;">BATCH</th>
                        <th style="width: 25%;">AMOUNT</th>
                        <th style="width: 25%;">WORKSTEP</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_readyCheques.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="demo-empty-container">
                                <div class="demo-empty-icon">📄</div>
                                <div class="demo-empty-title">No records found</div>
                                <div class="demo-empty-sub">Adjust filters or run the relevant demo service to create workitems.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var chq in _readyCheques)
                        {
                            <tr>
                                <td class="font-bold text-blue">@chq.ChequeNo</td>
                                <td class="font-mono">@chq.BatchNo</td>
                                <td>@chq.Amount.ToString("N2")</td>
                                <td>ICL Generation</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* Generated Forward Upload Files Panel *@
    <div class="demo-card demo-table-panel">
        <div class="demo-panel-title">Generated Forward Upload Files</div>
        <div class="demo-table-wrapper">
            <table class="demo-data-table">
                <thead>
                    <tr>
                        <th>ICL FILE NAME</th>
                        <th>CHEQUE COUNT</th>
                        <th>TOTAL AMOUNT</th>
                        <th>GENERATED DATE/TIME</th>
                        <th>LOCAL PATH</th>
                        <th>STATUS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var file in _generatedFiles)
                    {
                        <tr>
                            <td class="font-mono text-slate">@file.FileName</td>
                            <td>@file.ChequeCount</td>
                            <td>@file.TotalAmount.ToString("N0")</td>
                            <td>@file.CreatedAtString</td>
                            <td class="font-mono text-muted">@file.LocalPath</td>
                            <td>
                                <span class="demo-tag @(file.Status == "Uploaded" ? "tag-uploaded" : "tag-generated")">
                                    @file.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* Audit Timeline Panel *@
    <div class="demo-card demo-pane">
        <div class="demo-pane-header">
            <div>
                <h3 class="demo-pane-title">Audit Timeline</h3>
                <span class="demo-pane-sub">8 audit event(s)</span>
            </div>
            <button class="demo-link-btn" @onclick="() => _auditOpen = !_auditOpen">
                @(_auditOpen ? "⌃ Close Audit" : "⌄ Open Audit")
            </button>
        </div>

        @if (_auditOpen)
        {
            <div class="demo-audit-events-list">
                <div class="demo-audit-item">
                    <span class="demo-audit-time">9/9/2026, 3:42:20 PM · CTS Background Service</span>
                    <strong class="demo-audit-act">Run Service Tick</strong>
                    <p class="demo-audit-desc">No eligible outward service workitems found.</p>
                </div>
                <div class="demo-audit-item">
                    <span class="demo-audit-time">8/19/2026, 3:52:15 PM · CTS Background Service</span>
                    <strong class="demo-audit-act">Return ICL Upload File Generated</strong>
                    <p class="demo-audit-desc">MMDB_RETURN_20260819_006.icl created for CBM.</p>
                </div>
                <div class="demo-audit-item">
                    <span class="demo-audit-time">8/19/2026, 3:51:27 PM · Admin One</span>
                    <strong class="demo-audit-act">Complete Inward NAK Repair</strong>
                    <p class="demo-audit-desc">120103 returned to return ICL creation.</p>
                </div>
                <div class="demo-audit-item">
                    <span class="demo-audit-time">8/19/2026, 3:51:08 PM · Admin One</span>
                    <strong class="demo-audit-act">Complete Inward NAK Repair</strong>
                    <p class="demo-audit-desc">120099 returned to return ICL creation.</p>
                </div>
                <div class="demo-audit-item">
                    <span class="demo-audit-time">8/19/2026, 3:01:55 PM · CTS Background Service</span>
                    <strong class="demo-audit-act">Return ICL Upload File Generated</strong>
                    <p class="demo-audit-desc">MMDB_RETURN_20260819_005.icl created for CBM.</p>
                </div>
                <div class="demo-audit-item">
                    <span class="demo-audit-time">8/19/2026, 3:01:04 PM · CTS Background Service</span>
                    <strong class="demo-audit-act">Return ICL Creation</strong>
                    <p class="demo-audit-desc">No inward return instruments ready for file creation.</p>
                </div>
                <div class="demo-audit-item">
                    <span class="demo-audit-time">8/19/2026, 3:00:57 PM · CTS Background Service</span>
