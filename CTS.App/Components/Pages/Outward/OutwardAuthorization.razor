                    DrawerName = "Demo Trading Co.",
                    Uic = "20260811-MMDB-000-FB30U-1107-000002",
                    Discarded = false
                },
                new() {
                    ChequeId = "CHQ-930103",
                    ChequeNo = "930103",
                    RoutingNo = "200103",
                    AccountNo = "001000245117999",
                    Amount = 318000m,
                    DrawerName = "Demo Trading Co.",
                    Uic = "20260811-MMDB-000-FB30U-1107-000003",
                    Discarded = false
                }
            ]
        }
    ];

    private decimal TotalQueueAmount => _batchRows.Sum(b => b.BatchAmount);
    private int ExceptionBatchCount => _batchRows.Count(b => b.HasException);
    private string OldestBatchAge => _batchRows.FirstOrDefault()?.SlaAge ?? "None";

    private List<DemoBatchModel> FilteredBatchRows => _batchRows.Where(b =>
        (string.IsNullOrWhiteSpace(_filterBatchId) || b.BatchNo.Contains(_filterBatchId, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_filterBranchCode) || b.BranchCode.Contains(_filterBranchCode, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_filterChequeNo) || b.Cheques.Any(c => c.ChequeNo.Contains(_filterChequeNo))) &&
        (string.IsNullOrWhiteSpace(_filterMicrAccount) || b.Cheques.Any(c => c.AccountNo.Contains(_filterMicrAccount))) &&
        (string.IsNullOrWhiteSpace(_filterRoutingNo) || b.Cheques.Any(c => c.RoutingNo.Contains(_filterRoutingNo))) &&
        (string.IsNullOrWhiteSpace(_filterAmount) || b.BatchAmount.ToString().Contains(_filterAmount))
    ).ToList();

    private void ClearFilters()
    {
        _filterBatchId = string.Empty;
        _filterBranchCode = string.Empty;
        _filterChequeNo = string.Empty;
        _filterMicrAccount = string.Empty;
        _filterRoutingNo = string.Empty;
        _filterCreditAccount = string.Empty;
        _filterAmount = string.Empty;
        _filterEndorsement = string.Empty;
        _filterBatchType = string.Empty;
        _filterValueDate = null;
        _filterScanDate = null;
    }

    private void ToggleHeaderInfo() => _showHeaderInfo = !_showHeaderInfo;

    private void OpenBatchReview(DemoBatchModel batch)
    {
        _selectedBatch = batch;
        _activeCheque = batch.Cheques.FirstOrDefault();
        _reviewMode = true;
        _imageView = "front";
        _checkerRemarks = string.Empty;
    }

    private void SelectCheque(DemoChequeModel cheque)
    {
        _activeCheque = cheque;
    }

    private void ToggleDiscard(ChangeEventArgs e)
    {
        if (_activeCheque is not null)
        {
            _activeCheque.Discarded = (bool)(e.Value ?? false);
        }
    }

    private void PrevCheque()
    {
        if (_selectedBatch is null || _selectedBatch.Cheques.Count == 0) return;
        var idx = _selectedBatch.Cheques.FindIndex(c => c.ChequeId == _activeCheque?.ChequeId);
        if (idx > 0) _activeCheque = _selectedBatch.Cheques[idx - 1];
    }

    private void NextCheque()
    {
        if (_selectedBatch is null || _selectedBatch.Cheques.Count == 0) return;
        var idx = _selectedBatch.Cheques.FindIndex(c => c.ChequeId == _activeCheque?.ChequeId);
        if (idx >= 0 && idx < _selectedBatch.Cheques.Count - 1) _activeCheque = _selectedBatch.Cheques[idx + 1];
    }

    private void ExitReview()
    {
        _reviewMode = false;
        _selectedBatch = null;
        _activeCheque = null;
    }

    private void DoBatchAction(string action)
    {
        // Executes action and returns to queue
        ExitReview();
    }

    private int ActiveAcceptCount => _selectedBatch?.Cheques.Count(c => !c.Discarded) ?? 0;
    private int ActiveDiscardCount => _selectedBatch?.Cheques.Count(c => c.Discarded) ?? 0;
    private decimal ActiveAcceptedAmount => _selectedBatch?.Cheques.Where(c => !c.Discarded).Sum(c => c.Amount) ?? 0;

