@page "/outward/authorization"
@attribute [Authorize]
@inject WorkspaceApiService Client
@inject NavigationManager Navigation

@*
// Origin Code:
// @page "/outward/authorization"
// @attribute [Authorize]
// <WorkflowWorkspace Workstep="OUTWARD_AUTHORIZATION" />
*@

@* // New Code by KK *@
<PageTitle>Outward Authorization · ACE CTS</PageTitle>

<div class="demo-ops-root">
    @if (!_reviewMode)
    {
        @* ==========================================
           PHASE 1: SEARCH & BATCH QUEUE
           ========================================== *@
        
        @* Operations Header matching Demo Screenshot *@
        <div class="demo-card demo-header-card">
            <div class="demo-header-top">
                <div class="demo-breadcrumbs">
                    <span class="demo-bc-bold">ACE CTS Workspace</span>
                    <span class="demo-bc-slash">/</span>
                    <span class="demo-bc-dim">Outward Clearing</span>
                </div>
                <div class="demo-top-badges">
                    <span class="demo-audit-badge">Audit events: <strong>58</strong></span>
                    <span class="demo-user-badge">admin1</span>
                </div>
            </div>
            <div class="demo-header-bottom">
                <div class="demo-title-cluster">
                    <h1 class="demo-main-title">Outward Authorization</h1>
                    <span class="demo-chip chip-cyan">BRANCH <strong>Head Office</strong></span>
                    <span class="demo-chip chip-blue">ROLE <strong>ADMIN</strong></span>
                    <span class="demo-chip chip-blue">DATE <strong>@DateTime.Today.ToString("M/d/yyyy")</strong></span>
                </div>
                <button class="demo-ghost-btn" @onclick="ToggleHeaderInfo">
                    <span class="demo-icon">⚙</span> @(_showHeaderInfo ? "Hide Info" : "Show Info")
                </button>
            </div>

            @if (_showHeaderInfo)
            {
                <div class="demo-info-drawer">
                    <div class="demo-info-item"><span>Queue Type:</span> <strong>FIFO Batch Queue</strong></div>
                    <div class="demo-info-item"><span>SLA Window:</span> <strong>30 minutes</strong></div>
                    <div class="demo-info-item"><span>Policy:</span> <strong>Dual Control Maker/Checker Strict</strong></div>
                    <div class="demo-info-item"><span>Workstep:</span> <strong>OUTWARD_AUTHORIZATION</strong></div>
                </div>
            }

            <div class="demo-summary-row">
                <div class="demo-pills-wrap">
                    <span class="demo-summary-pill pill-cyan">PENDING BATCHES <strong>@_batchRows.Count</strong></span>
                    <span class="demo-summary-pill pill-green">TOTAL AMOUNT <strong>MMK @TotalQueueAmount.ToString("N0")</strong></span>
                    <span class="demo-summary-pill pill-green">EXCEPTIONS <strong>@ExceptionBatchCount</strong></span>
                    <span class="demo-summary-pill pill-orange">OLDEST BATCH AGE <strong>@OldestBatchAge</strong></span>
                </div>
                <button class="demo-ghost-btn" @onclick="() => _showSummary = !_showSummary">
                    <span class="demo-icon">👁</span> @(_showSummary ? "Hide Summary" : "Show Summary")
                </button>
            </div>

            @if (_showSummary)
            {
                <div class="demo-summary-drawer">
                    <div class="demo-summary-metric">
                        <span>Total Items</span>
                        <strong>@_batchRows.Sum(b => b.Cheques.Count) cheques</strong>
                    </div>
                    <div class="demo-summary-metric">
                        <span>Authorized Today</span>
                        <strong>18 batches</strong>
                    </div>
                    <div class="demo-summary-metric">
                        <span>Pending Review</span>
                        <strong>@_batchRows.Count batches</strong>
                    </div>
                    <div class="demo-summary-metric">
                        <span>Cutoff Countdown</span>
                        <strong class="text-emerald">01:45:12</strong>
                    </div>
                </div>
            }
        </div>

        @* Authorization Queue Filters Form Panel *@
        <div class="demo-card demo-filter-card">
            <div class="demo-filter-header">
                <div>
                    <h2 class="demo-section-title">Authorization Queue Filters</h2>
                    <span class="demo-match-count">@FilteredBatchRows.Count matching records</span>
                </div>
                <button class="demo-link-btn" @onclick="() => _filtersCollapsed = !_filtersCollapsed">
                    @(_filtersCollapsed ? "⌄ Show Filters" : "⌃ Hide Filters")
                </button>
            </div>

            @if (!_filtersCollapsed)
            {
                <div class="demo-filter-grid">
                    <div class="demo-field">
                        <label>BATCH ID</label>
                        <input placeholder="e.g. BATCH-001" @bind="_filterBatchId" @bind:event="oninput" />
                    </div>
                    <div class="demo-field">
                        <label>BRANCH CODE</label>
                        <input placeholder="e.g. 000 or HO" @bind="_filterBranchCode" @bind:event="oninput" />
                    </div>
                    <div class="demo-field">
                        <label>CHEQUE NO.</label>
                        <input placeholder="e.g. 930101" @bind="_filterChequeNo" @bind:event="oninput" />
                    </div>
                    <div class="demo-field">
                        <label>MICR ACCOUNT NO.</label>
                        <input placeholder="e.g. 0010002451" @bind="_filterMicrAccount" @bind:event="oninput" />
                    </div>
                    <div class="demo-field">
                        <label>ROUTING NO.</label>
                        <input placeholder="e.g. 200101" @bind="_filterRoutingNo" @bind:event="oninput" />
                    </div>
                    <div class="demo-field">
                        <label>CREDIT ACCOUNT NO.</label>
                        <input placeholder="Credit account" @bind="_filterCreditAccount" @bind:event="oninput" />
                    </div>
                    <div class="demo-field">
                        <label>AMOUNT</label>
                        <input placeholder="e.g. 688500" @bind="_filterAmount" @bind:event="oninput" />
                    </div>
                    <div class="demo-field">
                        <label>ENDORSEMENT NUMBER</label>
                        <input placeholder="Endorsement" @bind="_filterEndorsement" @bind:event="oninput" />
                    </div>
                    <div class="demo-field">
                        <label>BATCH TYPE</label>
                        <input placeholder="CDC / Normal" @bind="_filterBatchType" @bind:event="oninput" />
                    </div>
                    <div class="demo-field">
                        <label>VALUE DATE</label>
                        <input type="date" @bind="_filterValueDate" />
                    </div>
                    <div class="demo-field">
                        <label>SCAN DATE</label>
                        <input type="date" @bind="_filterScanDate" />
                    </div>
                    <div class="demo-field demo-filter-actions">
                        <button class="demo-subtle-btn" @onclick="ClearFilters">Clear Filters</button>
                    </div>
                </div>
            }
        </div>

        @* Authorization Batch Queue Table matching screenshot *@
        <div class="demo-card demo-table-card">
            <div class="demo-table-title-bar">
                <h3 class="demo-section-title">Authorization Batch Queue</h3>
                <span class="demo-table-hint">Click any batch row to review batch instruments</span>
            </div>
            <div class="demo-table-scroller">
                <table class="demo-data-table">
                    <thead>
                        <tr>
                            <th>BATCH ID</th>
                            <th>BRANCH</th>
                            <th>MAKER</th>
                            <th class="text-center">TOTAL CHEQUES</th>
                            <th class="text-right">BATCH AMOUNT</th>
                            <th class="text-right">CALCULATED AMOUNT</th>
                            <th>SCAN DATE/TIME</th>
                            <th>STATUS</th>
                            <th>SLA AGE</th>
                            <th>MAKER-CHECKER</th>
                            <th>EXCEPTION</th>
                            @*
                            // Original Code
                            <th class="text-center">ACTION</th>
                            *@
                            @* // Code Added by KK *@
                            <th class="demo-th-chevron" aria-label="Open workitem"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredBatchRows.Count == 0)
                        {
                            <tr>
                                <td colspan="12" class="demo-empty-cell">
                                    No batches matching filter in Outward Authorization queue.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in FilteredBatchRows)
                            {
                                <tr class="demo-clickable-row" @onclick="() => OpenBatchReview(row)">
                                    <td class="demo-batch-id-cell">@row.BatchNo</td>
                                    <td>@row.BranchCode</td>
                                    <td>@row.Maker</td>
                                    <td class="text-center">@row.Cheques.Count</td>
                                    <td class="text-right font-medium">@row.BatchAmount.ToString("N0")</td>
                                    <td class="text-right font-medium">@row.CalculatedAmount.ToString("N0")</td>
                                    <td class="demo-date-cell">@row.ScanDateTime.ToString("M/d/yyyy, h:mm:ss tt")</td>
                                    <td>
                                        <span class="demo-tag tag-pending">Pending Authorization</span>
                                    </td>
                                    <td>
                                        <span class="demo-sla-cell">⏱ @row.SlaAge</span>
                                    </td>
                                    <td>
                                        <span class="demo-tag tag-blocked">⚠ Blocked</span>
                                    </td>
                                    <td>
                                        <span class="demo-tag tag-clear">Clear</span>
                                    </td>
                                    @*
                                    // Original Code
                                    <td class="text-center">
                                        <button class="demo-review-btn" @onclick:stopPropagation="true" @onclick="() => OpenBatchReview(row)">
                                            Review →
                                        </button>
                                    </td>
                                    *@
                                    @* // Code Added by KK *@
                                    <td class="text-right demo-chevron-cell">
                                        <span class="demo-chevron-arrow">›</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        @* ==========================================
           PHASE 2: DETAILED BATCH REVIEW WORKSPACE
           (Exact match to 2nd screenshot)
           ========================================== *@
        
        @* Batch Review Workspace Header *@
        <div class="demo-card demo-header-card">
            <div class="demo-header-top">
                <div class="demo-breadcrumbs">
                    <span class="demo-bc-bold">ACE CTS Workspace</span>
                    <span class="demo-bc-slash">/</span>
                    <span class="demo-bc-link" @onclick="ExitReview">Outward</span>
                    <span class="demo-bc-slash">/</span>
                    <span class="demo-bc-dim">Authorization</span>
                </div>
                <div class="demo-top-badges">
                    <span class="demo-audit-badge">Audit events: <strong>58</strong></span>
                    <span class="demo-user-badge">admin1</span>
                </div>
            </div>
            <div class="demo-header-bottom">
                <div class="demo-title-cluster">
                    <h1 class="demo-main-title">Batch Review @_selectedBatch?.BatchNo</h1>
                    <span class="demo-chip chip-blocked">Blocked</span>
                    <span class="demo-chip chip-cyan">BRANCH <strong>Head Office</strong></span>
                    <span class="demo-chip chip-blue">ROLE <strong>ADMIN</strong></span>
                    <span class="demo-chip chip-blue">DATE <strong>@DateTime.Today.ToString("M/d/yyyy")</strong></span>
                </div>
                <div class="demo-header-actions">
                    <button class="demo-ghost-btn" @onclick="ToggleHeaderInfo">
                        <span class="demo-icon">⚙</span> Show Info
                    </button>
                    <button class="demo-ghost-btn" @onclick="ExitReview">
                        ✕ Exit to Queue
                    </button>
                </div>
            </div>
        </div>

        @* 3-Column Review Grid Layout *@
        <div class="demo-three-col-grid">
            @* Left Column: Authorization Image Review *@
            <section class="demo-col-left">
                <div class="demo-card demo-pane">
                    <div class="demo-pane-header">
                        <h2 class="demo-pane-title">Authorization Image Review</h2>
                        <span class="demo-pane-sub">Cheque @_activeCheque?.ChequeNo / @_activeCheque?.Uic</span>
                    </div>

                    <div class="demo-image-tags">
                        <span class="demo-badge-pill pill-blue-solid">@(_activeCheque?.Discarded == true ? "Discarded" : "Scanned")</span>
                        <span class="demo-badge-pill pill-uic">UIC @_activeCheque?.Uic</span>
                    </div>

                    <div class="demo-cheque-box">
                        <div class="demo-cheque-canvas">
                            @if (_imageView == "signature")
                            {
                                <div class="demo-sig-mock">
                                    <span class="demo-sig-label">CBS Verified Signature</span>
                                    <svg viewBox="0 0 300 80" class="demo-sig-svg">
                                        <path d="M 10 50 Q 50 10 90 45 T 160 30 T 230 55 T 280 20" fill="none" stroke="#172033" stroke-width="2.5" stroke-linecap="round" />
                                    </svg>
                                </div>
                            }
                            else
                            {
                                <div class="demo-cheque-sample">
                                    <div class="sample-bank-line">
                                        <strong>MM Demo Bank</strong>
                                        <span class="sample-date">Date: <strong>@DateTime.Today.ToString("dd / MM / yyyy")</strong></span>
                                    </div>
                                    <div class="sample-payee-line">
                                        <span>Pay to:</span> <strong>@(_activeCheque?.DrawerName ?? "Demo Payee 1")</strong>
                                    </div>
                                    <div class="sample-amount-box">
                                        MMK @_activeCheque?.Amount.ToString("N0")
                                    </div>
                                    <div class="sample-sig-line">
                                        <svg viewBox="0 0 200 45" class="sample-sig-svg">
                                            <path d="M 5 35 Q 35 5 70 30 T 130 15 T 180 35" fill="none" stroke="#0F2A44" stroke-width="2" />
                                        </svg>
                                    </div>
                                    <div class="sample-micr-line font-mono">
                                        ⑈@_activeCheque?.ChequeNo⑈ ⑉@_activeCheque?.RoutingNo⑉ @_activeCheque?.AccountNo ⑈20⑈
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="demo-image-tabs-bar">
                        <div class="demo-tab-group">
                            <button class="demo-tab-btn @(_imageView == "front" ? "active" : "")" @onclick='() => _imageView = "front"'>Front</button>
                            <button class="demo-tab-btn @(_imageView == "rear" ? "active" : "")" @onclick='() => _imageView = "rear"'>Rear</button>
                            <button class="demo-tab-btn @(_imageView == "signature" ? "active" : "")" @onclick='() => _imageView = "signature"'>Signature</button>
                        </div>
                        <span class="demo-iqa-tag">Image quality · <strong>Good</strong></span>
                    </div>
                </div>
            </section>

            @* Middle Column: Instrument List & Audit Timeline *@
            <section class="demo-col-mid">
                <div class="demo-card demo-pane">
                    <div class="demo-pane-header">
                        <h2 class="demo-pane-title">Instrument List</h2>
                        <span class="demo-pane-sub">@_selectedBatch?.Cheques.Count item(s)</span>
                    </div>
                    <div class="demo-table-scroller max-h-list">
                        <table class="demo-data-table mini-table">
                            <thead>
                                <tr>
                                    <th>CHEQUE NO</th>
                                    <th>ROUTING NO</th>
                                    <th>MICR ACCOUNT</th>
                                    <th class="text-right">AMOUNT</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_selectedBatch?.Cheques is not null)
                                {
                                    @foreach (var chq in _selectedBatch.Cheques)
                                    {
                                        var isCurrent = chq.ChequeId == _activeCheque?.ChequeId;
                                        <tr class="demo-clickable-row @(isCurrent ? "row-selected" : "")" @onclick="() => SelectCheque(chq)">
                                            <td class="font-bold text-blue">@chq.ChequeNo</td>
                                            <td>@chq.RoutingNo</td>
                                            <td class="font-mono">@chq.AccountNo</td>
                                            <td class="text-right font-medium">@chq.Amount.ToString("N0")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @* Audit Timeline Panel matching screenshot *@
                <div class="demo-card demo-pane">
                    <div class="demo-pane-header">
                        <div>
                            <h2 class="demo-pane-title">Audit Timeline</h2>
                            <span class="demo-pane-sub">4 audit event(s)</span>
                        </div>
                        <button class="demo-link-btn" @onclick="() => _auditOpen = !_auditOpen">
                            @(_auditOpen ? "⌃ Close Audit" : "⌄ Open Audit")
                        </button>
                    </div>

                    @if (_auditOpen)
                    {
                        <div class="demo-audit-events-list">
                            <div class="demo-audit-item">
                                <span class="demo-audit-time">8/11/2026, 2:03:27 PM · Admin One</span>
                                <strong class="demo-audit-act">Submit Scanning Batch</strong>
                                <p class="demo-audit-desc">Batch @_selectedBatch?.BatchNo uploaded successfully.</p>
                            </div>
                            <div class="demo-audit-item">
                                <span class="demo-audit-time">8/11/2026, 2:03:27 PM · Admin One</span>
                                <strong class="demo-audit-act">Save Scanning Batch</strong>
                                <p class="demo-audit-desc">Scanning batch validated before submit</p>
                            </div>
                            <div class="demo-audit-item">
                                <span class="demo-audit-time">8/11/2026, 2:00:39 PM · Admin One</span>
                                <strong class="demo-audit-act">Scan Cheques</strong>
                                <p class="demo-audit-desc">Scanner FB 30 U added 3 demo cheques</p>
                            </div>
                            <div class="demo-audit-item">
                                <span class="demo-audit-time">8/11/2026, 2:00:37 PM · Admin One</span>
                                <strong class="demo-audit-act">New Scanning Batch</strong>
                                <p class="demo-audit-desc">Created draft batch @_selectedBatch?.BatchNo</p>
                            </div>
                        </div>
                    }
                </div>
            </section>

            @* Right Column: Verification Summary & Checker Decision *@
            <aside class="demo-col-right">
                <div class="demo-card demo-pane">
                    <div class="demo-pane-header">
                        <h2 class="demo-pane-title">Verification Summary</h2>
                    </div>

                    <div class="demo-summary-group">
                        <span class="demo-group-label">CREDIT ACCOUNT</span>
                        <div class="demo-kv-row"><span>Account No.</span><strong>@_activeCheque?.AccountNo</strong></div>
                        <div class="demo-kv-row"><span>Status</span><span class="text-green-bold">Active</span></div>
                        <div class="demo-kv-row"><span>Customer ID</span><strong>ACC-001</strong></div>
                        <div class="demo-kv-row"><span>Account Branch</span><strong>Head Office</strong></div>
                        <div class="demo-kv-row"><span>Account Name</span><strong>Demo Trading Co.</strong></div>
                    </div>

                    <div class="demo-summary-group">
                        <span class="demo-group-label">CHEQUE DETAILS</span>
                        <div class="demo-kv-row"><span>Cheque No.</span><strong>@_activeCheque?.ChequeNo</strong></div>
                        <div class="demo-kv-row"><span>Routing No.</span><strong>@_activeCheque?.RoutingNo</strong></div>
                        <div class="demo-kv-row"><span>MICR Account</span><strong>@_activeCheque?.AccountNo</strong></div>
                        <div class="demo-kv-row"><span>Amount</span><strong>MMK @_activeCheque?.Amount.ToString("N0")</strong></div>
                        <div class="demo-kv-row"><span>Cheque Date</span><strong>2026-08-11</strong></div>
                    </div>

                    <div class="demo-summary-group">
                        <span class="demo-group-label">BATCH TOTALS</span>
                        <div class="demo-kv-row"><span>Total Cheques</span><strong>@_selectedBatch?.Cheques.Count</strong></div>
                        <div class="demo-kv-row"><span>Batch Amount</span><strong>MMK @_selectedBatch?.BatchAmount.ToString("N0")</strong></div>
                        <div class="demo-kv-row"><span>Calculated</span><strong>MMK @ActiveAcceptedAmount.ToString("N0")</strong></div>
                        <div class="demo-kv-row"><span>Accept Count</span><strong>@ActiveAcceptCount</strong></div>
                        <div class="demo-kv-row"><span>Discard Count</span><strong>@ActiveDiscardCount</strong></div>
                    </div>

                    <div class="demo-summary-group">
                        <span class="demo-group-label">MAKER DETAILS</span>
                        <div class="demo-kv-row"><span>Maker</span><strong>@_selectedBatch?.Maker</strong></div>
                        <div class="demo-kv-row"><span>Created At</span><strong>8/11/2026, 2:00:37 PM</strong></div>
                        <div class="demo-kv-row"><span>Restriction</span><span class="text-red-bold">Same maker cannot authorize</span></div>
                    </div>
                </div>

                @* Checker Decision Box *@
                <div class="demo-card demo-pane">
                    <div class="demo-pane-header">
                        <h2 class="demo-pane-title">Checker Decision</h2>
                    </div>

                    <div class="demo-field">
                        <label>REMARKS</label>
                        <input placeholder="" @bind="_checkerRemarks" />
                    </div>

                    <div class="demo-checkbox-group">
                        <label class="demo-checkbox-line">
                            <input type="checkbox" checked="@(_activeCheque?.Discarded == true)" @onchange="ToggleDiscard" />
                            <span>Discard Cheque</span>
                        </label>
                        <label class="demo-checkbox-line">
                            <input type="checkbox" @bind="_batchRemarks" />
                            <span>Batch-level remarks</span>
                        </label>
                    </div>

                    <div class="demo-validation-box">
                        <div class="demo-val-title">⚠ Validation summary</div>
                        <ul class="demo-val-list">
                            <li>Maker/checker separation blocks this user from authorizing the selected batch.</li>
                        </ul>
                    </div>
                </div>
            </aside>
        </div>

        @* Sticky Action Bar matching bottom of screenshot 2 *@
        <div class="demo-sticky-bar">
            <div class="demo-bar-left">
                <button class="demo-action-btn btn-secondary" @onclick="PrevCheque">
                    ◀ Previous
                </button>
                <button class="demo-action-btn btn-secondary" @onclick="NextCheque">
                    Next ▶
                </button>
            </div>
            <div class="demo-bar-right">
                <button class="demo-action-btn btn-primary" @onclick='() => DoBatchAction("APPROVE")'>
                    ✓ Authorize Batch
                </button>
                <button class="demo-action-btn btn-secondary" @onclick='() => DoBatchAction("REPAIR")'>
                    ✎ Send to Repair
                </button>
                <button class="demo-action-btn btn-danger" @onclick='() => DoBatchAction("DISCARD")'>
                    🗑 Discard Batch
                </button>
                <button class="demo-action-btn btn-secondary" @onclick="ExitReview">
                    ✕ Exit
                </button>
            </div>
        </div>
    }
</div>

@* ==========================================
   SELF-CONTAINED STYLES FOR EXACT DEMO MATCH
   ========================================== *@
@*
<style>
    .demo-ops-root {
        font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: #172033;
        background: #F5F7FA;
        min-height: calc(100vh - 80px);
        padding: 16px 20px 80px;
        box-sizing: border-box;
    }
    .demo-ops-root * { box-sizing: border-box; }

    .demo-card {
        background: #FFFFFF;
        border: 1px solid #D8DEE6;
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 16px;
        box-shadow: 0 1px 3px rgba(15, 42, 68, 0.05);
    }

    /* Header */
    .demo-header-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
    }
    .demo-breadcrumbs {
        font-size: 13px;
        color: #667085;
    }
    .demo-bc-bold { font-weight: 700; color: #172033; }
    .demo-bc-slash { margin: 0 6px; color: #A0AEC0; }
    .demo-bc-dim { color: #667085; }
    .demo-bc-link { color: #2563EB; cursor: pointer; text-decoration: underline; }

    .demo-top-badges {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .demo-audit-badge, .demo-user-badge {
        font-size: 12px;
        background: #FFFFFF;
        border: 1px solid #D8DEE6;
        border-radius: 6px;
        padding: 4px 10px;
        color: #172033;
    }
    .demo-user-badge { font-weight: 700; }

    .demo-header-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        border-top: 1px solid #EEF2F6;
        padding-top: 12px;
    }
    .demo-title-cluster {
