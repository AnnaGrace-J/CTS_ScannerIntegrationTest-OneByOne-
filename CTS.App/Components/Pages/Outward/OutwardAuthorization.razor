        public decimal CalculatedAmount { get; set; }
        public DateTime ScanDateTime { get; set; }
        public string SlaAge { get; set; } = string.Empty;
        public bool HasException { get; set; }
        public List<DemoChequeModel> Cheques { get; set; } = [];
