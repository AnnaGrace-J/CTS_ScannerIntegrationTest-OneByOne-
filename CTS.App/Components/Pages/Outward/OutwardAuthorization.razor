    private bool _batchRemarks;

    private List<DemoBatchModel> _batchRows = [];
    private DemoBatchModel? _selectedBatch;
    private DemoChequeModel? _activeCheque;

    protected override void OnInitialized()
    {
        _batchRows = SeedDemoData();
    }

    private List<DemoBatchModel> SeedDemoData() =>
    [
