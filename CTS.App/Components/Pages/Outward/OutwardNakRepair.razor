@page "/outward/nak-repair"
@attribute [Authorize]
@inject WorkspaceApiService Client
@inject NavigationManager Navigation

@*
// Original Code
// @page "/outward/nak-repair"
// @attribute [Authorize]
// <WorkflowWorkspace Workstep="OUTWARD_NAK_REPAIR" />
*@

@* // Code Added by KK *@
<PageTitle>Outward NAK Repair · ACE CTS</PageTitle>

<div class="demo-ops-root">
    @* Top Workspace Header *@
    <div class="demo-top-bar">
        <div class="demo-breadcrumbs">
            <span class="demo-bc-bold">ACE CTS Workspace</span>
            <span class="demo-meta-text">
                <span class="demo-icon">📅</span> Business date 2026-06-23
                <span class="demo-icon ml-2">🏛</span> Head Office
                <span class="demo-icon ml-2">Role:</span> ADMIN
            </span>
        </div>
        <div class="demo-top-badges">
            <span class="demo-audit-badge">Audit events: <strong>57</strong></span>
            <span class="demo-user-badge">admin1</span>
        </div>
    </div>

    @* Header Card with Working Hide/Show Info Toggle *@
    <div class="demo-card demo-header-card">
        @if (_infoCollapsed)
        {
            <div class="demo-header-collapsed-row">
                <div class="demo-collapsed-left">
                    <h1 class="demo-collapsed-title">Outward NAK Repair</h1>
                    <span class="demo-chip chip-online">Online</span>
                    <span class="demo-chip chip-cyan">BRANCH <strong>Head Office</strong></span>
                    <span class="demo-chip chip-blue">ROLE <strong>ADMIN</strong></span>
                    <span class="demo-chip chip-blue">DATE <strong>@DateTime.Today.ToString("yyyy-MM-dd")</strong></span>
                </div>
                <button class="demo-ghost-btn" @onclick="() => _infoCollapsed = false">
                    <span class="demo-icon">👁</span> Show Info
                </button>
            </div>
        }
        else
        {
            <div class="demo-header-full">
                <div class="demo-header-full-top">
                    <div>
                        <div class="demo-sub-breadcrumbs">
                            <span>ACE CTS Workspace</span>
                            <span class="demo-bc-sep">/</span>
                            <span>Outward</span>
                            <span class="demo-bc-sep">/</span>
                            <span class="demo-bc-current">Service Operations</span>
                        </div>
                        <h1 class="demo-main-title">Outward NAK Repair</h1>
                        <p class="demo-header-subtitle">Service Operations workspace for outward clearing automation and manual response handling.</p>
                    </div>
                    <button class="demo-ghost-btn" @onclick="() => _infoCollapsed = true">
                        <span class="demo-icon">👁</span> Hide Info
                    </button>
                </div>

                <div class="demo-header-chips-row">
                    <span class="demo-chip chip-cyan">BRANCH <strong>Head Office</strong></span>
                    <span class="demo-chip chip-blue">ROLE <strong>ADMIN</strong></span>
                    <span class="demo-chip chip-blue">BUSINESS DATE <strong>@DateTime.Today.ToString("yyyy-MM-dd")</strong></span>
                    <span class="demo-chip chip-gray">LAST UPDATED <strong>@DateTime.Now.ToString("M/d/yyyy, h:mm:ss tt")</strong></span>
                    <span class="demo-chip chip-online">STATUS <strong>Online</strong></span>
                    <span class="demo-chip chip-gray">LAST RUN TIME <strong>@_lastRunTime</strong></span>
                    <span class="demo-chip chip-gray">POLL INTERVAL <strong>10s</strong></span>
                </div>
            </div>
        }
    </div>

    @* Service Operations Control Strip *@
    <div class="demo-card demo-service-strip">
        <div class="demo-service-left">
            <div class="demo-clock-icon">🕒</div>
            <div>
                <strong class="demo-service-title">Service Operations Control</strong>
                <span class="demo-service-subtitle">Last run: @_lastRunTime</span>
            </div>
        </div>
        <div class="demo-service-right">
            <button class="demo-action-btn btn-navy" disabled="@_runningTick" @onclick="RunTick">
                <span>▶</span>
                <span>@(_runningTick ? "Running..." : "Run Service Tick")</span>
            </button>
            <label class="demo-service-toggle">
                <input type="checkbox" @bind="_autoRun" />
                <span>Auto-run @(_autoRun ? "On" : "Off")</span>
            </label>
            <span class="demo-pill pill-poll">Poll 10s</span>
            <span class="demo-pill pill-result">Last result: @_serviceResult</span>
            <span class="demo-pill pill-error">Last error: None</span>
        </div>
    </div>

    @* NAK Reason Exception Alert Banner *@
    @if (SelectedCheque != null)
    {
        <div class="demo-alert demo-alert-warning">
            <span class="demo-alert-icon">⚠️</span>
            <span>
                <strong>NAK reason:</strong> @(SelectedCheque.NakReason ?? "Invalid MICR");
                <strong>remarks:</strong> @(SelectedCheque.NakRemarks ?? "No remarks supplied")
            </span>
        </div>
    }

    @* Feedback Messages *@
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="demo-alert demo-alert-danger">
            <span>@_message</span>
        </div>
    }
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="demo-alert demo-alert-success">
            <span>✓ @_successMessage</span>
        </div>
    }

    @* NAK Repair Filters Panel with working Hide/Show Filters *@
    <div class="demo-card demo-filter-panel">
        <div class="demo-filter-header">
            <div>
                <h2 class="demo-filter-title">NAK Repair Filters</h2>
                <span class="demo-filter-count">@FilteredRows.Count matching records</span>
            </div>
            <button class="demo-ghost-btn" @onclick="() => _filtersCollapsed = !_filtersCollapsed">
                <span>@(_filtersCollapsed ? "▼ Show Filters" : "▲ Hide Filters")</span>
            </button>
        </div>
        @if (!_filtersCollapsed)
        {
            <div class="demo-filter-grid">
                <div class="demo-field">
                    <label class="demo-label">CHEQUE NO.</label>
                    <input type="text" class="demo-input" placeholder="e.g. 661004" @bind="_filterChequeNo" @bind:event="oninput" />
                </div>
                <div class="demo-field">
                    <label class="demo-label">AMOUNT</label>
                    <input type="text" class="demo-input" placeholder="e.g. 3325000" @bind="_filterAmount" @bind:event="oninput" />
                </div>
                <div class="demo-field">
                    <label class="demo-label">MICR A/C NO.</label>
                    <input type="text" class="demo-input" placeholder="Search MICR account..." @bind="_filterMicrAccount" @bind:event="oninput" />
                </div>
                <div class="demo-field">
                    <label class="demo-label">ROUTING NO.</label>
                    <input type="text" class="demo-input" placeholder="e.g. BADRT or 100002" @bind="_filterRouting" @bind:event="oninput" />
                </div>
                <div class="demo-field">
                    <label class="demo-label">CREDIT A/C NO.</label>
                    <input type="text" class="demo-input" placeholder="Search credit account..." @bind="_filterCreditAccount" @bind:event="oninput" />
                </div>
            </div>
        }
    </div>

    @* 2-Column Split: Cheque Image Review + Queue on Left, Correction Workspace on Right *@
    <div class="demo-nak-grid">
        @* Left Column: Image Viewer & Queue *@
        <div class="demo-nak-left">
            @* Cheque Image Review Card *@
            <div class="demo-card demo-viewer-card">
                <div class="demo-viewer-header">
                    <div>
                        <h3 class="demo-panel-title">NAK Repair Image Review</h3>
                        <span class="demo-panel-sub">Cheque @(SelectedCheque?.ChequeNo ?? "None")</span>
                    </div>
                    <div class="demo-viewer-tabs">
                        <button class="demo-viewer-tab-btn @(_imageView == "front" ? "active" : "")" @onclick='() => _imageView = "front"'>Front</button>
                        <button class="demo-viewer-tab-btn @(_imageView == "rear" ? "active" : "")" @onclick='() => _imageView = "rear"'>Rear</button>
                    </div>
                </div>

                <div class="demo-viewer-badge-bar">
                    <span class="demo-tag tag-repair">NAK Repair</span>
                </div>

                <div class="demo-cheque-image-frame">
                    @if (SelectedCheque != null)
                    {
                        <img src="@CurrentChequeImageUrl" alt="Cheque Image" class="demo-cheque-img" />
                    }
                    else
                    {
                        <div class="demo-empty-cell">No cheque selected.</div>
                    }
                </div>
            </div>

            @* NAK Repair Queue Table *@
            <div class="demo-card demo-table-panel">
                <div class="demo-table-panel-header">
                    <h3 class="demo-panel-title">NAK Repair Queue</h3>
                    <span class="demo-panel-sub">@FilteredRows.Count record(s)</span>
                </div>
                <div class="demo-table-wrapper">
                    <table class="demo-data-table">
                        <thead>
                            <tr>
                                <th>CHEQUE NO</th>
                                <th>AMOUNT</th>
                                <th>NAK REASON</th>
                                <th>STATUS</th>
                                <th style="width: 36px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (FilteredRows.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="demo-empty-cell">No NAK repair items match the filters.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var row in FilteredRows)
                                {
                                    var isSelected = SelectedCheque?.Id == row.Id;
                                    <tr class="demo-clickable-row @(isSelected ? "row-selected" : "")" @onclick="() => SelectCheque(row)">
                                        <td class="font-bold">@row.ChequeNo</td>
                                        <td>@row.Amount.ToString("N0")</td>
                                        <td>@(row.NakReason ?? "Rejected by clearing house")</td>
                                        <td>
                                            <span class="demo-tag tag-repair-req">@row.Status</span>
                                        </td>
                                        <td class="text-right">
                                            <span class="demo-chevron-indicator">›</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @* Right Column: Correction Workspace Form *@
        <div class="demo-nak-right">
            <div class="demo-card demo-correction-panel">
                <div class="demo-correction-header">
                    <h3 class="demo-panel-title">Correction Workspace</h3>
                </div>

                <div class="demo-correction-body">
                    @* Account Details Readonly Group *@
                    <div class="demo-field-group">
                        <div class="demo-field-group-title">ACCOUNT DETAILS</div>
                        <div class="demo-field-row">
                            <span class="field-label">Account No.</span>
                            <span class="field-value font-mono">@(SelectedCheque?.AccountNo ?? "-")</span>
                        </div>
                        <div class="demo-field-row">
                            <span class="field-label">Status</span>
                            <span class="field-value">@(SelectedCheque?.AccountStatus ?? "Closed")</span>
                        </div>
                        <div class="demo-field-row">
                            <span class="field-label">Account Name</span>
                            <span class="field-value font-bold">@(SelectedCheque?.AccountName ?? "-")</span>
                        </div>
                        <div class="demo-field-row">
                            <span class="field-label">Branch</span>
                            <span class="field-value">@(SelectedCheque?.Branch ?? "Branch 002")</span>
                        </div>
                    </div>

                    @* Editable Cheque & MICR Details *@
                    <div class="demo-correction-fields">
                        <div class="demo-field">
                            <label class="demo-label">CHEQUE NO.</label>
                            <input type="text" class="demo-input" @bind="_draftChequeNo" />
                        </div>

                        <div class="demo-field">
                            <label class="demo-label">MICR ACCOUNT NO.</label>
                            <input type="text" class="demo-input" @bind="_draftMicrAccount" />
                        </div>

                        <div class="demo-field">
                            <label class="demo-label">ROUTING NUMBER</label>
                            <input type="text" class="demo-input" @bind="_draftRouting" />
                        </div>

                        <div class="demo-field">
                            <label class="demo-label">CHEQUE TYPE</label>
                            <input type="text" class="demo-input" @bind="_draftChequeType" />
                        </div>

                        <div class="demo-field">
                            <label class="demo-label">CHECK DIGIT</label>
                            <input type="text" class="demo-input" @bind="_draftCheckDigit" />
                        </div>

                        <div class="demo-field">
                            <label class="demo-label">REMARKS</label>
                            <input type="text" class="demo-input" placeholder="Enter correction remarks..." @bind="_draftRemarks" />
                        </div>

                        <div class="demo-field">
                            <label class="demo-label">NAK REASON</label>
                            <input type="text" class="demo-input demo-input-disabled" disabled value="@(SelectedCheque?.NakReason ?? "")" />
                        </div>

                        <div class="demo-field">
                            <label class="demo-label">NAK REMARKS</label>
                            <input type="text" class="demo-input demo-input-disabled" disabled value="@(SelectedCheque?.NakRemarks ?? "")" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Sticky Action Bar matching Demo Screenshot *@
    <div class="demo-card demo-sticky-actions">
        <button class="demo-action-btn btn-navy" disabled="@(SelectedCheque == null)" @onclick="AcceptCheque">
            <span>✓</span>
            <span>Accept</span>
        </button>
        <button class="demo-action-btn btn-secondary" disabled="@(SelectedCheque == null)" @onclick="DiscardCheque">
            <span>🗑</span>
            <span>Discard</span>
        </button>
        <button class="demo-action-btn btn-secondary" @onclick='() => Navigation.NavigateTo("/outward/dashboard")'>
            <span>✕</span>
            <span>Exit</span>
        </button>
    </div>

    @* Collapsible Audit Timeline matching Screenshot *@
    <div class="demo-card demo-pane">
        <div class="demo-pane-header">
            <div>
                <strong class="demo-panel-title">Audit Timeline</strong>
                <span class="demo-panel-sub ml-2">@_auditEvents.Count audit event(s)</span>
            </div>
            <button class="demo-link-btn" @onclick="() => _auditOpen = !_auditOpen">
                <span>@(_auditOpen ? "▲ Close Audit" : "▼ Open Audit")</span>
            </button>
        </div>
        @if (_auditOpen)
        {
            <div class="demo-audit-events-list">
                @foreach (var ev in _auditEvents)
                {
                    <div class="demo-audit-item">
                        <span class="demo-audit-time">@ev.Timestamp - @ev.User</span>
                        <strong class="demo-audit-act">@ev.Action</strong>
                        <p class="demo-audit-desc">@ev.Description</p>
                    </div>
                }
            </div>
        }
    </div>
</div>

@*
