    private void OpenBatchDetail(BatchViewModel batch)
    {
        _selectedBatch = batch;
        _currentChequeIndex = 0;
        _activeCheque = batch.Cheques.FirstOrDefault();
        _validationErrors.Clear();
        _repairNotes = string.Empty;
        _notice = null;
        _error = null;
        _reviewMode = true;
    }

    private void SelectCheque(int index)
    {
        if (_selectedBatch is null || index < 0 || index >= _selectedBatch.Cheques.Count) return;
        _currentChequeIndex = index;
        _activeCheque = _selectedBatch.Cheques[index];
    }

    private void GoPrevious()
    {
        if (_currentChequeIndex > 0) SelectCheque(_currentChequeIndex - 1);
    }

    private void GoNext()
    {
        if (_selectedBatch is not null && _currentChequeIndex < _selectedBatch.Cheques.Count - 1)
        {
            SelectCheque(_currentChequeIndex + 1);
        }
    }

    private void OnChequeFieldModified()
    {
        ValidateCurrentBatch();
    }

    private int GetChangedFieldsCount(ChequeEditModel cheque)
    {
        var count = 0;
        if (cheque.ChequeNo != cheque.OriginalChequeNo) count++;
        if (cheque.MicrAccountNo != cheque.OriginalMicrAccountNo) count++;
        if (cheque.RoutingNo != cheque.OriginalRoutingNo) count++;
        if (cheque.ChequeType != cheque.OriginalChequeType) count++;
        if (cheque.CheckDigit != cheque.OriginalCheckDigit) count++;
        if (cheque.Amount != cheque.OriginalAmount) count++;
        if (cheque.ChequeDate != cheque.OriginalChequeDate) count++;
        if (cheque.DrawerName != cheque.OriginalDrawerName) count++;
        if (cheque.Remarks != cheque.OriginalRemarks) count++;
        if (cheque.IsDiscarded != cheque.OriginalIsDiscarded) count++;
        return count;
    }

    private bool ValidateCurrentBatch()
    {
        _validationErrors.Clear();
        if (_selectedBatch is null) return false;

        foreach (var chk in _selectedBatch.Cheques)
        {
            if (string.IsNullOrWhiteSpace(chk.ChequeNo)) _validationErrors.Add($"Cheque [{chk.ChequeId}]: Cheque number cannot be blank.");
            if (string.IsNullOrWhiteSpace(chk.MicrAccountNo)) _validationErrors.Add($"Cheque [{chk.ChequeNo}]: MICR account number cannot be blank.");
            if (string.IsNullOrWhiteSpace(chk.RoutingNo)) _validationErrors.Add($"Cheque [{chk.ChequeNo}]: Routing number cannot be blank.");
            if (chk.Amount <= 0) _validationErrors.Add($"Cheque [{chk.ChequeNo}]: Amount must be greater than zero.");
            if (!chk.ChequeDate.HasValue) _validationErrors.Add($"Cheque [{chk.ChequeNo}]: Issue date is required.");
        }

        return _validationErrors.Count == 0;
    }

    private void SaveDraft()
    {
        _notice = $"Draft changes saved locally for Batch {_selectedBatch?.BatchId}.";
    }

    private void PromptComplete()
    {
        if (!ValidateCurrentBatch()) return;
        _showCompleteModal = true;
    }

    private async Task ConfirmCompleteRepairAsync()
    {
        _showCompleteModal = false;
        if (_selectedBatch is null) return;

        _processing = true;
        _error = null;

        var firstChequeId = _selectedBatch.Cheques.FirstOrDefault()?.ChequeId ?? _selectedBatch.BatchId;
        var result = await Client.ActionAsync(new QueueActionRequestModel(firstChequeId, "OUTWARD.REPAIR.RESUBMIT", _repairNotes));

        _processing = false;

        _notice = $"Batch {_selectedBatch.BatchId} repair completed successfully and routed to Outward Authorization.";
        _reviewMode = false;
        _batches.Remove(_selectedBatch);
        _selectedBatch = null;
        _activeCheque = null;
    }

    private void PromptExit()
    {
        if (TotalBatchChangedCount > 0)
        {
            _showExitModal = true;
        }
        else
        {
            ConfirmExit();
        }
    }

    private void ConfirmExit()
    {
        _showExitModal = false;
        _reviewMode = false;
        _selectedBatch = null;
        _activeCheque = null;
    }

