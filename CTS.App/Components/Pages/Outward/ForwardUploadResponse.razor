    private bool _runningTick = false;
    private bool _auditOpen = true;
    private bool _exceptionMode = false;

    private string _lastRunTime = "Not run this session";
    private string _serviceResult = "1 forward upload file(s) awaiting response.";

    private string _filterChequeNo = "";
    private string _filterAmount = "";
    private string _filterMicrAccount = "";
    private string _filterRouting = "";
    private string _filterCreditAccount = "";
    private string _filterFileName = "";

    private string _fileReason = "Insufficient Funds";
    private string _fileRemarks = "";

    private List<UploadFileModel> _files = [];
    private UploadFileModel? _selectedFile;
    private List<ChequeRowModel> _chequeRows = [];

    protected override void OnInitialized()
    {
        _files =
        [
            new()
            {
                FileName = "MMDB_OUT_20260818_004.icl",
                ChequeCount = 4,
                TotalAmount = 6985000m,
                GeneratedPath = @"C:\CTS\Outward\Upload\",
                Status = "Uploaded"
            }
        ];

        _selectedFile = _files.FirstOrDefault();

        _chequeRows =
        [
            new() { ChequeNo = "908421", Amount = 1250000m, MicrAccount = "001000245117999", Routing = "100001", Status = "Accepted", Remarks = "" },
            new() { ChequeNo = "801122", Amount = 870000m, MicrAccount = "002009881230145", Routing = "100002", Status = "Accepted", Remarks = "" },
            new() { ChequeNo = "801123", Amount = 1540000m, MicrAccount = "002009881230145", Routing = "100002", Status = "Accepted", Remarks = "" },
            new() { ChequeNo = "661004", Amount = 3325000m, MicrAccount = "002010440996871", Routing = "BADRT", Status = "Accepted", Remarks = "" }
        ];
    }

    private List<UploadFileModel> FilteredFiles => _files
        .Where(f => string.IsNullOrWhiteSpace(_filterFileName) || f.FileName.Contains(_filterFileName, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private void SelectFile(UploadFileModel file)
    {
        _selectedFile = file;
    }

    private async Task RunTick()
    {
        _runningTick = true;
        await Task.Delay(350);
        _lastRunTime = DateTime.Now.ToString("M/d/yyyy, h:mm:ss tt");
        _serviceResult = $"{_files.Count} forward upload file(s) awaiting response.";
        _runningTick = false;
    }

    private void AcceptAll()
    {
        foreach (var c in _chequeRows)
        {
            c.Status = "Accepted";
        }
        _lastRunTime = DateTime.Now.ToString("M/d/yyyy, h:mm:ss tt");
        _serviceResult = $"All cheques in {_selectedFile?.FileName} accepted.";
    }

    private void RejectAll()
    {
        foreach (var c in _chequeRows)
        {
            c.Status = "Rejected";
        }
        _lastRunTime = DateTime.Now.ToString("M/d/yyyy, h:mm:ss tt");
        _serviceResult = $"All cheques in {_selectedFile?.FileName} rejected.";
    }

    private void AcceptWithException()
    {
        _lastRunTime = DateTime.Now.ToString("M/d/yyyy, h:mm:ss tt");
        _serviceResult = $"Response recorded with exceptions for {_selectedFile?.FileName}.";
    }

    private sealed class UploadFileModel
    {
        public string FileName { get; set; } = string.Empty;
        public int ChequeCount { get; set; }
        public decimal TotalAmount { get; set; }
        public string GeneratedPath { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
    }

    private sealed class ChequeRowModel
    {
        public string ChequeNo { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public string MicrAccount { get; set; } = string.Empty;
        public string Routing { get; set; } = string.Empty;
        public string Status { get; set; } = "Accepted";
        public string Remarks { get; set; } = string.Empty;
    }
