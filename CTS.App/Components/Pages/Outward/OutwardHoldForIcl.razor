@page "/outward/hold-for-icl-generation"
@attribute [Authorize]
@inject WorkspaceApiService Client
@inject NavigationManager Navigation

@*
// Origin Code:
// @page "/outward/hold-for-icl-generation"
// @attribute [Authorize]
// <WorkflowWorkspace Workstep="HOLD_FOR_ICL_GENERATION" />
*@

@* // New Code by KK *@
<PageTitle>Hold for ICL File Generation · ACE CTS</PageTitle>

<div class="demo-ops-root">
    @* Top Workspace Header *@
    <div class="demo-top-bar">
        <div class="demo-breadcrumbs">
            <span class="demo-bc-bold">ACE CTS Workspace</span>
            <span class="demo-meta-text">
                <span class="demo-icon">📅</span> Business date 2026-06-23
                <span class="demo-icon ml-2">🏛</span> Head Office
                <span class="demo-icon ml-2">Role:</span> ADMIN
            </span>
        </div>
        <div class="demo-top-badges">
            <span class="demo-audit-badge">Audit events: <strong>58</strong></span>
            <span class="demo-user-badge">admin1</span>
        </div>
    </div>

    @* Title Bar with Working Show/Hide Info *@
    <div class="demo-title-bar">
        <div class="demo-title-cluster">
            <h1 class="demo-main-title">Hold for ICL File Generation</h1>
            <span class="demo-chip chip-online">Online</span>
            <span class="demo-chip chip-cyan">BRANCH <strong>Head Office</strong></span>
            <span class="demo-chip chip-blue">ROLE <strong>ADMIN</strong></span>
            <span class="demo-chip chip-blue">DATE <strong>2026-09-09</strong></span>
        </div>
        <button class="demo-ghost-btn" @onclick="() => _showInfo = !_showInfo">
            <span class="demo-icon">⚙</span> @(_showInfo ? "Hide Info" : "Show Info")
        </button>
    </div>

    @* Expandable Info Drawer *@
    @if (_showInfo)
    {
        <div class="demo-info-drawer">
            <div class="demo-info-item"><span>Service Status:</span> <strong>Active &amp; Polling</strong></div>
            <div class="demo-info-item"><span>Value Date Target:</span> <strong>Current Business Date (2026-06-23)</strong></div>
            <div class="demo-info-item"><span>Poll Interval:</span> <strong>10 seconds</strong></div>
            <div class="demo-info-item"><span>Forward Workstep:</span> <strong>ICL_FILE_GENERATION</strong></div>
        </div>
    }

    @* Service Operations Control Strip *@
    <div class="demo-card demo-service-strip">
        <div class="demo-service-left">
            <div class="demo-clock-icon">🕒</div>
            <div>
                <strong class="demo-service-title">Service Operations Control</strong>
                <span class="demo-service-subtitle">Last run: @_lastRunTime</span>
            </div>
        </div>
        <div class="demo-service-right">
            <button class="demo-action-btn btn-navy" disabled="@_runningTick" @onclick="RunTick">
                <span>▶</span>
                <span>@(_runningTick ? "Running..." : "Run Service Tick")</span>
            </button>
            <label class="demo-service-toggle">
                <input type="checkbox" @bind="_autoRun" />
                <span>Auto-run @(_autoRun ? "On" : "Off")</span>
            </label>
            <span class="demo-pill pill-poll">Poll 10s</span>
            <span class="demo-pill pill-result">Last result: @_serviceResult</span>
            <span class="demo-pill pill-error">Last error: None</span>
        </div>
    </div>

    @* KPI Summary Strip with Working Show/Hide Summary *@
    <div class="demo-summary-row">
        <div class="demo-pills-wrap">
            <span class="demo-summary-pill pill-orange">HELD CHEQUES <strong>@_heldItems.Count</strong></span>
            <span class="demo-summary-pill pill-green">READY <strong>@ReadyCount</strong></span>
            <span class="demo-summary-pill pill-gray">WAITING <strong>@WaitingCount</strong></span>
            <span class="demo-summary-pill pill-blue">TOTAL AMOUNT <strong>MMK @TotalHeldAmount.ToString("N0")</strong></span>
        </div>
        <button class="demo-ghost-btn" @onclick="() => _showSummary = !_showSummary">
            <span class="demo-icon">👁</span> @(_showSummary ? "Hide Summary" : "Show Summary")
        </button>
    </div>

    @* Expandable Summary Drawer *@
    @if (_showSummary)
    {
        <div class="demo-summary-drawer">
            <div class="demo-summary-metric">
                <span>Total Held Instruments</span>
                <strong>@_heldItems.Count items</strong>
            </div>
            <div class="demo-summary-metric">
                <span>Eligible For Immediate Release</span>
                <strong class="text-emerald">@ReadyCount cheques</strong>
            </div>
            <div class="demo-summary-metric">
                <span>Future Value Date</span>
                <strong>@WaitingCount cheques</strong>
            </div>
            <div class="demo-summary-metric">
                <span>Total Held Value</span>
                <strong>MMK @TotalHeldAmount.ToString("N0")</strong>
            </div>
        </div>
    }

    @* Held Instruments Table Grid *@
    <div class="demo-card demo-table-panel">
        <div class="demo-table-panel-header">
            <div>
                <h3 class="demo-panel-title">Held Instruments</h3>
                <span class="demo-panel-sub">Instruments held pending value-date maturity</span>
            </div>
            <button class="demo-action-btn btn-navy" disabled="@(ReadyCount == 0)" @onclick="ReleaseReadyCheques">
                ✓ Release Ready Cheques (@ReadyCount)
            </button>
        </div>
        <div class="demo-table-wrapper">
            <table class="demo-data-table">
                <thead>
                    <tr>
                        <th>CHEQUE NO</th>
                        <th>BATCH</th>
                        <th>VALUE DATE</th>
                        <th>BUSINESS DATE</th>
                        <th>HOLD REASON</th>
                        <th class="text-center">READY / WAITING</th>
                        <th class="text-right">AMOUNT</th>
                        <th class="text-center">ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_heldItems.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="demo-empty-cell">No held instruments in this cycle.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in _heldItems)
                        {
                            var isReady = row.ValueDate <= DateTime.Today;
                            <tr class="demo-clickable-row">
                                <td class="font-bold text-blue">@row.ChequeNo</td>
                                <td class="font-mono">@row.BatchNo</td>
                                <td>@row.ValueDate.ToString("yyyy-MM-dd")</td>
                                <td>@DateTime.Today.ToString("yyyy-MM-dd")</td>
                                <td>@(isReady ? "Business date reached" : "Waiting for value date")</td>
                                <td class="text-center">
                                    <span class="demo-tag @(isReady ? "tag-ready" : "tag-waiting")">
                                        @(isReady ? "Ready" : "Waiting")
                                    </span>
                                </td>
                                <td class="text-right font-medium">@row.Amount.ToString("N0")</td>
                                <td class="text-center">
                                    <button class="demo-review-btn" disabled="@(!isReady)" @onclick="() => ReleaseSingle(row)">
                                        Release →
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* Audit Timeline Panel *@
    <div class="demo-card demo-pane">
        <div class="demo-pane-header">
            <div>
                <h3 class="demo-pane-title">Audit Timeline</h3>
                <span class="demo-pane-sub">Recent service activities</span>
            </div>
            <button class="demo-link-btn" @onclick="() => _auditOpen = !_auditOpen">
                @(_auditOpen ? "⌃ Close Audit" : "⌄ Open Audit")
            </button>
        </div>

        @if (_auditOpen)
        {
            <div class="demo-audit-events-list">
                <div class="demo-audit-item">
                    <span class="demo-audit-time">@DateTime.Now.AddMinutes(-12).ToString("M/d/yyyy, h:mm:ss tt") · System Service</span>
                    <strong class="demo-audit-act">Value Date Check</strong>
                    <p class="demo-audit-desc">Validated maturity dates for outward clearing held batches.</p>
                </div>
                <div class="demo-audit-item">
                    <span class="demo-audit-time">@DateTime.Now.AddMinutes(-40).ToString("M/d/yyyy, h:mm:ss tt") · admin1</span>
                    <strong class="demo-audit-act">Authorized Outward Batch</strong>
                    <p class="demo-audit-desc">Batch OUTWARD-20260811 approved and routed to Hold for ICL.</p>
                </div>
            </div>
        }
    </div>
</div>

@* Self-Contained Styles matching Vercel Demo *@
