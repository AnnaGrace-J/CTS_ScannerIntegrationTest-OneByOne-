<style>
    .demo-ops-root {
        font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: #172033;
        background: #F5F7FA;
        min-height: calc(100vh - 80px);
        padding: 16px 24px 60px;
        box-sizing: border-box;
    }
    .demo-ops-root * { box-sizing: border-box; }

    .demo-top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
    }
    .demo-breadcrumbs { font-size: 13px; color: #667085; }
    .demo-bc-bold { font-weight: 700; color: #172033; margin-right: 12px; }
    .demo-meta-text { font-size: 12px; color: #64748B; }
    .demo-icon { opacity: 0.8; }
    .ml-2 { margin-left: 10px; }

    .demo-top-badges { display: flex; align-items: center; gap: 8px; }
    .demo-audit-badge, .demo-user-badge {
        font-size: 12px;
        background: #FFFFFF;
        border: 1px solid #D8DEE6;
        border-radius: 6px;
        padding: 4px 10px;
        color: #172033;
    }
    .demo-user-badge { font-weight: 700; }

    .demo-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
    }
    .demo-title-cluster { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; }
    .demo-main-title { font-size: 20px; font-weight: 800; margin: 0; color: #0F2A44; letter-spacing: -0.01em; }
    .demo-chip {
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .chip-online { background: #DCFCE7; color: #15803D; border: 1px solid #BBF7D0; }
    .chip-cyan { background: #E0F2FE; color: #0369A1; border: 1px solid #BAE6FD; }
    .chip-blue { background: #EFF6FF; color: #1D4ED8; border: 1px solid #BFDBFE; }

    .demo-ghost-btn {
        background: #FFFFFF;
        border: 1px solid #D8DEE6;
        border-radius: 6px;
        padding: 6px 14px;
        font-size: 12px;
        font-weight: 600;
        color: #172033;
        cursor: pointer;
    }
    .demo-ghost-btn:hover { background: #F8FAFC; }

    .demo-info-drawer, .demo-summary-drawer {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 12px;
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        padding: 14px 18px;
        margin-bottom: 16px;
        font-size: 12px;
    }
    .demo-info-item span { color: #64748B; margin-right: 6px; }
    .demo-summary-metric span { display: block; color: #64748B; font-size: 11px; }
    .demo-summary-metric strong { display: block; font-size: 15px; color: #0F2A44; margin-top: 2px; }
    .text-emerald { color: #059669 !important; }

    .demo-card {
        background: #FFFFFF;
        border: 1px solid #D8DEE6;
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 16px;
        box-shadow: 0 1px 3px rgba(15, 42, 68, 0.05);
    }

    .demo-service-strip {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 12px 18px;
    }
    .demo-service-left { display: flex; align-items: center; gap: 10px; }
    .demo-clock-icon {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #ECFDF5;
        color: #059669;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }
    .demo-service-title { display: block; font-size: 13px; font-weight: 800; color: #0F2A44; }
    .demo-service-subtitle { display: block; font-size: 11px; color: #64748B; }

    .demo-service-right { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
    .demo-action-btn {
        height: 36px;
        padding: 0 14px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid transparent;
        transition: all 0.15s;
    }
    .btn-navy { background: #0F2A44; color: #FFFFFF; border-color: #0F2A44; }
    .btn-navy:hover { background: #1E4E79; }
    .btn-navy:disabled { opacity: 0.6; cursor: not-allowed; }

    .demo-service-toggle {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #FFFFFF;
        border: 1px solid #D8DEE6;
        border-radius: 6px;
        padding: 0 10px;
        height: 36px;
        font-size: 12px;
        font-weight: 600;
        color: #0F2A44;
        cursor: pointer;
    }

    .demo-pill {
        display: inline-flex;
        align-items: center;
        height: 36px;
        padding: 0 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 700;
    }
    .pill-poll { background: #F8FAFC; border: 1px solid #E2E8F0; color: #0F2A44; }
    .pill-result { background: #ECFDF5; border: 1px solid #A7F3D0; color: #047857; }
    .pill-error { background: #FEF2F2; border: 1px solid #FECACA; color: #B91C1C; }

    /* Summary row */
    .demo-summary-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 16px;
    }
    .demo-pills-wrap { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
    .demo-summary-pill {
        font-size: 11px;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 20px;
        letter-spacing: 0.03em;
    }
    .pill-orange { background: #FEF3C7; color: #B45309; border: 1px solid #FDE68A; }
    .pill-green { background: #DCFCE7; color: #15803D; border: 1px solid #BBF7D0; }
    .pill-gray { background: #F1F5F9; color: #475569; border: 1px solid #E2E8F0; }
    .pill-blue { background: #EFF6FF; color: #2563EB; border: 1px solid #BFDBFE; }

    /* Tables */
    .demo-table-panel { padding: 0; overflow: hidden; }
    .demo-table-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 20px;
        border-bottom: 1px solid #EEF2F6;
    }
    .demo-panel-title { font-size: 14px; font-weight: 800; color: #0F2A44; margin: 0; }
    .demo-panel-sub { font-size: 11px; color: #64748B; }

    .demo-table-wrapper { width: 100%; overflow-x: auto; }
    .demo-data-table { width: 100%; border-collapse: collapse; font-size: 12px; text-align: left; }
    .demo-data-table th {
        background: #F8FAFC;
        color: #475569;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 10px 14px;
        border-bottom: 1px solid #E2E8F0;
        white-space: nowrap;
    }
    .demo-data-table td {
        padding: 12px 14px;
        border-bottom: 1px solid #EEF2F6;
        color: #172033;
        white-space: nowrap;
    }
    .demo-clickable-row { transition: background 0.12s; }
    .demo-clickable-row:hover { background: #F0F7FF; }
    .demo-empty-cell { text-align: center; color: #94A3B8; padding: 28px 16px; }

    .demo-tag {
        display: inline-block;
        font-size: 11px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 4px;
    }
    .tag-ready { background: #DCFCE7; color: #15803D; border: 1px solid #BBF7D0; }
    .tag-waiting { background: #FEF3C7; color: #B45309; border: 1px solid #FDE68A; }

    .demo-review-btn {
        background: #EFF6FF;
        border: 1px solid #BFDBFE;
        color: #1D4ED8;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 4px;
        cursor: pointer;
    }
    .demo-review-btn:disabled { opacity: 0.4; cursor: not-allowed; }

    /* Audit */
    .demo-pane { padding: 14px 20px; }
    .demo-pane-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
        border-bottom: 1px solid #EEF2F6;
        padding-bottom: 8px;
    }
    .demo-link-btn {
        background: none;
        border: none;
        color: #2563EB;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
    }

    .demo-audit-events-list { display: flex; flex-direction: column; gap: 12px; padding-top: 8px; }
    .demo-audit-item { border-left: 2px solid #2563EB; padding-left: 10px; }
    .demo-audit-time { font-size: 10px; color: #94A3B8; display: block; }
    .demo-audit-act { font-size: 12px; color: #0F2A44; display: block; margin: 1px 0; }
    .demo-audit-desc { font-size: 11px; color: #64748B; margin: 0; }

    .font-mono { font-family: monospace; }
    .font-medium { font-weight: 600; }
    .font-bold { font-weight: 700; }
    .text-blue { color: #2563EB; }
    .text-center { text-align: center; }
    .text-right { text-align: right; }
</style>
*@

