@code {
    private bool _showInfo;
    private bool _showSummary;
    private bool _autoRun;
    private bool _runningTick;
    private bool _auditOpen = true;

    private string _lastRunTime = "Not run this session";
    private string _serviceResult = "1 cheque(s) ready for file generation.";

    private List<HeldChequeModel> _heldItems = [];

    protected override void OnInitialized()
    {
        _heldItems =
        [
            new() { ChequeNo = "100004", BatchNo = "OB-20260812-003", ValueDate = DateTime.Today, Amount = 4500000m },
            new() { ChequeNo = "100005", BatchNo = "OB-20260812-003", ValueDate = DateTime.Today.AddDays(1), Amount = 2500000m },
            new() { ChequeNo = "100006", BatchNo = "OB-20260812-004", ValueDate = DateTime.Today, Amount = 1200000m }
        ];
        _serviceResult = $"{ReadyCount} cheque(s) ready for file generation.";
    }

    private int ReadyCount => _heldItems.Count(h => h.ValueDate <= DateTime.Today);
    private int WaitingCount => _heldItems.Count(h => h.ValueDate > DateTime.Today);
    private decimal TotalHeldAmount => _heldItems.Sum(h => h.Amount);

    private async Task RunTick()
    {
        _runningTick = true;
        await Task.Delay(350);
        _lastRunTime = DateTime.Now.ToString("M/d/yyyy, h:mm:ss tt");
        _serviceResult = $"{ReadyCount} cheque(s) ready for file generation.";
        _runningTick = false;
    }

    private void ReleaseReadyCheques()
    {
        _heldItems.RemoveAll(h => h.ValueDate <= DateTime.Today);
        _lastRunTime = DateTime.Now.ToString("M/d/yyyy, h:mm:ss tt");
        _serviceResult = "Ready cheques released to ICL generation.";
    }

    private void ReleaseSingle(HeldChequeModel row)
    {
        _heldItems.Remove(row);
        _lastRunTime = DateTime.Now.ToString("M/d/yyyy, h:mm:ss tt");
        _serviceResult = $"Cheque {row.ChequeNo} released to ICL generation.";
    }

    private sealed class HeldChequeModel
    {
        public string ChequeNo { get; set; } = string.Empty;
        public string BatchNo { get; set; } = string.Empty;
        public DateTime ValueDate { get; set; }
        public decimal Amount { get; set; }
    }
}
