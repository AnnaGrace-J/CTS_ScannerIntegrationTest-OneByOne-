    private void ZoomIn() => _zoomLevel = Math.Min(1.5, Math.Round(_zoomLevel + 0.1, 2));
    private void ZoomOut() => _zoomLevel = Math.Max(0.7, Math.Round(_zoomLevel - 0.1, 2));
