@page "/outward/scanning"
@attribute [Authorize]
@inject WorkspaceApiService Client
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory
@using CTS.Shared.Features.Scanner

@*
// Original Code
// @page "/outward/scanning"
// @attribute [Authorize]
// <WorkflowWorkspace Workstep="SCANNING_DATA_ENTRY" />
*@

@* // Modified by KK *@
<PageTitle>Outward Scanning & Data Entry · ACE CTS</PageTitle>

<div class="demo-ops-root">
    @* --- Compact Top Bar or Full Header --- *@
    @if (_infoCollapsed)
    {
        <div class="demo-card demo-compact-bar">
            <div class="demo-compact-left">
                <span class="demo-title-compact">Outward Scanning & Data Entry</span>
                <span class="demo-status-pill @(_currentBatch != null ? "status-open" : "status-nobatch")">
                    @(_currentBatch != null ? "Open" : "No Batch")
                </span>
                <span class="demo-chip chip-cyan">BRANCH <strong>@_branchName</strong></span>
                <span class="demo-chip chip-blue">BATCH <strong>@(_currentBatch?.Id ?? "Not created")</strong></span>
                <span class="demo-chip chip-blue">CHEQUES <strong>@_drafts.Count</strong></span>
                <span class="demo-chip chip-cyan">CALC <strong>@CalculatedAmount.ToString("N0")</strong></span>
                <span class="demo-chip @(_validationErrors.Count > 0 ? "chip-danger" : _drafts.Count > 0 ? "chip-success" : "chip-blue")">
                    VALIDATION <strong>@ValidationStatus</strong>
                </span>
            </div>
            <button class="demo-ghost-btn" @onclick="() => _infoCollapsed = false">
                <span class="demo-icon">◉</span> Show Info
            </button>
        </div>
    }
    else
    {
        <div class="demo-card demo-header-card">
            <div class="demo-header-top">
                <div class="demo-breadcrumbs">
                    <span class="demo-bc-bold">ACE CTS Workspace</span>
                    <span class="demo-bc-slash">/</span>
                    <span class="demo-bc-dim">Outward Clearing</span>
                    <span class="demo-bc-slash">/</span>
                    <span class="demo-bc-dim">Scanning</span>
                </div>
                <div class="demo-top-badges">
                    <span class="demo-audit-badge">Audit events: <strong>59</strong></span>
                    <span class="demo-user-badge">admin1</span>
                </div>
            </div>
            <div class="demo-header-bottom">
                <div class="demo-title-cluster">
                    <h1 class="demo-main-title">Outward Scanning & Data Entry</h1>
                    <span class="demo-status-pill @(_currentBatch != null ? "status-open" : "status-nobatch")">
                        @(_currentBatch != null ? "Open" : "No Batch")
                    </span>
                    <span class="demo-chip chip-cyan">BRANCH <strong>@_branchName</strong></span>
                    <span class="demo-chip chip-blue">ROLE <strong>ADMIN</strong></span>
                    <span class="demo-chip chip-blue">DATE <strong>@DateTime.Today.ToString("M/d/yyyy")</strong></span>
                </div>
                <div class="demo-header-actions">
                    <button class="demo-ghost-btn" @onclick="() => _infoCollapsed = true">
                        <span class="demo-icon">◎</span> Hide Info
                    </button>
                    <button class="demo-ghost-btn" disabled="@(_drafts.Count == 0)" @onclick="PrevCheque">
                        ◀ Prev
                    </button>
                    <button class="demo-ghost-btn" disabled="@(_drafts.Count == 0)" @onclick="NextCheque">
                        Next ▶
                    </button>
                </div>
            </div>

            <div class="demo-summary-row" style="margin-top: 12px;">
                <div class="demo-pills-wrap">
                    <span class="demo-summary-pill pill-cyan">ACCOUNT <strong>@(Selected?.AccountFetched == true ? "Fetched" : "Not fetched")</strong></span>
                    <span class="demo-summary-pill pill-blue">SCANNER <strong>FB 30 U</strong></span>
                    <span class="demo-summary-pill pill-blue">BATCH TOTAL <strong>@(string.IsNullOrEmpty(_batchAmountInput) ? "0" : Convert.ToInt64(_batchAmountInput).ToString("N0"))</strong></span>
                    <span class="demo-summary-pill pill-cyan">CALCULATED <strong>@CalculatedAmount.ToString("N0")</strong></span>
                    <span class="demo-summary-pill pill-blue">CHEQUES <strong>@_drafts.Count</strong></span>
                    <span class="demo-summary-pill @(_validationErrors.Count > 0 ? "pill-danger" : "pill-cyan")">VALIDATION <strong>@ValidationStatus</strong></span>
                </div>
            </div>
        </div>
    }

    @* --- Validation Errors Alert Banner --- *@
    @if (_validationErrors.Count > 0)
    {
        <div class="demo-alert demo-alert-danger">
            <strong>Validation Issues:</strong>
            <ul style="margin: 4px 0 0 16px; padding: 0;">
                @foreach (var err in _validationErrors)
                {
                    <li>@err</li>
                }
            </ul>
        </div>
    }

    @* --- Info / Success Banner --- *@
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="demo-alert demo-alert-warning">
            <span>@_message</span>
        </div>
    }
    @if (!string.IsNullOrEmpty(_success))
    {
        <div class="demo-alert demo-alert-success">
            <span>✔ @_success</span>
        </div>
    }

    @* --- OneByOne Paused in Track Banner --- *@
    @if (_isPaperWaitingInTrack && _pausedCheque != null)
    {
        <div class="demo-alert demo-alert-warning" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; padding:10px 14px;">
            <div>
                <strong>⏸ CHEQUE PAUSED IN TRACK:</strong>
                <span>Cheque No: <strong>@_pausedCheque.ChequeNo</strong> | Routing: <strong>@_pausedCheque.MicrRoutingNumber</strong> | A/C: <strong>@_pausedCheque.MicrAccountNo</strong></span>
            </div>
            <div style="display:flex; gap:8px;">
                <button class="demo-action-btn btn-primary" style="background:#16a34a; border-color:#16a34a; color:#fff;" @onclick="EjectAndPrint">
                    🖨 Eject &amp; Print Stamp
                </button>
                <button class="demo-action-btn btn-secondary" @onclick="EjectWithoutPrint">
                    ⏏ Eject Clean (No Ink)
                </button>
            </div>
        </div>
    }

    @* ==========================================
       3-COLUMN WORKSPACE GRID
       ========================================== *@
    <div class="scanning-3col-grid">
        @* ----------------------------------------
           LEFT COLUMN: CHEQUE IMAGE VIEWER
           ---------------------------------------- *@
        <div class="scanning-col left-col">
            <div class="demo-card img-tabs-card">
                <div class="img-tabs-bar">
                    <button class="img-tab-btn @(_imageTab == "Front B&W" ? "active" : "")" @onclick='() => _imageTab = "Front B&W"'>Front B&W</button>
                    <button class="img-tab-btn @(_imageTab == "Rear B&W" ? "active" : "")" @onclick='() => _imageTab = "Rear B&W"'>Rear B&W</button>
                    <button class="img-tab-btn @(_imageTab == "Front Gray" ? "active" : "")" @onclick='() => _imageTab = "Front Gray"'>Front Gray</button>
                    <button class="img-tab-btn @(_imageTab == "Front UV" ? "active" : "")" @onclick='() => _imageTab = "Front UV"'>Front UV</button>
                </div>
            </div>

            <div class="demo-card viewer-card">
                <div class="viewer-header">
                    <div>
                        <div class="viewer-title">Cheque Image Viewer</div>
                        <div class="viewer-subtitle">@(Selected != null ? $"Cheque {Selected.ChequeNo}" : "No cheque selected")</div>
                    </div>
                    <div class="viewer-controls">
                        <button class="viewer-tool-btn" title="Zoom Out" @onclick="ZoomOut">🔍-</button>
                        <button class="viewer-tool-btn" title="Zoom In" @onclick="ZoomIn">🔍+</button>
                        <button class="viewer-tool-btn" title="Rotate" @onclick="RotateImage">⟳</button>
                        <button class="viewer-tool-btn" title="Fit / Reset" @onclick="ResetZoom">⛶</button>
                    </div>
                </div>

                <div class="viewer-badges">
                    <span class="viewer-status-badge @(Selected?.ImageQualityFlags.Count > 0 ? "badge-iqa" : "badge-ok")">
                        @(Selected?.ImageQualityFlags.Count > 0 ? "IQA Review" : "Image OK")
                    </span>
                    <span class="viewer-chip">UIC @(Selected?.Uic ?? "Not assigned")</span>
                    <span class="viewer-chip">Endorsement @(Selected?.Uic != null ? Selected.Uic.Substring(Math.Max(0, Selected.Uic.Length - 10)) : "Pending")</span>
                </div>

                <div class="cheque-canvas-container">
                    <div class="cheque-viewport" style="transform: scale(@_zoomLevel) rotate(@(_rotation)deg);">
                        <img src="@CurrentChequeImageUrl" alt="Cheque Image" class="cheque-img" />
                    </div>
                </div>
            </div>
        </div>

        @* ----------------------------------------
           MIDDLE COLUMN: BATCH INSTRUMENT LIST & SCANNER CONTROLS
           ---------------------------------------- *@
        <div class="scanning-col mid-col">
            @* Batch Instrument List *@
            <div class="demo-card instrument-list-card">
                <div class="panel-header-title">Batch Instrument List</div>
                <div class="table-container">
                    <table class="demo-table">
                        <thead>
                            <tr>
                                <th>SEQ</th>
                                <th>CHEQUE NO</th>
                                <th>ROUTING NO</th>
                                <th>AMOUNT</th>
                                <th>STATUS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_drafts.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="empty-cell">
                                        <div class="empty-state">
                                            <div class="empty-icon">📄</div>
                                            <div class="empty-text-bold">No records found</div>
                                            <div class="empty-text-sub">Adjust filters or run the relevant demo service to create work items.</div>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @for (int i = 0; i < _drafts.Count; i++)
                                {
                                    var idx = i;
                                    var item = _drafts[i];
                                    var isSel = idx == _selectedIndex;
                                    <tr class="@(isSel ? "row-selected" : "")" @onclick="() => _selectedIndex = idx">
                                        <td>@(idx + 1)</td>
                                        <td class="font-bold">@item.ChequeNo</td>
                                        <td>@item.MicrRoutingNumber</td>
                                        <td>@(string.IsNullOrEmpty(item.Amount) ? "0" : Convert.ToInt64(item.Amount).ToString("N0"))</td>
                                        <td>
                                            <span class="table-status-pill @(item.Discard ? "status-discard" : "status-scanned")">
                                                @(item.Discard ? "Discarded" : "Scanned")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @* Scanner Batch Controls *@
            <div class="demo-card scanner-controls-card">
                <div class="panel-header-title">Scanner Batch Controls</div>
                <div class="form-group-item">
                    <label class="form-field-label">SCANNER</label>
                    <select class="demo-form-input" @bind="_selectedScanner">
                        <option value="FB 30 U">FB 30 U</option>
                    </select>
                </div>
                <div class="form-group-item">
                    <label class="form-field-label">SAVED BATCHES</label>
                    <select class="demo-form-input" value="@_selectedSavedBatch" @onchange="OnSavedBatchChange">
                        <option value="OUT-0601-01">OUT-0601-01</option>
                        <option value="OUT-0601-02">OUT-0601-02</option>
                    </select>
                </div>
                <div class="form-group-item">
                    <label class="form-field-label">PRESENTING BRANCH</label>
                    <input class="demo-form-input" disabled value="@_branchName" />
                </div>
                <div class="form-group-item">
                    <label class="form-field-label">CLEARING CYCLE</label>
                    <input class="demo-form-input" disabled value="1" />
                </div>
            </div>
        </div>

        @* ----------------------------------------
           RIGHT COLUMN: FORM PANELS
           ---------------------------------------- *@
        <div class="scanning-col right-col">
            @* Credit Account Panel *@
            <div class="demo-card form-section-card">
                <div class="panel-header-title">Credit Account</div>
                <div class="form-group-item">
                    <label class="form-field-label">ACCOUNT NO.</label>
                    <input class="demo-form-input" value="@(Selected?.AccountNo ?? "")" @oninput="OnAccountNoInput" placeholder="Enter 15 digits" />
                </div>
                <div class="form-group-item">
                    <button class="btn-fetch-account" disabled="@(Selected == null)" @onclick="FetchAccount">
                        Fetch Account
                    </button>
                </div>
                <div class="form-group-item">
                    <label class="form-field-label">ACCOUNT STATUS</label>
                    <input class="demo-form-input" disabled value="@(Selected?.Account?.Status ?? "")" />
                </div>
                <div class="form-group-item">
                    <label class="form-field-label">CUSTOMER ID</label>
                    <input class="demo-form-input" disabled value="@(Selected?.Account?.Id ?? "")" />
                </div>
                <div class="form-group-item">
                    <label class="form-field-label">ACCOUNT BRANCH</label>
                    <input class="demo-form-input" disabled value="@(Selected?.Account?.BranchName ?? "")" />
                </div>
                <div class="form-group-item">
                    <label class="form-field-label">ACCOUNT NAME</label>
                    <input class="demo-form-input" disabled value="@(Selected?.Account?.CustomerName ?? "")" />
                </div>
            </div>

            @* MICR Details Panel *@
            <div class="demo-card form-section-card">
                <div class="panel-header-title">MICR Details</div>
                <div class="form-group-item">
                    <label class="form-field-label">CHEQUE NO.</label>
                    <input class="demo-form-input" value="@(Selected?.ChequeNo ?? "")" @oninput='e => UpdateSelectedField("ChequeNo", e.Value?.ToString() ?? "")' />
                </div>
                <div class="form-group-item">
                    <label class="form-field-label">MICR ACCOUNT NO.</label>
                    <input class="demo-form-input" value="@(Selected?.MicrAccountNo ?? "")" @oninput='e => UpdateSelectedField("MicrAccountNo", e.Value?.ToString() ?? "")' />
                </div>
                <div class="form-group-item">
                    <label class="form-field-label">ROUTING NUMBER</label>
                    <input class="demo-form-input" value="@(Selected?.MicrRoutingNumber ?? "")" @oninput='e => UpdateSelectedField("MicrRoutingNumber", e.Value?.ToString() ?? "")' />
                </div>
                <div class="form-group-item">
                    <label class="form-field-label">BANK NAME</label>
                    <input class="demo-form-input" disabled value="@(Selected?.BankName ?? "")" />
                </div>
                <div class="form-group-item">
                    <label class="form-field-label">CHEQUE TYPE</label>
                    <input class="demo-form-input" value="@(Selected?.ChequeType ?? "Current Dated Normal")" @oninput='e => UpdateSelectedField("ChequeType", e.Value?.ToString() ?? "")' />
                </div>
                <div class="form-group-item">
                    <label class="form-field-label">CHECK DIGIT</label>
                    <input class="demo-form-input" value="@(Selected?.CheckDigit ?? "")" @oninput='e => UpdateSelectedField("CheckDigit", e.Value?.ToString() ?? "")' />
                </div>
            </div>

            @* Cheque Amount & Date Panel *@
            <div class="demo-card form-section-card">
                <div class="panel-header-title">Cheque Amount & Date</div>
                <div class="form-group-item">
                    <label class="form-field-label">AMOUNT</label>
                    <input class="demo-form-input" value="@(Selected?.Amount ?? "")" @oninput='e => UpdateSelectedField("Amount", Digits(e.Value?.ToString() ?? ""))' />
                </div>
                <div class="form-group-item">
                    <label class="form-field-label">CHEQUE DATE</label>
                    <input class="demo-form-input" type="date" value="@(Selected?.ChequeDate ?? DateTime.Today.ToString("yyyy-MM-dd"))" @oninput='e => UpdateSelectedField("ChequeDate", e.Value?.ToString() ?? "")' />
                </div>
                <div class="form-group-item">
                    <label class="form-field-label">DRAWER NAME</label>
                    <input class="demo-form-input" value="@(Selected?.DrawerName ?? "")" @oninput='e => UpdateSelectedField("DrawerName", e.Value?.ToString() ?? "")' />
                </div>
            </div>

            @* Batch Summary Panel *@
            <div class="demo-card form-section-card">
                <div class="panel-header-title">Batch Summary</div>
                <div class="form-group-item">
                    <label class="form-field-label">BATCH ID</label>
                    <input class="demo-form-input" disabled value="@(_currentBatch?.Id ?? "")" />
                </div>
                <div class="form-group-item">
                    <label class="form-field-label">BATCH TYPE</label>
                    <input class="demo-form-input" disabled value="CDC" />
                </div>
                <div class="form-group-item">
                    <label class="form-field-label">BATCH AMOUNT</label>
                    <input class="demo-form-input" value="@_batchAmountInput" @oninput="OnBatchAmountInput" />
                </div>
                <div class="form-group-item">
                    <label class="form-field-label">CALCULATED AMOUNT</label>
                    <input class="demo-form-input" disabled value="@CalculatedAmount" />
                </div>
                <div class="form-group-item">
                    <label class="form-field-label">TOTAL CHEQUES</label>
                    <input class="demo-form-input" disabled value="@_drafts.Count" />
                </div>
            </div>

            @* Remarks / Discard Panel *@
            <div class="demo-card form-section-card">
                <div class="panel-header-title">Remarks / Discard</div>
                <div class="form-group-item">
                    <label class="form-field-label">REMARKS</label>
                    <input class="demo-form-input" value="@(Selected?.Remarks ?? "")" @oninput='e => UpdateSelectedField("Remarks", e.Value?.ToString() ?? "")' />
                </div>
                <div class="checkbox-container">
                    <label class="checkbox-label">
                        <input type="checkbox" checked="@(Selected?.Discard ?? false)" disabled="@(Selected == null)" @onchange="OnDiscardToggle" />
                        <span>Discard Cheque</span>
                    </label>
                </div>
            </div>
        </div>
    </div>

    @* ==========================================
       BOTTOM STICKY ACTION BAR
       ========================================== *@
    <div class="demo-action-bar-bottom">
        <div class="demo-action-bar-inner">
            <button class="demo-action-btn btn-primary-dark" @onclick="() => _showNewBatchModal = true">
                📄 New Batch
            </button>
            <button class="demo-action-btn btn-secondary" @onclick="OpenSavedBatch">
                📁 Open Batch
            </button>
            @if (_isPaperWaitingInTrack)
            {
                <button class="demo-action-btn btn-primary" style="background:#16a34a; border-color:#16a34a; color:#fff;" @onclick="EjectAndPrint">
                    🖨 Eject &amp; Print
                </button>
                <button class="demo-action-btn btn-secondary" @onclick="EjectWithoutPrint">
                    ⏏ Eject Clean
                </button>
            }
            else
            {
                <button class="demo-action-btn btn-primary-dark" @onclick="ScanSingleCheque">
                    ⛶ Feed Single Cheque
                </button>
            }
            <button class="demo-action-btn btn-secondary" @onclick="SaveDraft">
                💾 Save
            </button>
            <button class="demo-action-btn btn-primary-dark" @onclick="SubmitBatch">
                ✔ Submit Batch
            </button>
            <button class="demo-action-btn btn-danger" @onclick="DiscardBatch">
                🗑 Discard Batch
            </button>
            <button class="demo-action-btn btn-secondary" @onclick="ExitScanning">
                ✕ Exit
            </button>
        </div>
    </div>
</div>

@* ==========================================
   MODAL: NEW BATCH SETUP (3-STEP WIZARD)
   ========================================== *@
@if (_showNewBatchModal)
{
    <div class="demo-modal-overlay">
        <div class="demo-modal-content">
            <div class="demo-modal-header">
                <div class="demo-modal-title">New Batch Setup</div>
                <div class="demo-modal-steps">
                    <div class="demo-step @(_newBatchStep == 1 ? "step-active" : "")">Step 1: Batch Information</div>
                    <div class="demo-step @(_newBatchStep == 2 ? "step-active" : "")">Step 2: Scanner Options</div>
                    <div class="demo-step @(_newBatchStep == 3 ? "step-active" : "")">Step 3: Confirmation</div>
                </div>
            </div>
            <div class="demo-modal-body">
                @if (_newBatchStep == 1)
                {
                    <div class="modal-grid-2col">
                        <div class="form-group-item">
                            <label class="form-field-label">Presenting Bank</label>
                            <input class="demo-form-input" disabled value="ACE Demo Bank" />
                        </div>
                        <div class="form-group-item">
                            <label class="form-field-label">Presenting Branch</label>
                            <input class="demo-form-input" disabled value="@_branchName" />
                        </div>
                        <div class="form-group-item">
                            <label class="form-field-label">Batch Type</label>
                            <input class="demo-form-input" value="CDC" />
                        </div>
                        <div class="form-group-item">
                            <label class="form-field-label">Scan Date</label>
                            <input class="demo-form-input" disabled value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="form-group-item">
                            <label class="form-field-label">Clearing Cycle</label>
                            <input class="demo-form-input" value="1" />
                        </div>
                    </div>
                }
                else if (_newBatchStep == 2)
                {
                    <div class="scanner-options-box">
                        <div class="text-sm-bold">Scanner Options</div>
                        <p class="text-xs-dim">Configure capture options for this outward batch.</p>
                        <label class="checkbox-row">
                            <input type="checkbox" checked="@_enableEndorsement" @onchange="e => _enableEndorsement = (bool)(e.Value ?? false)" />
                            <span>Enable Endorsement</span>
                        </label>
                        <label class="checkbox-row">
                            <input type="checkbox" checked disabled />
                            <span>Scanner UV Enabled</span>
                        </label>
                    </div>
                }
                else if (_newBatchStep == 3)
                {
                    <div class="confirmation-box">
                        <div class="text-sm-bold">Ready to create batch</div>
                        <div class="summary-dl">
                            <div><span class="dl-label">Presenting Bank:</span> <strong>ACE Demo Bank</strong></div>
                            <div><span class="dl-label">Presenting Branch:</span> <strong>@_branchName</strong></div>
                            <div><span class="dl-label">Batch Type:</span> <strong>CDC</strong></div>
                            <div><span class="dl-label">Scan Date:</span> <strong>@DateTime.Today.ToString("yyyy-MM-dd")</strong></div>
                            <div><span class="dl-label">Clearing Cycle:</span> <strong>1</strong></div>
                            <div><span class="dl-label">Scanner UV Enabled:</span> <strong>Yes</strong></div>
                        </div>
                    </div>
                }
            </div>
            <div class="demo-modal-footer">
                <button class="demo-action-btn btn-secondary" @onclick="() => { _showNewBatchModal = false; _newBatchStep = 1; }">
                    Close
                </button>
                @if (_newBatchStep > 1)
                {
                    <button class="demo-action-btn btn-secondary" @onclick="() => _newBatchStep--">Back</button>
                }
                @if (_newBatchStep < 3)
                {
                    <button class="demo-action-btn btn-primary-dark" @onclick="() => _newBatchStep++">Next</button>
                }
                else
                {
                    <button class="demo-action-btn btn-primary-dark" @onclick="ConfirmCreateBatch">OK</button>
                }
            </div>
        </div>
    </div>
}

@* ==========================================
   MODAL: IMAGE QUALITY REVIEW (IQA)
   ========================================== *@
@if (_showIqaModal && _iqaIndex.HasValue && _drafts.Count > _iqaIndex.Value)
{
    var item = _drafts[_iqaIndex.Value];
    <div class="demo-modal-overlay">
        <div class="demo-modal-content max-w-5xl">
            <div class="demo-modal-header iqa-header">
                <div class="demo-modal-title text-danger">⚠️ Image Quality Review</div>
                <div class="text-xs-dim uppercase">Review IQA exceptions before batch submit</div>
            </div>
            <div class="iqa-body-grid">
                <div class="iqa-image-box">
                    <img src="@GetChequeImageUrl(item, "Front B&W")" alt="IQA Flagged Cheque" class="cheque-img" />
                </div>
                <div class="iqa-checks-box">
                    <div class="text-sm-bold">Failed IQA Reasons</div>
                    <div class="iqa-tags-wrap">
                        @foreach (var reason in item.ImageQualityFlags)
                        {
                            <span class="iqa-tag">@reason</span>
                        }
                    </div>
                    <div class="text-sm-bold" style="margin-top: 12px;">All review checks</div>
                    <div class="iqa-checks-list">
                        @foreach (var reason in _allIqaReasons)
                        {
                            <label class="checkbox-row-sm">
                                <input type="checkbox" checked="@item.ImageQualityFlags.Contains(reason)" @onchange="() => ToggleIqaFlag(item, reason)" />
                                <span>@reason</span>
                            </label>
                        }
                    </div>
                    <div class="form-group-item" style="margin-top: 12px;">
                        <label class="form-field-label">Discard Remarks</label>
                        <input class="demo-form-input" @bind="_iqaDiscardRemarks" placeholder="Enter reason if discarding..." />
                    </div>
                </div>
            </div>
            <div class="demo-modal-footer">
                <button class="demo-action-btn btn-secondary" @onclick="IqaRescan">⟳ Rescan</button>
                <button class="demo-action-btn btn-primary-dark" @onclick="IqaAccept">Accept Image</button>
                <button class="demo-action-btn btn-danger" @onclick="IqaDiscard">Discard Cheque</button>
            </div>
        </div>
    </div>
}

