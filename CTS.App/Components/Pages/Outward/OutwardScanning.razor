    private void ResetZoom() { _zoomLevel = 1.0; _rotation = 0; }

    private void PrevCheque()
    {
        if (_selectedIndex > 0) _selectedIndex--;
    }

    private void NextCheque()
    {
        if (_selectedIndex < _drafts.Count - 1) _selectedIndex++;
    }

    private string Digits(string input) => new string(input.Where(char.IsDigit).ToArray());

    private void OnAccountNoInput(ChangeEventArgs e)
    {
        if (Selected != null)
        {
            Selected.AccountNo = Digits(e.Value?.ToString() ?? "").PadRight(15).Substring(0, Math.Min(15, Digits(e.Value?.ToString() ?? "").Length));
            Selected.AccountFetched = false;
            _validationErrors.Clear();
        }
    }

    private void UpdateSelectedField(string field, string value)
    {
        if (Selected == null) return;
        switch (field)
        {
            case "ChequeNo": Selected.ChequeNo = value; break;
            case "MicrAccountNo": Selected.MicrAccountNo = value; break;
            case "MicrRoutingNumber": Selected.MicrRoutingNumber = value; break;
            case "ChequeType": Selected.ChequeType = value; break;
            case "CheckDigit": Selected.CheckDigit = value; break;
            case "Amount": Selected.Amount = value; break;
            case "ChequeDate": Selected.ChequeDate = value; break;
            case "DrawerName": Selected.DrawerName = value; break;
            case "Remarks": Selected.Remarks = value; break;
        }
        _validationErrors.Clear();
    }

    private void OnBatchAmountInput(ChangeEventArgs e)
    {
        _batchAmountInput = Digits(e.Value?.ToString() ?? "");
        _validationErrors.Clear();
    }

    private void OnDiscardToggle(ChangeEventArgs e)
    {
        if (Selected != null)
        {
            Selected.Discard = (bool)(e.Value ?? false);
            _validationErrors.Clear();
        }
    }

    private void FetchAccount()
    {
        if (Selected == null) return;
        var cleanAcc = Digits(Selected.AccountNo);
        var match = _accounts.FirstOrDefault(a => a.AccountNo == cleanAcc) ?? _accounts.First();
        
        Selected.Account = match;
        Selected.AccountNo = match.AccountNo;
        Selected.MicrAccountNo = match.AccountNo;
        Selected.AccountFetched = true;
        _message = "";
        StateHasChanged();
    }

    private void ConfirmCreateBatch()
    {
        var serial = DateTime.Now.ToString("HHmmss");
        var batchNo = $"OUT-{DateTime.Today:MMdd}-01";
        var id = $"BATCH-OUT-HO-{DateTime.Today:yyyyMMdd}-{serial}";

        _currentBatch = new BatchModel
        {
            Id = id,
            BatchNo = batchNo,
            BranchName = _branchName,
            ItemCount = 0,
            TotalAmount = 0
        };
        _drafts.Clear();
        _batchAmountInput = "0";
        _showNewBatchModal = false;
        _newBatchStep = 1;
        _message = "";
        _success = $"Batch {_currentBatch.BatchNo} created successfully.";
    }

    private async Task ScanSingleCheque()
    {
        if (_currentBatch == null)
        {
            ConfirmCreateBatch();
        }

        try
        {
            using var client = HttpClientFactory.CreateClient();
            client.Timeout = TimeSpan.FromSeconds(15);

            var req = new ScanOneRequest
            {
                BatchId = _currentBatch!.BatchNo,
                BranchCode = "001",
                LowSpeedMode = false,
                EnableUv = true,
                ResolutionDpi = 200
            };

            var httpResp = await client.PostAsJsonAsync("http://localhost:18080/api/scanner/feed-single", req);
            if (httpResp.IsSuccessStatusCode)
            {
                var scanResult = await httpResp.Content.ReadFromJsonAsync<Result<ScanOneResponse>>();
                if (scanResult != null && scanResult.IsSuccess && scanResult.Data?.Cheque != null)
                {
                    var sc = scanResult.Data.Cheque;
                    var seq = _drafts.Count + 1;
                    var acc = _accounts[(seq - 1) % _accounts.Count];

                    _pausedCheque = new DraftCheque
                    {
                        Id = $"SCAN-{_currentBatch!.BatchNo}-{seq}",
                        ChequeNo = sc.ChequeNumber,
                        AccountNo = acc.AccountNo,
                        MicrAccountNo = sc.MicrAccount,
                        MicrRoutingNumber = sc.RoutingNumber,
                        BankName = "Kanbawza Bank (KBZ)",
                        ChequeType = "Current Dated Normal",
                        CheckDigit = sc.CheckDigit,
                        Amount = "1500000",
                        ChequeDate = DateTime.Today.ToString("yyyy-MM-dd"),
                        DrawerName = $"Drawer {seq}",
                        Remarks = "",
                        Discard = false,
                        Uic = $"UIC{DateTime.Today:yyyyMMdd}HOFB30U{seq:D4}",
                        AccountFetched = true,
                        Account = acc,
                        FrontImageBase64 = sc.FrontImageBase64,
                        RearImageBase64 = sc.RearImageBase64,
                        UvImageBase64 = sc.UvImageBase64,
                        IsWaitingEjection = true,
                        ImageQualityFlags = sc.IqaPassed ? new List<string>() : new List<string> { sc.IqaDetails ?? "IQA Warning" }
                    };

                    _isPaperWaitingInTrack = true;
                    _message = "Cheque fed and scanned. Paper paused in track waiting for ejection decision.";
                    _success = $"Cheque No. {sc.ChequeNumber} captured in track ({scanResult.Data.Mode}). Please choose Eject action.";
                    _validationErrors.Clear();
                    StateHasChanged();
                    return;
                }
                else if (scanResult != null && scanResult.IsFailure)
                {
                    _message = scanResult.Message ?? "Scanner hardware error occurred.";
                    _validationErrors.Clear();
                    _validationErrors.Add($"Scanner Alert: {_message}");
                    StateHasChanged();
                    return;
                }
            }
        }
        catch
        {
            // Fallback standalone simulation
        }

        ScanSingleChequeFallback();
    }

    private void ScanSingleChequeFallback()
    {
        var seq = _drafts.Count + 1;
        var acc = _accounts[(seq - 1) % _accounts.Count];
        var sampleCheques = new[] { "900421", "900422", "900423" };

        _pausedCheque = new DraftCheque
        {
            Id = $"SCAN-{_currentBatch!.BatchNo}-{seq}",
            ChequeNo = sampleCheques[(seq - 1) % sampleCheques.Length],
            AccountNo = acc.AccountNo,
            MicrAccountNo = acc.AccountNo,
            MicrRoutingNumber = "100001001",
            BankName = "Kanbawza Bank (KBZ)",
            ChequeType = "Current Dated Normal",
            CheckDigit = "0",
            Amount = "1250000",
            ChequeDate = DateTime.Today.ToString("yyyy-MM-dd"),
            DrawerName = $"Demo Drawer {seq}",
            Remarks = "",
            Discard = false,
            Uic = $"UIC{DateTime.Today:yyyyMMdd}HOFB30U{seq:D4}",
            AccountFetched = true,
            Account = acc,
            IsWaitingEjection = true,
            ImageQualityFlags = new List<string>()
        };

        _isPaperWaitingInTrack = true;
        _message = "Cheque fed and scanned. Paper paused in track waiting for ejection decision.";
        _success = $"Cheque No. {_pausedCheque.ChequeNo} captured in track (Offline Standby).";
        _validationErrors.Clear();
    }

    private async Task EjectAndPrint() => await EjectCurrentCheque(true);
    private async Task EjectWithoutPrint() => await EjectCurrentCheque(false);

    private async Task EjectCurrentCheque(bool print)
    {
        if (_pausedCheque == null) return;

        try
        {
            using var client = HttpClientFactory.CreateClient();
            client.Timeout = TimeSpan.FromSeconds(15);

            var req = new EjectChequeRequest
            {
                Pocket = 1,
                PrintEndorsement = print,
                CustomEndorsementText = $"ACE CTS * BR001 * {DateTime.Today:yyyyMMdd} * UIC:{_pausedCheque.Uic}"
            };

            var httpResp = await client.PostAsJsonAsync("http://localhost:18080/api/scanner/eject", req);
            if (httpResp.IsSuccessStatusCode)
            {
                var ejectResult = await httpResp.Content.ReadFromJsonAsync<Result<EjectChequeResponse>>();
                if (ejectResult != null && ejectResult.IsFailure)
                {
                    _validationErrors.Clear();
                    _validationErrors.Add($"Eject Alert: {ejectResult.Message}");
                    StateHasChanged();
                    return;
                }
            }
        }
        catch
        {
            // Offline fallback proceeds with local state
        }

        _pausedCheque.IsWaitingEjection = false;
        _drafts.Add(_pausedCheque);
        _isPaperWaitingInTrack = false;
        _selectedIndex = _drafts.Count - 1;
        _batchAmountInput = CalculatedAmount.ToString("0");
        _message = "";
        _success = print 
            ? $"Cheque {_pausedCheque.ChequeNo} endorsed and discharged into Pocket 1."
            : $"Cheque {_pausedCheque.ChequeNo} discharged into Pocket 1 without endorsement.";
        _pausedCheque = null;
        _validationErrors.Clear();
        StateHasChanged();
    }

