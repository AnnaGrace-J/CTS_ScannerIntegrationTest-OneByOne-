    private void SaveDraft()
    {
        if (_currentBatch == null)
        {
            _message = "No batch is currently open.";
            return;
        }
        _success = $"Batch {_currentBatch.BatchNo} draft saved successfully.";
        _message = "";
    }

    private void SubmitBatch()
    {
        _validationErrors.Clear();
        if (_currentBatch == null)
        {
            _validationErrors.Add("Create or open a batch first.");
            return;
        }
        if (_drafts.Count == 0)
        {
            _validationErrors.Add("Scan at least one cheque.");
            return;
        }

        foreach (var item in _drafts)
        {
            if (!item.AccountFetched)
                _validationErrors.Add($"Cheque {item.ChequeNo}: credit account must be fetched.");
            if (string.IsNullOrEmpty(item.Amount) || item.Amount == "0")
                _validationErrors.Add($"Cheque {item.ChequeNo}: cheque amount is required.");
        }

        if (decimal.TryParse(_batchAmountInput, out var enteredAmt))
        {
            if (enteredAmt != CalculatedAmount)
            {
                _validationErrors.Add($"Batch amount ({enteredAmt:N0}) must equal calculated amount ({CalculatedAmount:N0}).");
            }
        }
        else
        {
            _validationErrors.Add("Valid batch amount is required.");
        }

        if (_validationErrors.Count > 0)
        {
            return;
        }

        // Check for IQA exceptions
        var iqaIndex = _drafts.FindIndex(d => !d.Discard && d.ImageQualityFlags.Count > 0);
        if (iqaIndex >= 0)
        {
            _iqaIndex = iqaIndex;
            _iqaDiscardRemarks = "";
            _showIqaModal = true;
            return;
        }

        _success = $"Batch {_currentBatch.Id} validated and submitted to Outward Authorization successfully.";
        _message = "";
    }

    private void DiscardBatch()
    {
        if (_currentBatch == null) return;
        foreach (var d in _drafts)
        {
            d.Discard = true;
            d.Remarks = string.IsNullOrEmpty(d.Remarks) ? "Discarded by maker" : d.Remarks;
        }
        _success = $"Batch {_currentBatch.BatchNo} marked as discarded.";
    }

    private void ExitScanning()
    {
        Navigation.NavigateTo("/outward/dashboard");
    }

    // IQA review handlers
    private void ToggleIqaFlag(DraftCheque cheque, string reason)
    {
        if (cheque.ImageQualityFlags.Contains(reason))
            cheque.ImageQualityFlags.Remove(reason);
        else
            cheque.ImageQualityFlags.Add(reason);
    }

    private void IqaRescan()
    {
        if (_iqaIndex.HasValue && _drafts.Count > _iqaIndex.Value)
        {
            _drafts[_iqaIndex.Value].ImageQualityFlags.Clear();
            _showIqaModal = false;
            _success = "Cheque rescanned and IQA cleared. Click Submit Batch to proceed.";
        }
    }

    private void IqaAccept()
    {
        if (_iqaIndex.HasValue && _drafts.Count > _iqaIndex.Value)
        {
            _drafts[_iqaIndex.Value].ImageQualityFlags.Clear();
            _showIqaModal = false;
            _success = "Image quality accepted by maker. Click Submit Batch to complete.";
        }
    }

    private void IqaDiscard()
    {
        if (string.IsNullOrWhiteSpace(_iqaDiscardRemarks))
        {
            _message = "Remarks are required when discarding an IQA cheque.";
            return;
        }
        if (_iqaIndex.HasValue && _drafts.Count > _iqaIndex.Value)
        {
            _drafts[_iqaIndex.Value].Discard = true;
            _drafts[_iqaIndex.Value].Remarks = _iqaDiscardRemarks;
            _drafts[_iqaIndex.Value].ImageQualityFlags.Clear();
            _showIqaModal = false;
            _success = "Flagged cheque discarded.";
        }
    }
