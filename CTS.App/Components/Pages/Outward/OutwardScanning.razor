    .demo-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .demo-table th {
        background: var(--surface-secondary, #F8FAFC);
        color: var(--muted, #475569);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 8px 12px;
