    private decimal CalculatedAmount => _drafts.Where(d => !d.Discard && decimal.TryParse(d.Amount, out var a)).Sum(d => decimal.Parse(d.Amount));

    private string ValidationStatus => _validationErrors.Count > 0 ? "Issues found" : _currentBatch != null && _drafts.Count > 0 ? "Ready for review" : "Waiting for capture";

