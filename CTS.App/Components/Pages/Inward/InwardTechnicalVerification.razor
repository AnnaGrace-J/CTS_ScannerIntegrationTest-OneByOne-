@code {
    private bool _showInfo = false;
    private bool _showSummary = false;
    private bool _showFilters = false;
    private bool _showAudit = true;
    private string _activeImageTab = "front";
    private double _zoomLevel = 1.0;

    private string _filterChequeNo = "";
    private string _filterAmount = "";
    private string _filterMicrAccount = "";
    private string _filterRouting = "";
    private string _filterCustomerAccount = "";

    private string _decision = "Accept";
    private string _rejectReason = "Insufficient Funds";
    private string _remarks = "";
    private string? _message;

    private bool _showConfirmModal = false;
    private string _pendingDecision = "";

    private List<VerificationChequeModel> _cheques = new();
    private VerificationChequeModel? _selectedCheque;
    private List<AuditLogEntry> _auditEntries = new();

    protected override void OnInitialized()
    {
        _cheques = new List<VerificationChequeModel>
        {
            new()
            {
                ChequeId = "CHQ-IN-730222",
                ChequeNo = "730222",
                RoutingNo = "100000",
                MicrAccountNo = "000020090455673",
                CustomerAccountNo = "000020090455673",
                Amount = 2750000.00m,
                Status = "Scanned",
                CheckDigit = "22",
                PbDetails = "Ayeyar Demo Bank (AYDB)",
                ChequeType = "2 / PO",
                IsPo = true,
                SettlementDate = "2026-08-18",
                DrawerName = "Demo Construction",
                BranchName = "Head Office",
                Uic = "IN-20260818-000002",
                FrontImageUrl = "/placeholders/cheque-front.svg",
                BackImageUrl = "/placeholders/cheque-back.svg",
                SignatureImageUrl = "/placeholders/signature.svg"
            },
            new()
            {
                ChequeId = "CHQ-IN-120099",
                ChequeNo = "120099",
                RoutingNo = "100000",
                MicrAccountNo = "000020090455672",
                CustomerAccountNo = "000-020-090455672",
                Amount = 590000.00m,
                Status = "Scanned",
                CheckDigit = "01",
                PbDetails = "KBZ Bank (KBZB)",
                ChequeType = "1 / Normal",
                IsPo = false,
                SettlementDate = "2026-08-18",
                DrawerName = "U Tin Win & Daw Hla",
                BranchName = "Head Office",
                Uic = "IN-20260818-000001",
                FrontImageUrl = "/placeholders/cheque-front.svg",
                BackImageUrl = "/placeholders/cheque-back.svg",
                SignatureImageUrl = "/placeholders/signature.svg"
            }
        };

        _selectedCheque = _cheques.FirstOrDefault();

        _auditEntries = new List<AuditLogEntry>
        {
            new()
            {
                Timestamp = "8/18/2026, 12:12:03 PM",
                Actor = "Admin One",
                Action = "Technical Verification Accept",
                Note = "Cheque accepted after CBS/signature review."
            }
        };
    }

    private List<VerificationChequeModel> FilteredCheques => _cheques.Where(c =>
        (string.IsNullOrWhiteSpace(_filterChequeNo) || c.ChequeNo.Contains(_filterChequeNo, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_filterAmount) || c.Amount.ToString().Contains(_filterAmount)) &&
        (string.IsNullOrWhiteSpace(_filterMicrAccount) || c.MicrAccountNo.Contains(_filterMicrAccount, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_filterRouting) || c.RoutingNo.Contains(_filterRouting, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_filterCustomerAccount) || c.CustomerAccountNo.Contains(_filterCustomerAccount, StringComparison.OrdinalIgnoreCase))
    ).ToList();

    private void SelectCheque(VerificationChequeModel chk)
    {
        _selectedCheque = chk;
        _decision = "Accept";
        _message = null;
        _activeImageTab = "front";
        _zoomLevel = 1.0;
    }

    private void RunCutoffCheck()
    {
        _message = "Cutoff check executed: Inward clearing window is active (Within SLA).";
    }

    private void PromptDecision(string dec)
    {
        _pendingDecision = dec;
        _decision = dec;
        if (dec != "Accept" && (string.IsNullOrWhiteSpace(_rejectReason) || string.IsNullOrWhiteSpace(_remarks)))
        {
            _message = $"{dec} decision requires reason and remarks before proceeding.";
            return;
        }

        _showConfirmModal = true;
    }

    private void PromptExit()
    {
        _pendingDecision = "Exit";
        _showConfirmModal = true;
    }

    private string GetConfirmMessage()
    {
        if (_pendingDecision == "Exit")
            return "Exit technical verification and return to the inward dashboard?";

        if (_pendingDecision == "Accept")
            return $"Accept cheque {_selectedCheque?.ChequeNo} and route it to {(_selectedCheque?.IsPo == true ? "Return ICL Creation" : "Debit Posting")}?";

        return $"{_pendingDecision} cheque {_selectedCheque?.ChequeNo} with reason \"{_rejectReason}\"?";
    }

    private void ExecuteDecision()
    {
        _showConfirmModal = false;

        if (_pendingDecision == "Exit")
        {
            Navigation.NavigateTo("/inward/dashboard");
            return;
        }

        if (_selectedCheque is not null)
        {
            var chk = _selectedCheque;
            _auditEntries.Insert(0, new AuditLogEntry
            {
                Timestamp = $"{DateTime.Now:M/d/yyyy, h:mm:ss tt}",
                Actor = "Admin One",
                Action = $"Technical Verification {_pendingDecision}",
                Note = _pendingDecision == "Accept"
                    ? $"Cheque {chk.ChequeNo} accepted after CBS/signature review."
                    : $"Cheque {chk.ChequeNo} marked as {_pendingDecision} ({_rejectReason}: {_remarks})."
            });

            _cheques.Remove(chk);
            _selectedCheque = FilteredCheques.FirstOrDefault();
            _message = $"Cheque {chk.ChequeNo} processed successfully ({_pendingDecision}).";
            _decision = "Accept";
            _remarks = "";
        }
    }

    public sealed class VerificationChequeModel
    {
        public string ChequeId { get; set; } = string.Empty;
        public string ChequeNo { get; set; } = string.Empty;
        public string RoutingNo { get; set; } = string.Empty;
