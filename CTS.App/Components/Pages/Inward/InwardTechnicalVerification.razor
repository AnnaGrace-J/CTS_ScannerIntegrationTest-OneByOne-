@page "/inward/technical-verification"
@attribute [Authorize]
@inject WorkspaceApiService Client
@inject NavigationManager Navigation

<PageTitle>Technical Verification · ACE CTS</PageTitle>

<div class="tech-ver-root">
    @* TOP WORKSPACE SUBHEADER *@
    <div class="tech-top-bar">
        <div class="tech-top-left">
            <div class="tech-brand-title">ACE CTS Workspace</div>
            <div class="tech-brand-meta">
                <span><span class="meta-icon">🗓</span> Business date 2026-06-23</span>
                <span><span class="meta-icon">🏛</span> Head Office</span>
                <span>Role: ADMIN</span>
            </div>
        </div>
        <div class="tech-top-right">
            <span class="tech-badge-audit">Audit events: @(_auditEntries.Count > 0 ? _auditEntries.Count : 51)</span>
            <span class="tech-badge-user">admin1</span>
        </div>
    </div>

    @* HEADER CARD WITH PILLS & ACTIONS *@
    <div class="tech-card tech-header-card">
        <div class="tech-header-left">
            <h1 class="tech-header-title">Technical Verification</h1>
            <span class="tech-chip chip-sla">Within SLA</span>
            <span class="tech-chip chip-cyan">BRANCH <strong>Head Office</strong></span>
            <span class="tech-chip chip-blue">ROLE <strong>ADMIN</strong></span>
            <span class="tech-chip chip-blue">DATE <strong>2026-09-14</strong></span>
        </div>
        <div class="tech-header-right">
            <button type="button" class="tech-btn-outline" @onclick="RunCutoffCheck">
                Run Cutoff Check
            </button>
            <button type="button" class="tech-btn-outline" @onclick="() => _showInfo = !_showInfo">
                <span class="btn-icon">👁</span> @(_showInfo ? "Hide Info" : "Show Info")
            </button>
        </div>
    </div>

    @if (_showInfo)
    {
        <div class="tech-card tech-info-drawer">
            <div class="tech-info-grid">
                <div>
                    <span class="info-label">Queue Items</span>
                    <strong class="info-val">@FilteredCheques.Count item(s) awaiting verification</strong>
                </div>
                <div>
                    <span class="info-label">Selected Cheque</span>
                    <strong class="info-val font-mono">@(_selectedCheque?.ChequeNo ?? "None")</strong>
                </div>
                <div>
                    <span class="info-label">Inward Cutoff</span>
                    <strong class="info-val">14:00 MMT (Session 1)</strong>
                </div>
                <div>
                    <span class="info-label">CBS Mock Mode</span>
                    <strong class="info-val">Account fetched (Mock Active)</strong>
                </div>
            </div>
        </div>
    }

    @* SUMMARY STATS STRIP CARD *@
    <div class="tech-card tech-summary-strip">
        <div class="summary-pills-left">
            <span class="tech-pill pill-blue">
                <span class="pill-label">PENDING VERIFICATION</span>
                <span class="pill-val">@FilteredCheques.Count</span>
            </span>
            <span class="tech-pill pill-amber">
                <span class="pill-label">REFERRED CANDIDATES</span>
                <span class="pill-val">0</span>
            </span>
            <span class="tech-pill pill-danger">
                <span class="pill-label">REJECTED CANDIDATES</span>
                <span class="pill-val">1</span>
            </span>
            <span class="tech-pill pill-green">
                <span class="pill-label">CUTOFF RISK</span>
                <span class="pill-val">Within SLA</span>
            </span>
        </div>
        <div class="summary-btn-right">
            <button type="button" class="tech-btn-outline-sm" @onclick="() => _showSummary = !_showSummary">
                <span class="btn-icon">👁</span> @(_showSummary ? "Hide Summary" : "Show Summary")
            </button>
        </div>
    </div>

    @if (_showSummary)
    {
        <div class="tech-card tech-summary-drawer">
            <div class="metrics-grid">
                <div class="metric-box">
                    <span class="m-label">Pending Verification</span>
                    <strong class="m-val text-blue">@FilteredCheques.Count</strong>
                </div>
                <div class="metric-box">
                    <span class="m-label">Referred Candidates</span>
                    <strong class="m-val text-amber">0</strong>
                </div>
                <div class="metric-box">
                    <span class="m-label">Rejected Candidates</span>
                    <strong class="m-val text-danger">1</strong>
                </div>
                <div class="metric-box">
                    <span class="m-label">Cutoff Time</span>
                    <strong class="m-val text-green">14:00 MMT (Within SLA)</strong>
                </div>
            </div>
        </div>
    }

    @* PO EXCEPTION BANNER (WHEN PO CHEQUE IS ACTIVE) *@
    @if (_selectedCheque?.ChequeType == "2 / PO" || _selectedCheque?.IsPo == true)
    {
        <div class="tech-banner banner-amber">
            <span class="banner-icon">⚠</span>
            <span>PO-specific handling: balance and signature specimen are hidden; an accepted PO routes to Return ICL Creation.</span>
        </div>
    }

    @* VALIDATION / NOTICE MESSAGE BANNER *@
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="tech-banner banner-info">
            <span class="banner-icon">ℹ</span>
            <span>@_message</span>
        </div>
    }

    @* TECHNICAL VERIFICATION FILTERS CARD *@
    <div class="tech-card tech-filter-panel">
        <div class="filter-panel-head">
            <div>
                <h2 class="filter-panel-title">Technical Verification Filters</h2>
                <span class="filter-panel-count">@FilteredCheques.Count matching record(s)</span>
            </div>
            <button type="button" class="tech-btn-outline-sm" @onclick="() => _showFilters = !_showFilters">
                <span class="btn-icon">@(_showFilters ? "⌃" : "⌄")</span> @(_showFilters ? "Hide Filters" : "Show Filters")
            </button>
        </div>

        @if (_showFilters)
        {
            <div class="filter-inputs-grid">
                <div class="filter-input-col">
                    <label class="filter-label">Cheque No.</label>
                    <input type="text" class="filter-text-input" placeholder="Search cheque no..." @bind="_filterChequeNo" @bind:event="oninput" />
                </div>
                <div class="filter-input-col">
                    <label class="filter-label">Amount</label>
                    <input type="text" class="filter-text-input" placeholder="Search amount..." @bind="_filterAmount" @bind:event="oninput" />
                </div>
                <div class="filter-input-col">
                    <label class="filter-label">MICR A/c No.</label>
                    <input type="text" class="filter-text-input" placeholder="Search MICR a/c..." @bind="_filterMicrAccount" @bind:event="oninput" />
                </div>
                <div class="filter-input-col">
                    <label class="filter-label">Routing No.</label>
                    <input type="text" class="filter-text-input" placeholder="Search routing no..." @bind="_filterRouting" @bind:event="oninput" />
                </div>
                <div class="filter-input-col">
                    <label class="filter-label">Customer A/c No.</label>
                    <input type="text" class="filter-text-input" placeholder="Search customer a/c..." @bind="_filterCustomerAccount" @bind:event="oninput" />
                </div>
            </div>
        }
    </div>

    @* TECHNICAL VERIFICATION QUEUE TABLE CARD *@
    <div class="tech-card tech-table-card">
        <div class="table-card-head">
            <h2 class="table-card-title">Technical Verification Queue</h2>
        </div>
        <div class="table-scroll-wrap">
            <table class="tech-data-table">
                <thead>
                    <tr>
                        <th>CHEQUE NUMBER</th>
                        <th>ROUTING NUMBER</th>
                        <th>MICR ACCOUNT NUMBER</th>
                        <th>AMOUNT</th>
                        <th>CUSTOMER A/C NO.</th>
                        <th>STATUS</th>
                        <th style="width: 40px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (FilteredCheques.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="table-empty-cell">
                                <div class="empty-state-box">
                                    <span class="empty-icon">📄</span>
                                    <strong class="empty-title">No matching records found</strong>
                                    <p class="empty-desc">Adjust search filters to view inward cheques awaiting technical verification.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var chk in FilteredCheques)
                        {
                            var isSelected = _selectedCheque?.ChequeId == chk.ChequeId;
                            <tr class="table-row-clickable @(isSelected ? "row-selected" : null)" @onclick="() => SelectCheque(chk)">
                                <td class="font-mono font-bold text-blue">@chk.ChequeNo</td>
                                <td class="font-mono">@chk.RoutingNo</td>
                                <td class="font-mono">@chk.MicrAccountNo</td>
                                <td class="font-bold">@chk.Amount.ToString("N2")</td>
                                <td class="font-mono">@chk.CustomerAccountNo</td>
                                <td>
                                    <span class="status-chip chip-scanned">@chk.Status</span>
                                </td>
                                <td class="text-right">
                                    <span class="chevron-indicator">›</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (_selectedCheque is not null)
    {
        @* TWO-COLUMN WORKSPACE GRID *@
        <div class="tech-workspace-grid">
            @* LEFT COLUMN: CHEQUE IMAGE REVIEW & DECISION PANEL *@
            <div class="tech-col-left">
                <!-- Cheque Image Review Card -->
                <div class="tech-card tech-viewer-card">
                    <div class="viewer-head-row">
                        <div class="viewer-head-left">
                            <h3 class="viewer-title">Cheque Image Review</h3>
                            <span class="viewer-subtitle">Cheque @_selectedCheque.ChequeNo | UIC: @_selectedCheque.Uic</span>
                        </div>
                    </div>
                    <div class="viewer-chips-row">
                        <span class="status-chip chip-scanned">Scanned</span>
                        <span class="status-chip chip-routing">Routing @_selectedCheque.RoutingNo</span>
                    </div>
                    
                    <div class="viewer-canvas-box">
                        <div class="viewer-toolbar">
                            <div class="tab-pills">
                                <button type="button" class="tab-pill @(_activeImageTab == "front" ? "tab-active" : "")" @onclick='() => _activeImageTab = "front"'>Front Image</button>
                                <button type="button" class="tab-pill @(_activeImageTab == "rear" ? "tab-active" : "")" @onclick='() => _activeImageTab = "rear"'>Rear Image</button>
                            </div>
                            <div class="zoom-controls">
                                <button type="button" class="zoom-btn" @onclick="() => _zoomLevel = Math.Max(0.5, _zoomLevel - 0.2)">−</button>
                                <span class="zoom-text">@((int)(_zoomLevel * 100))%</span>
                                <button type="button" class="zoom-btn" @onclick="() => _zoomLevel = Math.Min(2.5, _zoomLevel + 0.2)">+</button>
                            </div>
                        </div>

                        <div class="canvas-viewport">
                            <div class="crosshair-target"></div>
                            <img src="@(_activeImageTab == "front" ? _selectedCheque.FrontImageUrl : _selectedCheque.BackImageUrl)"
                                 alt="Cheque Image"
                                 class="cheque-img-display"
                                 style="transform: scale(@_zoomLevel);" />
                        </div>
                    </div>
                </div>

                <!-- Decision Panel Card -->
                <div class="tech-card tech-decision-card">
                    <div class="card-section-head">
                        <h3 class="panel-section-title">Decision Panel</h3>
                    </div>

                    <!-- CHEQUE DETAILS INNER BOX -->
                    <div class="decision-group">
                        <div class="group-title">CHEQUE DETAILS</div>
                        <div class="meta-rows-list">
                            <div class="meta-row">
                                <span class="m-label">Cheque No.</span>
                                <strong class="m-val font-mono">@_selectedCheque.ChequeNo</strong>
                            </div>
                            <div class="meta-row">
                                <span class="m-label">Routing No.</span>
                                <strong class="m-val font-mono">@_selectedCheque.RoutingNo</strong>
                            </div>
                            <div class="meta-row">
                                <span class="m-label">MICR A/c No.</span>
                                <strong class="m-val font-mono">@_selectedCheque.MicrAccountNo</strong>
                            </div>
                            <div class="meta-row">
                                <span class="m-label">Check Digit</span>
                                <strong class="m-val font-mono">@_selectedCheque.CheckDigit</strong>
                            </div>
                            <div class="meta-row">
                                <span class="m-label">Amount</span>
                                <strong class="m-val font-bold font-mono">@_selectedCheque.Amount.ToString("N2")</strong>
                            </div>
                            <div class="meta-row">
                                <span class="m-label">PB Details</span>
                                <strong class="m-val">@_selectedCheque.PbDetails</strong>
                            </div>
                            <div class="meta-row">
                                <span class="m-label">Cheque Type</span>
                                <strong class="m-val">@_selectedCheque.ChequeType</strong>
                            </div>
                            <div class="meta-row">
                                <span class="m-label">Settlement Date</span>
                                <strong class="m-val font-mono">@_selectedCheque.SettlementDate</strong>
                            </div>
                        </div>
                    </div>

                    <!-- DECISION GUIDANCE INNER BOX -->
                    <div class="decision-group mt-3">
                        <div class="group-title">DECISION GUIDANCE</div>
                        <div class="meta-rows-list">
                            <div class="meta-row">
                                <span class="m-label">Selected</span>
                                <span class="status-chip chip-accepted">@_decision</span>
                            </div>
                            <div class="meta-row">
                                <span class="m-label">Accept Target</span>
                                <strong class="m-val">@(_selectedCheque.IsPo ? "Return ICL Creation" : "Debit Posting")</strong>
                            </div>
                            <div class="meta-row">
                                <span class="m-label">Reject Target</span>
                                <strong class="m-val">Return ICL Creation</strong>
                            </div>
                            <div class="meta-row">
                                <span class="m-label">Refer Target</span>
                                <strong class="m-val">Referral</strong>
                            </div>
                        </div>
                    </div>

                    @* REASON & REMARKS INPUTS WHEN NOT ACCEPTED *@
                    @if (_decision != "Accept")
                    {
                        <div class="decision-reason-box mt-3">
                            <div class="form-field mb-2">
                                <label class="field-label">Reject / Refer Reason</label>
                                <select class="filter-text-input" @bind="_rejectReason">
                                    <option value="Insufficient Funds">Insufficient Funds</option>
                                    <option value="Signature Differs / Incomplete">Signature Differs / Incomplete</option>
                                    <option value="Payment Stopped By Drawer">Payment Stopped By Drawer</option>
                                    <option value="Post-dated / Stale Cheque">Post-dated / Stale Cheque</option>
                                    <option value="Refer to Drawer">Refer to Drawer</option>
                                    <option value="Account Blocked / Frozen">Account Blocked / Frozen</option>
                                </select>
                            </div>
                            <div class="form-field">
                                <label class="field-label">Remarks</label>
                                <textarea class="filter-text-input" rows="2" placeholder="Enter decision remarks..." @bind="_remarks"></textarea>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* RIGHT COLUMN: ACCOUNT & SIGNATURE WORKSPACE *@
            <div class="tech-col-right">
                <div class="tech-card tech-account-card">
                    <div class="card-section-head">
                        <h3 class="panel-section-title">Account &amp; Signature Workspace</h3>
                    </div>

                    <!-- CBS FETCH RESULT INNER BOX -->
                    <div class="account-group">
                        <div class="group-title">CBS FETCH RESULT</div>
                        <div class="meta-rows-list">
                            <div class="meta-row">
                                <span class="m-label">Result</span>
                                <span class="status-chip chip-accepted">Account fetched</span>
                            </div>
                            <div class="meta-row">
                                <span class="m-label">Drawer A/C</span>
                                <strong class="m-val font-mono">@_selectedCheque.MicrAccountNo.Substring(Math.Max(0, _selectedCheque.MicrAccountNo.Length - 15))</strong>
                            </div>
                            <div class="meta-row">
                                <span class="m-label">Status</span>
                                <strong class="m-val font-bold text-dark-active">Active</strong>
                            </div>
                        </div>
                    </div>

                    <!-- DRAWER ACCOUNT DETAILS INNER BOX -->
                    <div class="account-group mt-3">
                        <div class="group-title">DRAWER ACCOUNT DETAILS</div>
                        <div class="meta-rows-list">
                            <div class="meta-row">
                                <span class="m-label">Name</span>
                                <strong class="m-val">@_selectedCheque.DrawerName</strong>
                            </div>
                            <div class="meta-row-divider"></div>
                            <div class="meta-row">
                                <span class="m-label">Branch</span>
                                <strong class="m-val">@_selectedCheque.BranchName</strong>
                            </div>
                        </div>
                    </div>

                    <!-- SIGNATURE SPECIMEN OR PO NOTICE INNER BOX -->
                    <div class="signature-section mt-3">
                        @if (_selectedCheque.IsPo)
                        {
                            <div class="po-warning-box">
                                PO item: signature and balance are intentionally hidden.
                            </div>
                        }
                        else
                        {
                            <div class="signature-viewer-box">
                                <div class="sig-header-row">
                                    <span class="m-label">Signature Specimen</span>
                                    <span class="sig-counter">Signature 1 of 1</span>
                                </div>
                                <div class="sig-img-wrap">
                                    <img src="@_selectedCheque.SignatureImageUrl" alt="Signature Specimen" class="sig-img" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* BOTTOM ROW (CBS NOTICE & AUDIT TIMELINE) *@
        <div class="tech-bottom-split-row">
            <!-- CBS Notice Card -->
            <div class="tech-card tech-cbs-note-card">
                <div class="cbs-note-content">
                    <span class="cbs-icon">◎</span>
                    <div class="cbs-text-wrap">
                        <strong class="cbs-title">CBS/account fetch result</strong>
                        <p class="cbs-desc">Drawer account is derived from the last 15 digits of the MICR account number. This is demo data only; no live CBS integration is used.</p>
                    </div>
                </div>
            </div>

            <!-- Audit Timeline Card -->
            <div class="tech-card tech-audit-card">
                <div class="audit-card-head">
                    <div>
                        <h3 class="audit-card-title">Audit Timeline</h3>
                        <span class="audit-card-count">@_auditEntries.Count audit event(s)</span>
                    </div>
                    <button type="button" class="tech-btn-outline-sm" @onclick="() => _showAudit = !_showAudit">
                        <span class="btn-icon">@(_showAudit ? "⌃" : "⌄")</span> @(_showAudit ? "Close Audit" : "Show Audit")
                    </button>
                </div>
                @if (_showAudit)
                {
                    <div class="audit-events-scroll">
                        @foreach (var entry in _auditEntries)
                        {
                            <div class="audit-event-item">
                                <div class="audit-meta-row">
                                    <span>@entry.Timestamp - @entry.Actor</span>
                                </div>
                                <div class="audit-action-row">
                                    <strong>@entry.Action</strong>
                                </div>
                                <div class="audit-note-row">
                                    @entry.Note
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* BOTTOM ACTION BAR (IN-PAGE CARD) *@
        <div class="tech-card tech-action-bar-card">
            <button type="button" class="tech-btn-navy" @onclick='() => PromptDecision("Accept")'>
                <span class="btn-icon">✓</span> Accept
            </button>
            <button type="button" class="tech-btn-outline" @onclick='() => PromptDecision("Reject")'>
                <span class="btn-icon">✕</span> Reject
            </button>
            <button type="button" class="tech-btn-outline" @onclick='() => PromptDecision("Refer")'>
                <span class="btn-icon">◁</span> Refer
            </button>
            <button type="button" class="tech-btn-outline" @onclick="PromptExit">
                Exit
            </button>
        </div>
    }
</div>

@* CONFIRMATION MODALS *@
<ConfirmActionModal IsOpen="@_showConfirmModal"
                    Title="@($"Confirm Technical Verification: {_pendingDecision}")"
                    Message="@GetConfirmMessage()"
                    ConfirmLabel="@(_pendingDecision == "Exit" ? "Exit" : "Confirm")"
                    CancelLabel="Cancel"
                    OnConfirm="ExecuteDecision"
                    OnCancel="() => _showConfirmModal = false" />

<style>
    .tech-ver-root {
        font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: #0f172a;
        background: #f8fafc;
        min-height: calc(100vh - 80px);
        padding: 20px 24px 40px;
        box-sizing: border-box;
    }
    .tech-ver-root * { box-sizing: border-box; }

    /* Top subhead */
    .tech-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
    }
    .tech-brand-title {
        font-size: 15px;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 3px;
    }
    .tech-brand-meta {
        font-size: 12px;
        color: #64748b;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .meta-icon { opacity: 0.85; margin-right: 3px; }
    .tech-top-right {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .tech-badge-audit {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 5px 12px;
        font-size: 12px;
        font-weight: 600;
        color: #334155;
    }
    .tech-badge-user {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 5px 12px;
        font-size: 13px;
        font-weight: 700;
        color: #0f172a;
    }

    /* Cards */
    .tech-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 14px;
        box-shadow: 0 1px 3px rgba(15, 42, 68, 0.04);
    }

    /* Header Card */
    .tech-header-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 20px;
    }
    .tech-header-left {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
    }
    .tech-header-right {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .tech-header-title {
        font-size: 16px;
        font-weight: 800;
        color: #0f172a;
        margin: 0 6px 0 0;
    }

    /* Chips */
    .tech-chip {
        display: inline-flex;
        align-items: center;
        font-size: 11px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 9999px;
        letter-spacing: 0.02em;
    }
    .chip-sla { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; font-weight: 700; }
    .chip-cyan { background: #f0fdfa; color: #0d9488; border: 1px solid #ccfbf1; }
    .chip-blue { background: #f0f9ff; color: #0284c7; border: 1px solid #e0f2fe; }
    .chip-scanned { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; font-weight: 700; }
    .chip-routing { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; font-weight: 700; }
    .chip-accepted { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; font-weight: 700; }

    /* Buttons */
    .tech-btn-outline {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 7px;
        padding: 6px 14px;
