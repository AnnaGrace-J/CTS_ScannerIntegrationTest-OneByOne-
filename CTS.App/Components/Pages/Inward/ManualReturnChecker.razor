@* // Code Added by KK *@
    <div class="demo-card demo-table-panel">
        <div class="demo-table-panel-header">
            <h3 class="demo-panel-title">Manual Return Checker Queue</h3>
            <span class="demo-panel-sub">@FilteredRows.Count record(s)</span>
        </div>
        <div class="demo-table-wrapper">
            <table class="demo-data-table queue-aligned-table">
                <thead>
                    <tr>
                        <th style="width: 16%;">CHEQUE NUMBER</th>
                        <th style="width: 16%;">AMOUNT</th>
                        <th style="width: 15%;">MAKER DECISION</th>
                        <th style="width: 18%;">REASON</th>
                        <th style="width: 15%;">REMARKS</th>
                        <th style="width: 16%;">REQUESTED TIME</th>
                        <th style="width: 4%;"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (FilteredRows.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="demo-empty-cell">
                                <div class="empty-state-box">
                                    <div class="empty-icon">📄</div>
                                    <strong class="empty-title">No records found</strong>
                                    <span class="empty-sub">Adjust filters or run the relevant demo service to create workitems.</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in FilteredRows)
                        {
                            var isSelected = SelectedCheque?.Id == row.Id;
                            <tr class="demo-clickable-row @(isSelected ? "row-selected" : "")" @onclick="() => SelectCheque(row)">
                                <td class="font-bold">@row.ChequeNo</td>
                                <td class="font-bold">@row.Amount.ToString("N2")</td>
                                <td><span class="demo-tag tag-returned">@row.MakerDecision</span></td>
                                <td>@row.Reason</td>
                                <td>@row.Remarks</td>
                                <td>@row.RequestedTime</td>
                                <td class="text-right text-muted"><span class="demo-chevron-indicator">›</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* 3-Panel Bottom Workspace when item is present/selected *@
    @if (SelectedCheque != null)
    {
        <div class="demo-3col-workspace">
            @* Column 1: Cheque Image Review *@
            <div class="demo-card demo-workspace-col">
                <div class="demo-col-header">
                    <div>
                        <h3 class="demo-panel-title">Cheque Image Review</h3>
                        <span class="demo-panel-sub">Cheque @SelectedCheque.ChequeNo | UIC @SelectedCheque.Uic</span>
                    </div>
                </div>

                <div class="demo-viewer-badge-bar">
                    <span class="demo-tag tag-returned">Return Approval</span>
                    <span class="demo-tag tag-routing">Routing @SelectedCheque.RoutingNumber</span>
                </div>

                <div class="demo-cheque-image-frame">
                    <img src="@CurrentChequeImageUrl" alt="Cheque Image" class="demo-cheque-img" />
                </div>

                <div class="demo-viewer-tabs mt-3">
                    <button class="demo-viewer-tab-btn @(_imageView == "front" ? "active" : "")" @onclick='() => _imageView = "front"'>Front</button>
                    <button class="demo-viewer-tab-btn @(_imageView == "rear" ? "active" : "")" @onclick='() => _imageView = "rear"'>Rear</button>
                </div>
            </div>

            @* Column 2: Account & Verification Details *@
            <div class="demo-card demo-workspace-col">
                <div class="demo-col-header">
                    <h3 class="demo-panel-title">Cheque / Account Summary</h3>
                </div>

                <div class="demo-field-group">
                    <div class="demo-field-group-title">DRAWER ACCOUNT</div>
                    <div class="demo-field-row">
                        <span class="field-label">Drawer A/C</span>
                        <span class="field-value font-mono font-bold">@SelectedCheque.DrawerAccount</span>
                    </div>
                    <div class="demo-field-row">
                        <span class="field-label">Name</span>
                        <span class="field-value font-bold">@SelectedCheque.AccountName</span>
                    </div>
                    <div class="demo-field-row">
                        <span class="field-label">Branch</span>
                        <span class="field-value">@SelectedCheque.Branch</span>
                    </div>
                    <div class="demo-field-row">
                        <span class="field-label">Balance</span>
                        <span class="field-value font-bold">@SelectedCheque.Balance.ToString("N2")</span>
                    </div>
                </div>

                <div class="demo-field-group mt-3">
                    <div class="demo-field-group-title">CHEQUE SUMMARY</div>
                    <div class="demo-field-row">
                        <span class="field-label">Cheque No.</span>
                        <span class="field-value">@SelectedCheque.ChequeNo</span>
                    </div>
                    <div class="demo-field-row">
                        <span class="field-label">Routing No.</span>
                        <span class="field-value font-mono">@SelectedCheque.RoutingNumber</span>
                    </div>
                    <div class="demo-field-row">
                        <span class="field-label">Amount</span>
                        <span class="field-value font-bold">@SelectedCheque.Amount.ToString("N2")</span>
                    </div>
                    <div class="demo-field-row">
                        <span class="field-label">Maker Decision</span>
                        <span class="field-value text-red font-medium">@SelectedCheque.MakerDecision</span>
                    </div>
                    <div class="demo-field-row">
                        <span class="field-label">Reason</span>
                        <span class="field-value">@SelectedCheque.Reason</span>
                    </div>
                </div>

                <div class="demo-sig-frame mt-3">
                    <img src="/placeholders/signature.svg" alt="Synthetic signature specimen" class="demo-sig-img" />
                    <span class="demo-sig-hint">Synthetic signature specimen visible for demo review.</span>
                </div>
            </div>

            @* Column 3: Checker Approval Decision Panel *@
            <div class="demo-card demo-workspace-col">
                <div class="demo-col-header">
                    <h3 class="demo-panel-title">Checker Decision Panel</h3>
                </div>

                <div class="demo-field-group">
                    <div class="demo-field-group-title">DECISION CONTEXT</div>
                    <div class="demo-field-row">
                        <span class="field-label">Approve Target</span>
                        <span class="field-value font-bold">Return ICL Creation</span>
                    </div>
                    <div class="demo-field-row">
                        <span class="field-label">Reject Target</span>
                        <span class="field-value font-bold">Debit Posting</span>
                    </div>
                    <div class="demo-field-row">
                        <span class="field-label">Cutoff Status</span>
                        <span class="field-value text-red font-medium">Cutoff passed</span>
                    </div>
                </div>

                <div class="demo-decision-form mt-3">
                    <div class="demo-field">
                        <label class="demo-label">CHECKER REMARKS</label>
                        <textarea class="demo-textarea" rows="3" placeholder="Enter checker notes (optional)..." @bind="_checkerRemarks"></textarea>
                    </div>

                    <div class="demo-decision-actions mt-4">
                        <button class="demo-action-btn btn-navy" @onclick="ApproveReturn">
                            <span>✓</span>
                            <span>Approve Return</span>
                        </button>
                        <button class="demo-action-btn btn-secondary" @onclick="RejectReturn">
                            <span>✕</span>
                            <span>Reject Decision</span>
                        </button>
                        <button class="demo-action-btn btn-secondary" @onclick='() => Navigation.NavigateTo("/inward/dashboard")'>
                            <span>Exit</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Collapsible Audit Timeline *@
    <div class="demo-card demo-pane">
        <div class="demo-pane-header">
            <div>
                <strong class="demo-panel-title">Audit Timeline</strong>
                <span class="demo-panel-sub ml-2">@_auditEvents.Count audit event(s)</span>
            </div>
            <button class="demo-link-btn" @onclick="() => _auditOpen = !_auditOpen">
                <span>@(_auditOpen ? "▲ Close Audit" : "▼ Open Audit")</span>
            </button>
        </div>
        @if (_auditOpen)
        {
            <div class="demo-audit-events-list">
                @if (_auditEvents.Count == 0)
                {
                    <div class="demo-empty-cell">0 audit event(s)</div>
                }
                else
                {
                    @foreach (var ev in _auditEvents)
                    {
                        <div class="demo-audit-item">
                            <span class="demo-audit-time">@ev.Timestamp - @ev.User</span>
                            <strong class="demo-audit-act">@ev.Action</strong>
                            <p class="demo-audit-desc">@ev.Description</p>
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>

