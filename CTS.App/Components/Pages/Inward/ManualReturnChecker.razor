@* // Code Added by KK *@
    @if (_summaryCollapsed)
    {
        <div class="demo-summary-row demo-summary-collapsed-row">
            <div class="demo-pills-wrap">
                <span class="demo-chip chip-green">QUEUE ITEMS <strong>@FilteredRows.Count</strong></span>
                <span class="demo-chip chip-blue">TOTAL AMOUNT <strong>@TotalQueueAmount.ToString("N0")</strong></span>
                <span class="demo-chip chip-passed">CUTOFF STATUS <strong>Cutoff passed</strong></span>
                <span class="demo-chip chip-blue">APPROVE TARGET <strong>Return ICL Creation</strong></span>
            </div>
            <button class="demo-ghost-btn" @onclick="() => _summaryCollapsed = false">
                <span class="demo-icon">👁</span> Show Summary
            </button>
        </div>
    }
    else
    {
        <div class="demo-summary-row">
            <div class="demo-pills-wrap">
                <div class="demo-kpi-card kpi-green">
                    <span class="kpi-label">QUEUE ITEMS</span>
                    <strong class="kpi-val">@FilteredRows.Count</strong>
                </div>
                <div class="demo-kpi-card kpi-blue">
                    <span class="kpi-label">TOTAL AMOUNT</span>
                    <strong class="kpi-val">@TotalQueueAmount.ToString("N0")</strong>
                </div>
                <div class="demo-kpi-card kpi-red">
                    <span class="kpi-label">CUTOFF STATUS</span>
                    <strong class="kpi-val">Cutoff passed</strong>
                    <small class="kpi-hint">Manual return decisions are at cutoff risk.</small>
                </div>
                <div class="demo-kpi-card kpi-blue">
                    <span class="kpi-label">APPROVE TARGET</span>
                    <strong class="kpi-val">Return ICL Creation</strong>
                </div>
            </div>
            <button class="demo-ghost-btn" @onclick="() => _summaryCollapsed = true">
                <span class="demo-icon">👁</span> Hide Summary
            </button>
        </div>
    }

    @* Alerts / Feedback *@
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="demo-alert demo-alert-danger">
            <span>@_message</span>
        </div>
    }
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="demo-alert demo-alert-success">
            <span>✓ @_successMessage</span>
        </div>
    }

    @* Manual Return Checker Filters with Working Hide/Show Filters *@
    <div class="demo-card demo-filter-panel">
        <div class="demo-filter-header">
            <div>
                <h2 class="demo-filter-title">Manual Return Checker Filters</h2>
                <span class="demo-filter-count">@FilteredRows.Count matching records</span>
            </div>
            <button class="demo-ghost-btn" @onclick="() => _filtersCollapsed = !_filtersCollapsed">
                <span>@(_filtersCollapsed ? "▼ Show Filters" : "▲ Hide Filters")</span>
            </button>
        </div>
        @if (!_filtersCollapsed)
        {
            <div class="demo-filter-grid">
                <div class="demo-field">
                    <label class="demo-label">CHEQUE NO.</label>
                    <input type="text" class="demo-input" placeholder="Search cheque no..." @bind="_filterChequeNo" @bind:event="oninput" />
                </div>
                <div class="demo-field">
                    <label class="demo-label">AMOUNT</label>
                    <input type="text" class="demo-input" placeholder="Search amount..." @bind="_filterAmount" @bind:event="oninput" />
                </div>
                <div class="demo-field">
                    <label class="demo-label">MICR A/C NO.</label>
                    <input type="text" class="demo-input" placeholder="Search MICR account..." @bind="_filterMicrAccount" @bind:event="oninput" />
                </div>
                <div class="demo-field">
                    <label class="demo-label">ROUTING NO.</label>
                    <input type="text" class="demo-input" placeholder="Search routing..." @bind="_filterRouting" @bind:event="oninput" />
                </div>
                <div class="demo-field">
                    <label class="demo-label">CUSTOMER A/C NO.</label>
                    <input type="text" class="demo-input" placeholder="Search customer account..." @bind="_filterCustomerAccount" @bind:event="oninput" />
                </div>
            </div>
        }
    </div>

