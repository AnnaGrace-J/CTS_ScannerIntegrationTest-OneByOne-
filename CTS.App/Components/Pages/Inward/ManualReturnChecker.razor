@code {
    private bool _infoCollapsed = false;
    private bool _summaryCollapsed = false;
    private bool _filtersCollapsed = false;
    private bool _auditOpen = true;

    private string _filterChequeNo = "";
    private string _filterAmount = "";
    private string _filterMicrAccount = "";
    private string _filterRouting = "";
    private string _filterCustomerAccount = "";

    private string _imageView = "front";
    private string _checkerRemarks = "";
    private string _message = "";
    private string _successMessage = "";

    private List<ReturnCheckerItem> _cheques = [];
    private string _selectedId = "";

    private ReturnCheckerItem? SelectedCheque => _cheques.FirstOrDefault(c => c.Id == _selectedId);

    private decimal TotalQueueAmount => FilteredRows.Sum(c => c.Amount);

    private string CurrentChequeImageUrl => SelectedCheque == null 
        ? "/placeholders/cheque-001.svg" 
        : (_imageView == "rear" ? "/placeholders/cheque-rear.svg" : "/placeholders/cheque-001.svg");

    private List<ReturnCheckerItem> FilteredRows => _cheques.Where(c =>
        (string.IsNullOrWhiteSpace(_filterChequeNo) || c.ChequeNo.Contains(_filterChequeNo, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_filterAmount) || c.Amount.ToString().Contains(_filterAmount, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_filterMicrAccount) || c.MicrAccountNo.Contains(_filterMicrAccount, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_filterRouting) || c.RoutingNumber.Contains(_filterRouting, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_filterCustomerAccount) || c.CustomerAccount.Contains(_filterCustomerAccount, StringComparison.OrdinalIgnoreCase))
    ).ToList();

    private List<ReturnCheckerAuditEvent> _auditEvents = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Client.QueueAsync(new("MANUAL_RETURN_CHECKER", 1, 50, null, null));
            if (result.IsSuccess && result.Data?.Items != null && result.Data.Items.Count > 0)
            {
                _cheques = result.Data.Items.Select(item => new ReturnCheckerItem
                {
                    Id = item.ChequeId,
                    ChequeNo = item.ChequeNo,
                    Amount = item.Amount,
                    MakerDecision = "Return",
                    Reason = item.RejectReason ?? "Account Closed",
                    Remarks = "Maker returned instrument",
                    RequestedTime = item.UpdatedAtUtc.ToLocalTime().ToString("M/d/yyyy, h:mm:ss tt"),
                    RoutingNumber = "100001",
                    MicrAccountNo = item.AccountNo,
                    CustomerAccount = item.AccountNo,
                    DrawerAccount = item.AccountNo,
                    AccountName = "Customer Account",
                    Branch = item.BranchCode ?? "Branch 001",
                    Balance = 2500000.00m,
                    Uic = $"20260601-AYDB-001-SCN01-0103-{item.ChequeNo}"
                }).ToList();
            }
        }
        catch { }

        // Start with empty queue as in user screenshot "No records found"
        // If an item is present, user can inspect and review it.
    }

    private void SelectCheque(ReturnCheckerItem item)
    {
        _selectedId = item.Id;
        _message = "";
        _successMessage = "";
    }

    private void RunCutoffAutoAccept()
    {
        _successMessage = "Cutoff Auto-Accept simulation ran. All pending eligible inward instruments checked.";
        _auditEvents.Insert(0, new()
        {
            Timestamp = DateTime.Now.ToString("M/d/yyyy, h:mm:ss tt"),
            User = "admin1",
            Action = "Cutoff Auto-Accept Executed",
            Description = "Manual return cutoff auto-accept cycle executed."
        });
    }

    private async Task ApproveReturn()
    {
        if (SelectedCheque == null) return;
        _message = "";
        _successMessage = "";

        try
        {
            await Client.ActionAsync(new(SelectedCheque.Id, "APPROVE_RETURN", _checkerRemarks));
        }
        catch { }

        _auditEvents.Insert(0, new()
        {
            Timestamp = DateTime.Now.ToString("M/d/yyyy, h:mm:ss tt"),
            User = "admin1",
            Action = "Return Approved",
            Description = $"Cheque {SelectedCheque.ChequeNo} return approved. Routed to Return ICL Creation."
        });

        _successMessage = $"Cheque {SelectedCheque.ChequeNo} approved for return and routed to Return ICL Creation.";
        _cheques.Remove(SelectedCheque);
        _selectedId = _cheques.FirstOrDefault()?.Id ?? "";
    }

    private async Task RejectReturn()
    {
        if (SelectedCheque == null) return;
        _message = "";
        _successMessage = "";

        try
        {
            await Client.ActionAsync(new(SelectedCheque.Id, "REJECT_RETURN", _checkerRemarks));
        }
        catch { }

        _auditEvents.Insert(0, new()
        {
            Timestamp = DateTime.Now.ToString("M/d/yyyy, h:mm:ss tt"),
            User = "admin1",
            Action = "Return Rejected",
            Description = $"Cheque {SelectedCheque.ChequeNo} return rejected by checker. Routed to Debit Posting."
        });

        _successMessage = $"Cheque {SelectedCheque.ChequeNo} return rejected and redirected to Debit Posting.";
        _cheques.Remove(SelectedCheque);
        _selectedId = _cheques.FirstOrDefault()?.Id ?? "";
    }

    public sealed class ReturnCheckerItem
    {
        public string Id { get; set; } = string.Empty;
        public string ChequeNo { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public string MakerDecision { get; set; } = "Return";
        public string Reason { get; set; } = string.Empty;
        public string Remarks { get; set; } = string.Empty;
        public string RequestedTime { get; set; } = string.Empty;
        public string RoutingNumber { get; set; } = string.Empty;
        public string MicrAccountNo { get; set; } = string.Empty;
        public string CustomerAccount { get; set; } = string.Empty;
        public string DrawerAccount { get; set; } = string.Empty;
        public string AccountName { get; set; } = string.Empty;
        public string Branch { get; set; } = string.Empty;
        public decimal Balance { get; set; }
        public string Uic { get; set; } = string.Empty;
    }

    public sealed class ReturnCheckerAuditEvent
    {
        public string Timestamp { get; set; } = string.Empty;
        public string User { get; set; } = string.Empty;
        public string Action { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
}
