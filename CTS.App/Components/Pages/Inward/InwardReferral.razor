    private void SelectCheque(ReferralItem item)
    {
        _selectedId = item.Id;
        _message = "";
        _successMessage = "";
    }

    private async Task AcceptReferral()
    {
        if (SelectedCheque == null) return;
        _message = "";
        _successMessage = "";

        try
        {
            await Client.ActionAsync(new(SelectedCheque.Id, "ACCEPT", string.IsNullOrWhiteSpace(_remarks) ? null : _remarks));
        }
        catch { }

        _auditEvents.Insert(0, new()
        {
            Timestamp = DateTime.Now.ToString("M/d/yyyy, h:mm:ss tt"),
            User = "admin1",
            Action = "Referral Accepted",
            Description = $"Cheque {SelectedCheque.ChequeNo} accepted for debit posting."
        });

        _successMessage = $"Cheque {SelectedCheque.ChequeNo} accepted and routed to Debit Posting.";
        _cheques.Remove(SelectedCheque);
        if (_cheques.Count > 0) _selectedId = _cheques[0].Id;
    }

    private async Task RejectReferral()
    {
        if (SelectedCheque == null) return;
        _message = "";
        _successMessage = "";

        if (string.IsNullOrWhiteSpace(_remarks))
        {
            _message = "Remarks are required before a reject/return decision.";
            return;
        }

        try
        {
            await Client.ActionAsync(new(SelectedCheque.Id, "REJECT", $"{_selectedRejectReason}: {_remarks}"));
        }
        catch { }

        _auditEvents.Insert(0, new()
        {
            Timestamp = DateTime.Now.ToString("M/d/yyyy, h:mm:ss tt"),
            User = "admin1",
            Action = "Referral Rejected",
            Description = $"Cheque {SelectedCheque.ChequeNo} rejected. Reason: {_selectedRejectReason}, Remarks: {_remarks}"
        });

        _successMessage = $"Cheque {SelectedCheque.ChequeNo} rejected and routed to Return ICL Creation.";
        _cheques.Remove(SelectedCheque);
        if (_cheques.Count > 0) _selectedId = _cheques[0].Id;
    }

    public sealed class ReferralItem
    {
        public string Id { get; set; } = string.Empty;
        public string ChequeNo { get; set; } = string.Empty;
        public string DrawerAccount { get; set; } = string.Empty;
        public string MicrAccountNo { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public string ReferralReason { get; set; } = string.Empty;
        public string ReferredBy { get; set; } = string.Empty;
        public string Age { get; set; } = string.Empty;
        public string Uic { get; set; } = string.Empty;
        public string RoutingNumber { get; set; } = string.Empty;
        public string AccountName { get; set; } = string.Empty;
        public string Branch { get; set; } = string.Empty;
        public string AccountStatus { get; set; } = "Active";
        public decimal Balance { get; set; }
    }

    public sealed class ReferralAuditEvent
    {
        public string Timestamp { get; set; } = string.Empty;
        public string User { get; set; } = string.Empty;
        public string Action { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
