    private bool _infoCollapsed = false;
    private bool _summaryCollapsed = false;
    private bool _filtersCollapsed = false;
    private bool _auditOpen = true;

    private string _filterChequeNo = "";
    private string _filterAmount = "";
    private string _filterMicrAccount = "";
    private string _filterRouting = "";
    private string _filterCustomerAccount = "";

    private string _imageView = "front";
    private string _selectedRejectReason = "Insufficient Funds";
    private string _remarks = "";
    private string _message = "";
    private string _successMessage = "";

    private List<ReferralItem> _cheques = [];
    private string _selectedId = "";

    private ReferralItem? SelectedCheque => _cheques.FirstOrDefault(c => c.Id == _selectedId) ?? _cheques.FirstOrDefault();

    private decimal TotalQueueAmount => FilteredRows.Sum(c => c.Amount);

    private string CurrentChequeImageUrl => SelectedCheque == null 
        ? "/placeholders/cheque-001.svg" 
        : (_imageView == "rear" ? "/placeholders/cheque-rear.svg" : "/placeholders/cheque-001.svg");

    private List<ReferralItem> FilteredRows => _cheques.Where(c =>
        (string.IsNullOrWhiteSpace(_filterChequeNo) || c.ChequeNo.Contains(_filterChequeNo, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_filterAmount) || c.Amount.ToString().Contains(_filterAmount, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_filterMicrAccount) || c.MicrAccountNo.Contains(_filterMicrAccount, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_filterRouting) || c.RoutingNumber.Contains(_filterRouting, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_filterCustomerAccount) || c.DrawerAccount.Contains(_filterCustomerAccount, StringComparison.OrdinalIgnoreCase))
    ).ToList();

    private List<ReferralAuditEvent> _auditEvents = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Client.QueueAsync(new("REFERRAL", 1, 50, null, null));
            if (result.IsSuccess && result.Data?.Items != null && result.Data.Items.Count > 0)
            {
                _cheques = result.Data.Items.Select(item => new ReferralItem
                {
                    Id = item.ChequeId,
                    ChequeNo = item.ChequeNo,
                    DrawerAccount = item.AccountNo,
                    MicrAccountNo = item.AccountNo,
                    Amount = item.Amount,
                    ReferralReason = item.RejectReason ?? "Insufficient Funds",
                    ReferredBy = "Technical verifier",
                    Age = "102 days",
                    Uic = $"20260601-DLDB-000-SCN01-0102-{item.ChequeNo}",
                    RoutingNumber = "100000",
                    AccountName = "Demo Construction",
                    Branch = "Head Office",
                    AccountStatus = "Active",
                    Balance = 11200000.00m
                }).ToList();
            }
        }
        catch
        {
            // fallback to seed
        }

        if (_cheques.Count == 0)
        {
            _cheques =
            [
                new ReferralItem
                {
