@page "/inward/upload-icl"
@attribute [Authorize]
@inject WorkspaceApiService Client
@inject NavigationManager Navigation

<PageTitle>Forward Download ICL Intake · ACE CTS</PageTitle>

<div class="icl-intake-page-root">
    @if (!_reviewMode)
    {
        @* TOP WORKSPACE SUBHEADER *@
        <div class="icl-top-bar">
            <div class="icl-top-left">
                <div class="icl-brand-title">ACE CTS Workspace</div>
                <div class="icl-brand-meta">
                    <span><span class="meta-icon">🗓</span> Business date 2026-06-23</span>
                    <span><span class="meta-icon">🏛</span> Head Office</span>
                    <span>Role: ADMIN</span>
                </div>
            </div>
            <div class="icl-top-right">
                <span class="icl-badge-audit">Audit events: @(_auditEntries.Count > 0 ? _auditEntries.Count : 51)</span>
                <span class="icl-badge-user">admin1</span>
            </div>
        </div>

        @* HEADER CARD WITH PILLS & SHOW INFO *@
        <div class="icl-card icl-header-card">
            <div class="icl-header-left">
                <h1 class="icl-header-title">Forward Download ICL Intake</h1>
                <span class="icl-chip chip-mock">Mock service</span>
                <span class="icl-chip chip-cyan">BRANCH <strong>Head Office</strong></span>
                <span class="icl-chip chip-blue">ROLE <strong>ADMIN</strong></span>
                <span class="icl-chip chip-blue">DATE <strong>2026-09-14</strong></span>
            </div>
            <div class="icl-header-right">
                <button type="button" class="icl-btn-outline" @onclick="ToggleInfo">
                    <span class="btn-icon">👁</span> @(_showInfo ? "Hide Info" : "Show Info")
                </button>
            </div>
        </div>

        @if (_showInfo)
        {
            <div class="icl-card icl-info-drawer">
                <div class="icl-info-grid">
                    <div>
                        <span class="info-label">Selected File</span>
                        <strong class="info-val font-mono">@EffectiveFileName</strong>
                    </div>
                    <div>
                        <span class="info-label">Poll Interval</span>
                        <strong class="info-val">10s automated intake polling</strong>
                    </div>
                    <div>
                        <span class="info-label">Imported Files</span>
                        <strong class="info-val">@_files.Count file(s) in local session</strong>
                    </div>
                    <div>
                        <span class="info-label">Storage Model</span>
                        <strong class="info-val">Local browser state / Mock SFTP gateway</strong>
                    </div>
                </div>
            </div>
        }

        @* 3 INTAKE ACTIONS CARDS (UPLOAD, GENERATE SAMPLE, RUN SERVICE) *@
        <div class="icl-intake-cards-grid">
            <!-- Card 1: Upload ICL File -->
            <div class="icl-card icl-action-card">
                <div class="card-body-wrap">
                    <div class="card-head-row">
                        <span class="card-icon teal-icon">📤</span>
                        <strong class="card-head-title">Upload ICL File</strong>
                    </div>
                    <p class="card-desc">Select a fake forward download file from this workstation for demo import.</p>
                </div>
                <label class="icl-file-drop-box">
                    <span>@(string.IsNullOrEmpty(_stagedFileName) ? "Choose .icl file" : _stagedFileName)</span>
                    <InputFile class="hidden-file-input" OnChange="HandleFileSelected" accept=".icl" />
                </label>
            </div>

            <!-- Card 2: Generate Sample File -->
            <div class="icl-card icl-action-card clickable-card" @onclick="GenerateSampleFile">
                <div class="card-body-wrap">
                    <div class="card-head-row">
                        <span class="card-icon teal-icon">🪄</span>
                        <strong class="card-head-title">Generate Sample File</strong>
                    </div>
                    <p class="card-desc">Create a local synthetic CBM forward download file name for the intake service.</p>
                </div>
                <div class="card-sample-name">
                    @SampleFileName
                </div>
            </div>

            <!-- Card 3: Run Upload Service -->
            <div class="icl-card icl-action-card">
                <div class="card-body-wrap">
                    <div class="card-head-row">
                        <span class="card-icon teal-icon">▷</span>
                        <strong class="card-head-title">Run Upload Service</strong>
                    </div>
                    <p class="card-desc">Validate file contents and create Technical Verification workitems on successful import.</p>
                </div>
                <button type="button" class="icl-btn-navy" disabled="@_processing" @onclick="RunUploadServiceAsync">
                    <span class="btn-icon">🔄</span> @(_processing ? "Processing..." : "Run Upload Service")
                </button>
            </div>
        </div>

        @* INTAKE MESSAGE BANNER *@
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            if (_lastResultOk == true)
            {
                <div class="icl-banner banner-success">
                    <span class="banner-icon">✓</span>
                    <div>
                        <strong>Intake completed:</strong> @_message
                    </div>
                </div>
            }
            else
            {
                <div class="icl-banner banner-danger">
                    <span class="banner-icon">⚠</span>
                    <div>
                        <strong>Exception:</strong> @_message
                    </div>
                </div>
            }
        }

        @* PRE-INTAKE VALIDATION CHECK PILLS STRIP *@
        <div class="icl-card icl-validation-strip">
            <div class="validation-pills-row">
                <span class="icl-pill @(IsDuplicateFile ? "pill-warning" : "pill-green")">
                    <span class="pill-label">DUPLICATE FILE CHECK</span>
                    <span class="pill-val">@(IsDuplicateFile ? "Existing file name" : "No duplicate file")</span>
                </span>
                <span class="icl-pill @(_lastResultOk == false ? "pill-danger" : "pill-blue")">
                    <span class="pill-label">DUPLICATE CHEQUE CHECK</span>
                    <span class="pill-val">@(_lastResultOk == false ? "Duplicate detected" : "Ready for ICL-level validation")</span>
                </span>
                <span class="icl-pill @(IsFormatValid ? "pill-green" : "pill-danger")">
                    <span class="pill-label">FORMAT CHECK</span>
                    <span class="pill-val">@(IsFormatValid ? ".icl accepted" : "Use .icl format")</span>
                </span>
                <span class="icl-pill pill-green">
                    <span class="pill-label">IMAGE AVAILABILITY CHECK</span>
                    <span class="pill-val">Synthetic images available</span>
                </span>
            </div>
            <div class="validation-btn-row">
                <button type="button" class="icl-btn-outline-sm" @onclick="ToggleValidationSummary">
                    <span class="btn-icon">👁</span> @(_showValidationSummary ? "Hide Summary" : "Show Summary")
                </button>
            </div>
            @if (_showValidationSummary)
            {
                <div class="icl-drawer-subbox">
                    <p><strong>File Integrity:</strong> ANSI X9.37 forward presentment structure validated.</p>
                    <p><strong>Duplicate Detection:</strong> System checks file SHA-256 hash and MICR records against the database repository.</p>
                    <p><strong>Image Bundle:</strong> Front black/white, rear greyscale, and UV signature snippets mapped successfully.</p>
                </div>
            }
        </div>

        @* SUMMARY STATS STRIP CARD *@
        <div class="icl-card icl-summary-strip">
            <div class="summary-pills-left">
                <span class="icl-pill pill-blue">
                    <span class="pill-label">IMPORTED FILES</span>
                    <span class="pill-val">@_files.Count</span>
                </span>
                <span class="icl-pill pill-danger">
                    <span class="pill-label">ERROR FILES</span>
                    <span class="pill-val">@_files.Count(f => f.ErrorFile)</span>
                </span>
                <span class="icl-pill pill-green">
                    <span class="pill-label">TOTAL CHEQUES</span>
                    <span class="pill-val">@_files.Sum(f => f.ChequeCount)</span>
                </span>
                <span class="icl-pill pill-blue">
                    <span class="pill-label">TOTAL AMOUNT</span>
                    <span class="pill-val">@_files.Sum(f => f.TotalAmount).ToString("N0")</span>
                </span>
            </div>
            <div class="summary-btn-right">
                <button type="button" class="icl-btn-outline-sm" @onclick="ToggleSummary">
                    <span class="btn-icon">👁</span> @(_showSummary ? "Hide Summary" : "Show Summary")
                </button>
            </div>
        </div>

        @if (_showSummary)
        {
            <div class="icl-card icl-summary-drawer">
                <div class="metrics-grid">
                    <div class="metric-box">
                        <span class="m-label">Total Imported Files</span>
                        <strong class="m-val text-blue">@_files.Count</strong>
                    </div>
                    <div class="metric-box">
                        <span class="m-label">Failed File Intake</span>
                        <strong class="m-val @(_files.Any(f => f.ErrorFile) ? "text-danger" : "text-green")">@_files.Count(f => f.ErrorFile)</strong>
                    </div>
                    <div class="metric-box">
                        <span class="m-label">Total Cheque Instruments</span>
                        <strong class="m-val text-green">@_files.Sum(f => f.ChequeCount)</strong>
                    </div>
                    <div class="metric-box">
                        <span class="m-label">Aggregated Intake Amount</span>
                        <strong class="m-val text-blue">MMK @_files.Sum(f => f.TotalAmount).ToString("N2")</strong>
                    </div>
                </div>
            </div>
        }

        @* 2-COLUMN SPLIT: IMPORTED FORWARD DOWNLOAD FILES & AUDIT TIMELINE *@
        <div class="icl-split-layout">
            <!-- Left Column: Imported Forward Download Files table -->
            <div class="icl-card icl-table-card">
                <div class="table-card-head">
                    <h2 class="table-card-title">Imported Forward Download Files</h2>
                </div>
                <div class="table-scroll-wrap">
                    <table class="icl-data-table">
                        <thead>
                            <tr>
                                <th>FILE NAME</th>
                                <th>CHEQUE COUNT</th>
                                <th>TOTAL AMOUNT</th>
                                <th>STATUS</th>
                                <th>IMPORTED TIME</th>
                                <th>ERROR INDICATOR</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_files.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="table-empty-cell">
                                        <div class="empty-state-box">
                                            <span class="empty-icon">📄</span>
                                            <strong class="empty-title">No records found</strong>
                                            <p class="empty-desc">Adjust filters or run the relevant demo service to create workitems.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var file in _files)
                                {
                                    var isSel = file.FileId == _selectedFile?.FileId;
                                    <tr class="table-row-clickable @(isSel ? "row-selected" : null)" @onclick="() => SelectFile(file)">
                                        <td class="font-mono text-blue font-bold">@file.FileName</td>
                                        <td>@file.ChequeCount</td>
                                        <td class="font-bold">@file.TotalAmount.ToString("N0")</td>
                                        <td>
                                            @if (file.Status == "Accepted")
                                            {
                                                <span class="status-chip chip-accepted">Accepted</span>
                                            }
                                            else if (file.Status == "Failed" || file.ErrorFile)
                                            {
                                                <span class="status-chip chip-failed">Failed</span>
                                            }
                                            else
                                            {
                                                <span class="status-chip chip-pending">Pending</span>
                                            }
                                        </td>
                                        <td class="text-muted">@file.CreatedAt</td>
                                        <td>
                                            @if (file.ErrorFile)
                                            {
                                                <span class="status-chip chip-failed">Failed</span>
                                            }
                                            else
                                            {
                                                <span class="status-chip chip-accepted">Accepted</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Right Column: Audit Timeline -->
            <div class="icl-card icl-audit-card">
                <div class="audit-card-head">
                    <div>
                        <h2 class="audit-card-title">Audit Timeline</h2>
                        <span class="audit-card-count">@_auditEntries.Count audit event(s)</span>
                    </div>
                    <button type="button" class="icl-btn-outline-sm" @onclick="ToggleAudit">
                        <span class="btn-icon">@(_showAudit ? "⌃" : "⌄")</span> @(_showAudit ? "Close Audit" : "Show Audit")
                    </button>
                </div>
                @if (_showAudit)
                {
                    <div class="audit-events-scroll">
                        @foreach (var entry in _auditEntries)
                        {
                            <div class="audit-event-item">
                                <div class="audit-meta-row">
                                    <span>@entry.Timestamp - @entry.User</span>
                                </div>
                                <div class="audit-action-row">
                                    <strong>@entry.Action</strong>
                                </div>
                                <div class="audit-note-row">
                                    @entry.Note
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="icl-bottom-bar">
            @if (_selectedFile is not null && _selectedFile.Cheques.Count > 0)
            {
                <button type="button" class="icl-btn-navy mr-2" @onclick="() => OpenFileDetail(_selectedFile)">
                    Inspect Selected File (@_selectedFile.FileName)
                </button>
            }
            <button type="button" class="icl-btn-outline" @onclick="ClearSelection">
                Clear Selection
            </button>
        </div>
    }
    else if (_selectedFile is not null && _activeCheque is not null)
    {
        @* STAGE 2: ICL FILE DETAIL & INSTRUMENT WORKSPACE *@
        <PageHeader Section="Inward Clearing / File Intake"
                    Title="@($"ICL File Review {_selectedFile.FileName}")"
                    Subtitle="Inspect inward clearing file and verify instrument images."
                    Badge="@($"Item {_currentChequeIndex + 1} of {_selectedFile.Cheques.Count}")">
            <button type="button" class="secondary-button" @onclick="PromptExit">‹ Back to Intake</button>
        </PageHeader>

        <div class="exception-banner">
            <span class="banner-icon" aria-hidden="true">📥</span>
            <div class="banner-content">
                <strong>Forward Download File · CBM Clearing House · Session 1 (Cutoff 14:00 MMT)</strong>
                <p>File: <strong>@_selectedFile.FileName</strong> · Instruments: <strong>@_selectedFile.ChequeCount</strong> · Presenting Bank: <strong>@_selectedFile.SourceBank</strong>. File checksum verified.</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert" role="status"><strong>Notice</strong><span>@_message</span></div>
        }

        <div class="repair-workspace-grid">
            @* LEFT COLUMN: CHEQUE IMAGE VIEWER & FILE INSTRUMENTS SELECTOR *@
            <div class="repair-visual-col">
                <ChequeImageViewer FrontSrc="@_activeCheque.FrontImageUrl"
                                   RearSrc="@_activeCheque.BackImageUrl"
                                   SignatureSrc="@_activeCheque.SignatureImageUrl"
                                   Reference="@($"Cheque {_activeCheque.ChequeNo} / {_activeCheque.ChequeId}")"
                                   Status="@_activeCheque.Status"
                                   ChangedCount="0" />

                <section class="panel instrument-list-panel">
                    <div class="panel-heading">
                        <div>
                            <span class="eyebrow">FILE INSTRUMENTS</span>
                            <h2>Cheques in File</h2>
                        </div>
                        <span class="result-count">@_selectedFile.Cheques.Count cheque(s)</span>
                    </div>
                    <div class="table-responsive">
                        <table class="cts-table mini-table">
                            <thead>
                                <tr>
                                    <th>Cheque No</th>
                                    <th>Drawee Account</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < _selectedFile.Cheques.Count; i++)
                                {
                                    var idx = i;
                                    var chk = _selectedFile.Cheques[idx];
                                    var isSel = chk.ChequeId == _activeCheque.ChequeId;
                                    <tr class="interactive-row @(isSel ? "selected" : null)" @onclick="() => SelectCheque(idx)">
                                        <td class="font-bold">@chk.ChequeNo</td>
                                        <td><code>@chk.AccountNo</code></td>
                                        <td>MMK @chk.Amount.ToString("N2")</td>
                                        <td><StatusPill Status="@chk.Status" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>

            @* RIGHT COLUMN: FILE HEADER, ACTIVE CHEQUE DETAILS, ROUTING *@
            <div class="repair-forms-col">
                @* PANEL 1: ICL FILE HEADER INFORMATION *@
                <section class="panel form-panel">
                    <div class="panel-heading">
                        <div>
                            <span class="eyebrow">FILE METADATA</span>
                            <h2>ICL Header & Summary</h2>
                        </div>
                    </div>
                    <dl class="meta-field-grid">
                        <div>
                            <dt>File Name</dt>
                            <dd><code>@_selectedFile.FileName</code></dd>
                        </div>
                        <div>
                            <dt>Source Bank</dt>
                            <dd>@_selectedFile.SourceBank</dd>
                        </div>
                        <div>
                            <dt>Cheque Count</dt>
                            <dd class="font-bold">@_selectedFile.ChequeCount instruments</dd>
                        </div>
                        <div>
                            <dt>Total Control Amount</dt>
                            <dd class="font-bold tone-success">MMK @_selectedFile.TotalAmount.ToString("N2")</dd>
                        </div>
                        <div>
                            <dt>Format Standard</dt>
                            <dd>ANSI X9.37 / CBM-CTS</dd>
                        </div>
                        <div>
                            <dt>Processing Session</dt>
                            <dd>Session 1 (Morning Clearing)</dd>
                        </div>
                        <div>
                            <dt>Imported Time</dt>
                            <dd>@_selectedFile.CreatedAt</dd>
                        </div>
                        <div>
                            <dt>Validation State</dt>
                            <dd><StatusPill Status="@_selectedFile.Status" /></dd>
                        </div>
                    </dl>
                </section>

                @* PANEL 2: PRESENTMENT CHEQUE DETAILS *@
                <section class="panel form-panel">
                    <div class="panel-heading">
                        <div>
                            <span class="eyebrow">INSTRUMENT DATA</span>
                            <h2>Presentment Cheque Details</h2>
                        </div>
                    </div>
                    <dl class="meta-field-grid">
                        <div>
                            <dt>Cheque Number</dt>
                            <dd class="font-bold">@_activeCheque.ChequeNo</dd>
                        </div>
                        <div>
                            <dt>MICR Line</dt>
                            <dd><code>T@(_activeCheque.ChequeNo)T @_activeCheque.RoutingNo A@(_activeCheque.AccountNo)A 01</code></dd>
                        </div>
                        <div>
                            <dt>Drawee Account No</dt>
                            <dd><code>@_activeCheque.AccountNo</code></dd>
                        </div>
                        <div>
                            <dt>Presenting Bank / Routing</dt>
                            <dd>@_selectedFile.SourceBank (@_activeCheque.RoutingNo)</dd>
                        </div>
                        <div>
                            <dt>Cheque Amount</dt>
                            <dd class="font-bold tone-success">MMK @_activeCheque.Amount.ToString("N2")</dd>
                        </div>
                        <div>
                            <dt>Cheque Date</dt>
                            <dd>@_activeCheque.ChequeDate.ToString("yyyy-MM-dd")</dd>
                        </div>
                        <div>
                            <dt>Drawer / Payee</dt>
                            <dd>@_activeCheque.DrawerName</dd>
                        </div>
                        <div>
                            <dt>Presenting Branch</dt>
                            <dd>@_activeCheque.BranchCode - @_activeCheque.BranchName</dd>
                        </div>
                    </dl>
                </section>

                @* PANEL 3: TECHNICAL VERIFICATION HANDOFF *@
                <section class="panel form-panel">
                    <div class="panel-heading">
                        <div>
                            <span class="eyebrow">WORKFLOW PROGRESSION</span>
                            <h2>Technical Verification Handoff</h2>
                        </div>
                    </div>

                    <div class="summary-list">
                        <div>
                            <dt>Next Workflow Workstep</dt>
                            <dd class="font-bold tone-info">INWARD_TECHNICAL_VERIFICATION</dd>
                        </div>
                        <div>
                            <dt>Pre-Intake Validation</dt>
                            <dd class="tone-success">Passed format & checksum validation</dd>
                        </div>
                        <div>
                            <dt>Target Processing Queue</dt>
                            <dd>Technical Verification Queue (Operator Maker)</dd>
                        </div>
                    </div>

                    <div class="form-field mt-3">
                        <label for="intake-notes">Intake Verification Notes (Audit)</label>
                        <textarea id="intake-notes" rows="2" placeholder="Optional notes for technical verification operator..." @bind="_intakeNotes"></textarea>
                    </div>
                </section>
            </div>
        </div>

        @* STICKY BOTTOM ACTION BAR *@
        <StickyActionBar CanPrevious="@(_currentChequeIndex > 0)"
                        CanNext="@(_currentChequeIndex < _selectedFile.Cheques.Count - 1)"
                        IsProcessing="@_processing"
                        CompleteLabel="Route to Technical Verification"
                        OnPrevious="GoPrevious"
                        OnNext="GoNext"
                        OnSaveDraft="SaveDraft"
                        OnComplete="PromptComplete"
                        OnExit="PromptExit" />
    }
</div>

@* CONFIRMATION MODALS *@
<ConfirmActionModal IsOpen="@_showCompleteModal"
                    Title="Complete Forward Download Intake"
                    Message="@($"Are you sure you want to route ICL file {_selectedFile?.FileName} ({_selectedFile?.ChequeCount} instruments) to Technical Verification?")"
                    ConfirmLabel="Yes, Route to Technical Verification"
                    CancelLabel="Cancel"
                    OnConfirm="ConfirmRouteToVerificationAsync"
                    OnCancel="() => _showCompleteModal = false" />

<ConfirmActionModal IsOpen="@_showExitModal"
                    Title="Exit ICL Review"
                    Message="Are you sure you want to exit the review workspace? Any unstaged changes will be discarded."
                    ConfirmLabel="Yes, Exit"
                    CancelLabel="Stay on Page"
                    IsDanger="true"
                    OnConfirm="ConfirmExit"
                    OnCancel="() => _showExitModal = false" />

<style>
    .icl-intake-page-root {
        font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: #0f172a;
        background: #f8fafc;
        min-height: calc(100vh - 80px);
        padding: 20px 24px 60px;
        box-sizing: border-box;
    }
    .icl-intake-page-root * { box-sizing: border-box; }

    /* Top subhead */
    .icl-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
    }
    .icl-brand-title {
        font-size: 15px;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 3px;
    }
    .icl-brand-meta {
        font-size: 12px;
        color: #64748b;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .meta-icon { opacity: 0.85; margin-right: 3px; }
    .icl-top-right {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .icl-badge-audit {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 5px 12px;
        font-size: 12px;
        font-weight: 600;
        color: #334155;
    }
    .icl-badge-user {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 5px 12px;
        font-size: 13px;
        font-weight: 700;
        color: #0f172a;
    }

    /* Cards */
    .icl-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 14px;
        box-shadow: 0 1px 3px rgba(15, 42, 68, 0.04);
    }

    /* Header Card */
    .icl-header-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 20px;
    }
    .icl-header-left {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
    }
    .icl-header-title {
        font-size: 16px;
        font-weight: 800;
        color: #0f172a;
        margin: 0 6px 0 0;
    }

    /* Chips */
    .icl-chip {
        display: inline-flex;
