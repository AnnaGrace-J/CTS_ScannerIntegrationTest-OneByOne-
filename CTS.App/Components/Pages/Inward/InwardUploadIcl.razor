        _auditEntries.Insert(0, new AuditLogEntry
        {
            Action = "Inward Forward Download ICL Imported",
            Timestamp = $"{DateTime.Now:M/d/yyyy, h:mm:ss tt} - CTS Background Service",
            User = "",
            Note = $"{targetFileName} imported with {newFile.ChequeCount} cheque(s)."
        });

        _lastResultOk = true;
        _message = $"Forward download file '{targetFileName}' successfully imported ({newFile.ChequeCount} cheques, MMK {newFile.TotalAmount:N0}). Created Technical Verification workitems.";
        _processing = false;
        _stagedFileName = string.Empty;
    }

    private void SelectFile(IclFileModel file)
    {
        _selectedFile = file;
    }

    private void ClearSelection()
    {
        _selectedFile = null;
        _stagedFileName = string.Empty;
        _message = null;
        _lastResultOk = null;
    }

    private void OpenFileDetail(IclFileModel file)
    {
        if (file.Cheques.Count == 0) return;
        _selectedFile = file;
        _currentChequeIndex = 0;
        _activeCheque = file.Cheques.FirstOrDefault();
        _intakeNotes = string.Empty;
        _message = null;
        _reviewMode = true;
    }

    private void SelectCheque(int index)
    {
        if (_selectedFile is null || index < 0 || index >= _selectedFile.Cheques.Count) return;
        _currentChequeIndex = index;
        _activeCheque = _selectedFile.Cheques[index];
    }

    private void GoPrevious()
    {
        if (_currentChequeIndex > 0) SelectCheque(_currentChequeIndex - 1);
    }

    private void GoNext()
    {
        if (_selectedFile is not null && _currentChequeIndex < _selectedFile.Cheques.Count - 1)
        {
            SelectCheque(_currentChequeIndex + 1);
        }
    }

    private void SaveDraft()
    {
        _message = $"Draft intake notes saved locally for file {_selectedFile?.FileName}.";
    }

    private void PromptComplete()
    {
        _showCompleteModal = true;
    }

    private async Task ConfirmRouteToVerificationAsync()
    {
        _showCompleteModal = false;
        if (_selectedFile is null) return;

        _processing = true;

        var firstChequeId = _selectedFile.Cheques.FirstOrDefault()?.ChequeId ?? _selectedFile.FileId;
        var result = await Client.ActionAsync(new QueueActionRequestModel(firstChequeId, "INWARD.ICL.ACCEPT", _intakeNotes));

        _processing = false;

        _message = $"ICL File {_selectedFile.FileName} ({_selectedFile.ChequeCount} instruments) routed to Technical Verification.";
        _reviewMode = false;
        _files.Remove(_selectedFile);
        _selectedFile = null;
        _activeCheque = null;
    }

    private void PromptExit()
    {
        _showExitModal = true;
    }

    private void ConfirmExit()
    {
        _showExitModal = false;
        _reviewMode = false;
        _selectedFile = null;
        _activeCheque = null;
    }

    public sealed class IclFileModel
    {
        public string FileId { get; set; } = string.Empty;
        public string FileName { get; set; } = string.Empty;
        public string SourceBank { get; set; } = string.Empty;
        public string BranchCode { get; set; } = "HO";
        public int ChequeCount { get; set; }
        public decimal TotalAmount { get; set; }
        public string Status { get; set; } = "Accepted";
        public string CreatedAt { get; set; } = string.Empty;
        public bool ErrorFile { get; set; }
        public List<InwardChequeModel> Cheques { get; set; } = new();
    }

    public sealed class InwardChequeModel
    {
        public string ChequeId { get; set; } = string.Empty;
        public string ChequeNo { get; set; } = string.Empty;
        public string AccountNo { get; set; } = string.Empty;
        public string RoutingNo { get; set; } = string.Empty;
        public string BranchCode { get; set; } = string.Empty;
        public string BranchName { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public DateOnly ChequeDate { get; set; }
        public string DrawerName { get; set; } = string.Empty;
        public string Status { get; set; } = "Pending Verification";
        public string FrontImageUrl = "/placeholders/cheque-front.svg";
        public string BackImageUrl = "/placeholders/cheque-back.svg";
        public string SignatureImageUrl = "/placeholders/signature.svg";
    }

    public sealed class AuditLogEntry
    {
        public string Action { get; set; } = string.Empty;
        public string Timestamp { get; set; } = string.Empty;
        public string User { get; set; } = string.Empty;
        public string Note { get; set; } = string.Empty;
    }
}
