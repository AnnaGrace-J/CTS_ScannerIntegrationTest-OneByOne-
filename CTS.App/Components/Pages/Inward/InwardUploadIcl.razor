                BackImageUrl = "/placeholders/cheque-back.svg",
                SignatureImageUrl = "/placeholders/signature.svg"
            }).ToList();

            _files.Add(new IclFileModel
            {
                FileId = group.Key,
                FileName = $"CBM_FORWARD_{group.Key}.icl",
                SourceBank = "CBM Clearing House",
                BranchCode = group.First().BranchCode,
