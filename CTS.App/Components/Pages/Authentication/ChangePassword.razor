@page "/change-password"
@layout BlankLayout
@attribute [Authorize]
@inject AuthenticationApiService Client
@inject NavigationManager Navigation
@using System.ComponentModel.DataAnnotations

<PageTitle>Change Password · ACE CTS</PageTitle>
<section class="password-change-page">
    <PageHeader Section="Account Security" Title="Change Password" Subtitle="Create a strong password for your CTS operations account." Badge="Secure account" />

    <div class="password-grid">
        <section class="panel password-form">
            <div class="panel-heading"><div><span class="eyebrow">CREDENTIAL UPDATE</span><h2>Set a new password</h2></div></div>
            @if (!string.IsNullOrWhiteSpace(_message)) { <div class="alert @(_success ? "success" : "danger")" role="@(_success ? "status" : "alert")">@_message</div> }
            <EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="change-password"><DataAnnotationsValidator />
                <div class="form-field"><label>Current password</label><InputText type="password" @bind-Value="_model.CurrentPassword" autocomplete="current-password" /><ValidationMessage For="() => _model.CurrentPassword" /></div>
                <div class="form-field"><label>New password</label><InputText type="password" @bind-Value="_model.NewPassword" autocomplete="new-password" /><ValidationMessage For="() => _model.NewPassword" /></div>
                <div class="form-field"><label>Confirm new password</label><InputText type="password" @bind-Value="_model.ConfirmPassword" autocomplete="new-password" /><ValidationMessage For="() => _model.ConfirmPassword" /></div>
                <button class="primary-button" disabled="@_saving" type="submit">@(_saving ? "Updating..." : "Update password")</button>
            </EditForm>
        </section>
        <aside class="panel password-rules"><span class="shield-icon">◇</span><h2>Password requirements</h2>
            @if (_policy is null) { <p>Loading the active password policy...</p> }
            else { <ul><li>At least @_policy.MinimumLength total characters</li><li>@Requirement(_policy.MinimumUppercaseCharacters, "uppercase letter")</li><li>@Requirement(_policy.MinimumLowercaseCharacters, "lowercase letter")</li><li>@Requirement(_policy.MinimumNumberCharacters, "number")</li><li>@Requirement(_policy.MinimumSymbolCharacters, "symbol")</li></ul> }
            <div class="security-callout"><strong>Security reminder</strong><span>Never share your CTS credentials or reuse a password from another system.</span></div>
        </aside>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "reason")] public string? Reason { get; set; }
    private PasswordForm _model = new(); private PasswordPolicyModel? _policy; private string? _message; private bool _success; private bool _saving;
    protected override async Task OnInitializedAsync() { if (string.Equals(Reason, "expired", StringComparison.OrdinalIgnoreCase)) _message = "Your password has expired. Change it before continuing."; var result = await Client.PasswordPolicyAsync(); if (result.IsSuccess) _policy = result.Data; }
    private async Task SubmitAsync() { _saving = true; var result = await Client.ChangePasswordAsync(new(_model.CurrentPassword, _model.NewPassword, _model.ConfirmPassword)); _success = result.IsSuccess; _message = result.Message; if (_success) { _model = new(); Navigation.NavigateTo("/account/password-changed", forceLoad: true); } _saving = false; }
    private static string Requirement(int count, string label) => count == 0 ? $"No required {label}s" : $"At least {count} {label}{(count == 1 ? string.Empty : "s")}";
    private sealed class PasswordForm { [Required] public string CurrentPassword { get; set; } = string.Empty; [Required] public string NewPassword { get; set; } = string.Empty; [Required] public string ConfirmPassword { get; set; } = string.Empty; }
}
