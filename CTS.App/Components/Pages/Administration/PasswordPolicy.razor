@page "/admin/password-policy"
@attribute [Authorize(Policy = PermissionCatalog.AdminPasswordPolicyManagePolicy)]
@inject AdministrationApiService Client
@using System.ComponentModel.DataAnnotations

<PageTitle>Password Policy · ACE CTS</PageTitle>
<PageHeader Section="Administration" Title="Password Policy" Subtitle="Control password complexity and expiration requirements across CTS." Badge="Dynamic security control" />

@if (_policy is null)
{
    <LoadingState Error="@_error" />
}
else
{
    @if (!string.IsNullOrWhiteSpace(_notice)) { <div class="alert success" role="status">@_notice</div> }
    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="alert danger" role="alert">@_error</div> }

    <div class="policy-grid">
        <section class="panel policy-form">
            <div class="panel-heading"><div><span class="eyebrow">COMPLEXITY RULES</span><h2>Required character counts</h2></div></div>
            <p class="policy-intro">Set a requirement to zero when that character type should be optional. New passwords and generated temporary passwords use these values immediately.</p>
            <EditForm Model="_model" OnValidSubmit="SaveAsync" FormName="password-policy">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="policy-control-list">
                    <div class="policy-control-row"><div><label for="minimumLength">Minimum total length</label><small>Total number of characters required.</small></div><InputNumber id="minimumLength" min="8" max="128" @bind-Value="_model.MinimumLength" /></div>
                    <div class="policy-control-row"><div><label for="minimumUppercase">Uppercase letters</label><small>For example: A, B, C.</small></div><InputNumber id="minimumUppercase" min="0" max="20" @bind-Value="_model.MinimumUppercaseCharacters" /></div>
                    <div class="policy-control-row"><div><label for="minimumLowercase">Lowercase letters</label><small>For example: a, b, c.</small></div><InputNumber id="minimumLowercase" min="0" max="20" @bind-Value="_model.MinimumLowercaseCharacters" /></div>
                    <div class="policy-control-row"><div><label for="minimumNumbers">Numbers</label><small>For example: 0 through 9.</small></div><InputNumber id="minimumNumbers" min="0" max="20" @bind-Value="_model.MinimumNumberCharacters" /></div>
                    <div class="policy-control-row"><div><label for="minimumSymbols">Symbols</label><small>For example: !, @@, #, or %.</small></div><InputNumber id="minimumSymbols" min="0" max="20" @bind-Value="_model.MinimumSymbolCharacters" /></div>
                </div>
                <div class="policy-expiration-heading"><span class="eyebrow">EXPIRATION RULE</span><h2>Password lifetime</h2></div>
                <div class="policy-control-list">
                    <div class="policy-control-row policy-toggle-row"><div><label for="passwordExpirationEnabled">Enable password expiration</label><small>Require every user to change an expired password before continuing.</small></div><InputCheckbox id="passwordExpirationEnabled" @bind-Value="_model.PasswordExpirationEnabled" /></div>
                    <div class="policy-control-row"><div><label for="passwordExpirationValue">Expiration time</label><small>Hours support short test windows; days are intended for production policy.</small></div><InputNumber id="passwordExpirationValue" min="1" max="@_model.MaximumExpirationValue" disabled="@(!_model.PasswordExpirationEnabled)" @bind-Value="_model.PasswordExpirationValue" /></div>
                    <div class="policy-control-row"><div><label for="passwordExpirationUnit">Expiration unit</label><small>Time is calculated as an exact UTC duration.</small></div><InputSelect id="passwordExpirationUnit" disabled="@(!_model.PasswordExpirationEnabled)" @bind-Value="_model.PasswordExpirationUnit"><option value="Hour">Hour</option><option value="Day">Day</option></InputSelect></div>
                </div>
                <button class="primary-button" disabled="@_saving" type="submit">@(_saving ? "Saving..." : "Save password policy")</button>
            </EditForm>
        </section>

        <aside class="panel policy-preview">
            <span class="shield-icon" aria-hidden="true">◇</span>
            <span class="eyebrow">LIVE PREVIEW</span>
            <h2>Passwords must contain</h2>
            <strong class="policy-length">@_model.MinimumLength+</strong>
            <span class="policy-length-label">total characters</span>
            <ul>
                <li>@Requirement(_model.MinimumUppercaseCharacters, "uppercase letter")</li>
                <li>@Requirement(_model.MinimumLowercaseCharacters, "lowercase letter")</li>
                <li>@Requirement(_model.MinimumNumberCharacters, "number")</li>
                <li>@Requirement(_model.MinimumSymbolCharacters, "symbol")</li>
                <li>@ExpirationSummary(_model)</li>
            </ul>
            <div class="security-callout"><strong>Last updated</strong><span>@_policy.UpdatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, HH:mm") by @_policy.UpdatedBy</span></div>
        </aside>
    </div>
}

@code {
    private PasswordPolicyModel? _policy;
    private PolicyForm _model = new();
    private string? _error;
    private string? _notice;
    private bool _saving;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Client.PasswordPolicyAsync();
        if (!result.IsSuccess || result.Data is null)
        {
            _error = result.Message;
            return;
        }

        _policy = result.Data;
        _model = PolicyForm.From(_policy);
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        _notice = null;
        var result = await Client.UpdatePasswordPolicyAsync(new(
            _model.MinimumLength,
            _model.MinimumUppercaseCharacters,
            _model.MinimumLowercaseCharacters,
            _model.MinimumNumberCharacters,
            _model.MinimumSymbolCharacters,
            _model.PasswordExpirationEnabled,
            _model.PasswordExpirationValue,
            _model.PasswordExpirationUnit));
        if (result.IsSuccess && result.Data is not null)
        {
            _policy = result.Data.Policy;
            _model = PolicyForm.From(_policy);
            _notice = result.Message;
        }
        else
        {
            _error = result.Message;
        }
        _saving = false;
    }

    private static string Requirement(int count, string label) => count == 0
        ? $"No required {label}s"
        : $"At least {count} {label}{(count == 1 ? string.Empty : "s")}";

    private static string ExpirationSummary(PolicyForm model) => model.PasswordExpirationEnabled
        ? $"Password expires after {model.PasswordExpirationValue} {model.PasswordExpirationUnit}{(model.PasswordExpirationValue == 1 ? string.Empty : "s")}."
        : "Password expiration is disabled.";

    private sealed class PolicyForm : IValidatableObject
    {
        [Range(8, 128)] public int MinimumLength { get; set; } = 8;
        [Range(0, 20)] public int MinimumUppercaseCharacters { get; set; } = 1;
        [Range(0, 20)] public int MinimumLowercaseCharacters { get; set; } = 1;
        [Range(0, 20)] public int MinimumNumberCharacters { get; set; } = 1;
        [Range(0, 20)] public int MinimumSymbolCharacters { get; set; } = 1;
        public bool PasswordExpirationEnabled { get; set; }
        [Range(1, 8760)] public int PasswordExpirationValue { get; set; } = 90;
        public PasswordExpirationUnit PasswordExpirationUnit { get; set; } = PasswordExpirationUnit.Day;
        public int MaximumExpirationValue => PasswordExpirationUnit == PasswordExpirationUnit.Hour ? 8760 : 365;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            var requiredCharacters = MinimumUppercaseCharacters + MinimumLowercaseCharacters + MinimumNumberCharacters + MinimumSymbolCharacters;
            if (requiredCharacters > MinimumLength)
                yield return new ValidationResult("The combined character requirements cannot exceed the minimum password length.");
            if (PasswordExpirationValue > MaximumExpirationValue)
                yield return new ValidationResult($"Password expiration value cannot exceed {MaximumExpirationValue} for {PasswordExpirationUnit}.");
        }

        public static PolicyForm From(PasswordPolicyModel policy) => new()
        {
            MinimumLength = policy.MinimumLength,
            MinimumUppercaseCharacters = policy.MinimumUppercaseCharacters,
            MinimumLowercaseCharacters = policy.MinimumLowercaseCharacters,
            MinimumNumberCharacters = policy.MinimumNumberCharacters,
            MinimumSymbolCharacters = policy.MinimumSymbolCharacters,
            PasswordExpirationEnabled = policy.PasswordExpirationEnabled,
            PasswordExpirationValue = policy.PasswordExpirationValue,
            PasswordExpirationUnit = policy.PasswordExpirationUnit
        };
    }
}
